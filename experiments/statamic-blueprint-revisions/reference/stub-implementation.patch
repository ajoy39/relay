@@ -0,0 +1,38 @@
+<?php
+
+namespace App\Providers;
+
+use App\Http\Controllers\BlueprintRevisionController;
+use App\Http\Middleware\InjectBlueprintRevisions;
+use App\Models\BlueprintRevision;
+use Illuminate\Support\Facades\Event;
+use Illuminate\Support\Facades\Route;
+use Illuminate\Support\ServiceProvider;
+use Statamic\Events\BlueprintSaved;
+use Statamic\Statamic;
+
+class BlueprintRevisionServiceProvider extends ServiceProvider
+{
+    public function boot(): void
+    {
+        Statamic::pushCpRoutes(function () {
+            Route::middleware('statamic.cp.authenticated')
+                ->prefix('blueprint-revisions/{namespace}/{handle}')->group(function () {
+                Route::get('/', [BlueprintRevisionController::class, 'index']);
+                Route::get('{id}/diff', [BlueprintRevisionController::class, 'diff']);
+                Route::post('{id}/restore', [BlueprintRevisionController::class, 'restore']);
+            });
+        });
+
+        $this->app['router']->pushMiddlewareToGroup('statamic.cp.authenticated', InjectBlueprintRevisions::class);
+
+        Event::listen(BlueprintSaved::class, function (BlueprintSaved $event) {
+            BlueprintRevision::create([
+                'namespace' => $event->blueprint->namespace(),
+                'handle' => $event->blueprint->handle(),
+                'contents' => $event->blueprint->contents(),
+                'created_at' => now(),
+            ]);
+        });
+    }
+}
