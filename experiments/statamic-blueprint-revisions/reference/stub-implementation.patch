+<?php
+
+namespace App\Http\Middleware;
+
+use App\Models\BlueprintRevision;
+use Closure;
+use Illuminate\Http\Request;
+
+class InjectBlueprintRevisions
+{
+    public function handle(Request $request, Closure $next)
+    {
+        $response = $next($request);
+
+        if (! $request->isMethod('GET') || ! ($target = $this->target($request))) {
+            return $response;
+        }
+
+        $content = $response->getContent();
+        if (! is_string($content) || ! str_contains($content, '</body>')) {
+            return $response;
+        }
+
+        [$namespace, $handle] = $target;
+        $html = $this->panel($namespace, $handle);
+
+        return $response->setContent(str_replace('</body>', $html.'</body>', $content));
+    }
+
+    /** @return array{0:string,1:string}|null */
+    private function target(Request $request): ?array
+    {
+        $segments = $request->segments();           // cp/fields/blueprints/collections/pages/page/edit
+        $at = array_search('blueprints', $segments, true);
+        if ($at === false || end($segments) !== 'edit') {
+            return null;
+        }
+
+        $parts = array_slice($segments, $at + 1, -1);
+        if (count($parts) < 2) {
+            return null;
+        }
+
+        $handle = array_pop($parts);
+
+        return [implode('.', $parts), $handle];
+    }
+
+    private function panel(string $namespace, string $handle): string
+    {
+        $revisions = BlueprintRevision::where('namespace', $namespace)
+            ->where('handle', $handle)
+            ->orderByDesc('created_at')
+            ->orderByDesc('id')
+            ->get();
+
+        $rows = '';
+        foreach ($revisions as $r) {
+            $id = e($r->id);
+            $rows .= '<li data-revision-id="'.$id.'" style="margin:.25rem 0">'
+                .'<time>'.e($r->created_at->toDayDateTimeString()).'</time> '
+                .'<button type="button" data-revision-preview="'.$id.'">Preview</button> '
+                .'<button type="button" data-revision-restore="'.$id.'">Restore</button>'
+                .'<div data-revision-preview-target="'.$id.'"></div>'
+                .'</li>';
+        }
+
+        $base = e(url('/cp/blueprint-revisions/'.$namespace.'/'.$handle));
+
+        return <<<HTML
+<section id="blueprint-revisions" style="position:relative;z-index:9999;padding:1rem;background:#fff">
+<h2>Revisions</h2>
+<ul style="list-style:none;padding:0">{$rows}</ul>
+</section>
+<script>
+(function () {
+  var base = '{$base}';
+  function token() {
+    var m = document.querySelector('meta[name="csrf-token"]');
+    return m ? m.getAttribute('content') : '';
+  }
+  document.querySelectorAll('[data-revision-preview]').forEach(function (el) {
+    el.addEventListener('click', function () {
+      var id = el.getAttribute('data-revision-preview');
+      fetch(base + '/' + id + '/diff', { headers: { Accept: 'application/json' } })
+        .then(function (r) { return r.json(); })
+        .then(function (d) {
+          var target = document.querySelector('[data-revision-preview-target="' + id + '"]');
+          target.textContent = (d.changes || []).map(function (c) {
+            return c.path + ': ' + JSON.stringify(c.from) + ' → ' + JSON.stringify(c.to);
+          }).join(' | ') || 'No changes';
+        });
+    });
+  });
+  document.querySelectorAll('[data-revision-restore]').forEach(function (el) {
+    el.addEventListener('click', function () {
+      var id = el.getAttribute('data-revision-restore');
+      fetch(base + '/' + id + '/restore', {
+        method: 'POST',
+        headers: { Accept: 'application/json', 'X-CSRF-TOKEN': token() },
+      }).then(function () { window.location.reload(); });
+    });
+  });
+})();
+</script>
+HTML;
+    }
+}
