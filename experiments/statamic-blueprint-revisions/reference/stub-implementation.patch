+<?php
+
+namespace App\Support;
+
+class BlueprintDiff
+{
+    /** Changes needed to turn $from into $to, as dot-path entries. */
+    public static function between(array $from, array $to): array
+    {
+        $a = self::flatten($from);
+        $b = self::flatten($to);
+
+        $changes = [];
+        foreach (array_keys($a + $b) as $path) {
+            $before = $a[$path] ?? null;
+            $after = $b[$path] ?? null;
+            if ($before !== $after) {
+                $changes[] = ['path' => $path, 'from' => $before, 'to' => $after];
+            }
+        }
+
+        return $changes;
+    }
+
+    private static function flatten(array $value, string $prefix = ''): array
+    {
+        $flat = [];
+        foreach ($value as $key => $item) {
+            $path = $prefix === '' ? (string) $key : $prefix.'.'.$key;
+            if (is_array($item) && $item !== []) {
+                $flat += self::flatten($item, $path);
+            } else {
+                $flat[$path] = is_array($item) ? [] : $item;
+            }
+        }
+
+        return $flat;
+    }
+}
