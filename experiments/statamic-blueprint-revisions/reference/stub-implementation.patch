+<?php
+
+namespace App\Http\Controllers;
+
+use App\Models\BlueprintRevision;
+use App\Support\BlueprintDiff;
+use Statamic\Facades\Blueprint;
+
+class BlueprintRevisionController extends Controller
+{
+    public function index(string $namespace, string $handle)
+    {
+        return response()->json([
+            'revisions' => $this->query($namespace, $handle)->get()
+                ->map(fn ($r) => ['id' => $r->id, 'created_at' => $r->created_at->toIso8601String()])
+                ->values(),
+        ]);
+    }
+
+    public function diff(string $namespace, string $handle, string $id)
+    {
+        $revision = $this->query($namespace, $handle)->findOrFail($id);
+        $blueprint = $this->blueprint($namespace, $handle);
+
+        return response()->json([
+            'changes' => BlueprintDiff::between($blueprint->contents(), $revision->contents),
+        ]);
+    }
+
+    public function restore(string $namespace, string $handle, string $id)
+    {
+        $revision = $this->query($namespace, $handle)->findOrFail($id);
+
+        // Saving fires BlueprintSaved, which records the restore as its own
+        // revision — so a restore can itself be undone.
+        $this->blueprint($namespace, $handle)->setContents($revision->contents)->save();
+
+        return response()->json(['restored' => true]);
+    }
+
+    private function query(string $namespace, string $handle)
+    {
+        return BlueprintRevision::where('namespace', $namespace)
+            ->where('handle', $handle)
+            ->orderByDesc('created_at')
+            ->orderByDesc('id');
+    }
+
+    private function blueprint(string $namespace, string $handle)
+    {
+        return Blueprint::find($namespace.'.'.$handle) ?? abort(404);
+    }
+}
