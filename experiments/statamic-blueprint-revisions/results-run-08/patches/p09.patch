diff --git a/resources/js/cp/blueprint-revisions.js b/resources/js/cp/blueprint-revisions.js
new file mode 100644
index 0000000..4ea96f5
--- /dev/null
+++ b/resources/js/cp/blueprint-revisions.js
@@ -0,0 +1,184 @@
+// Revision history for blueprint edit pages. Plain script, no build step:
+// AppServiceProvider adds it to every CP page with Statamic::inlineScript().
+(function () {
+    var PANEL_ID = 'blueprint-revisions';
+    var EDIT_PATH = /^\/cp\/fields\/blueprints\/((?:[^\/]+\/)+)([^\/]+)\/edit\/?$/;
+
+    // The namespace and handle of the blueprint being edited, if this is an edit page.
+    function currentBlueprint() {
+        var match = location.pathname.match(EDIT_PATH);
+
+        if (! match) {
+            return null;
+        }
+
+        return {
+            namespace: match[1].slice(0, -1).replace(/\//g, '.'),
+            handle: decodeURIComponent(match[2]),
+        };
+    }
+
+    function apiBase(blueprint) {
+        return '/cp/blueprint-revisions/'
+            + encodeURIComponent(blueprint.namespace) + '/'
+            + encodeURIComponent(blueprint.handle);
+    }
+
+    function api(path, method) {
+        var headers = { Accept: 'application/json' };
+        var xsrf = document.cookie.match(/(?:^|;\s*)XSRF-TOKEN=([^;]+)/);
+
+        if (xsrf) {
+            headers['X-XSRF-TOKEN'] = decodeURIComponent(xsrf[1]);
+        }
+
+        return fetch(path, { method: method || 'GET', credentials: 'same-origin', headers: headers })
+            .then(function (response) {
+                if (! response.ok) {
+                    throw new Error('Request failed with status ' + response.status);
+                }
+
+                return response.json();
+            });
+    }
+
+    function el(tag, attributes, children) {
+        var node = document.createElement(tag);
+
+        Object.keys(attributes || {}).forEach(function (name) {
+            node.setAttribute(name, attributes[name]);
+        });
+
+        [].concat(children === undefined ? [] : children).forEach(function (child) {
+            node.appendChild(typeof child === 'string' ? document.createTextNode(child) : child);
+        });
+
+        return node;
+    }
+
+    function format(value) {
+        return value === null || value === undefined ? 'null' : JSON.stringify(value);
+    }
+
+    function previewRevision(base, id, output) {
+        output.textContent = 'Loading…';
+
+        api(base + '/' + id + '/diff').then(function (data) {
+            output.textContent = '';
+
+            if (data.changes.length === 0) {
+                output.appendChild(el('li', {}, 'No changes: this revision matches the current blueprint.'));
+                return;
+            }
+
+            data.changes.forEach(function (change) {
+                output.appendChild(el('li', { 'data-revision-path': change.path }, [
+                    el('code', {}, change.path),
+                    ': ',
+                    el('code', {}, format(change.from)),
+                    ' → ',
+                    el('code', {}, format(change.to)),
+                ]));
+            });
+        }).catch(function (error) {
+            output.textContent = 'Could not preview: ' + error.message;
+        });
+    }
+
+    function restoreRevision(base, id, button) {
+        button.disabled = true;
+
+        api(base + '/' + id + '/restore', 'POST').then(function () {
+            location.reload();
+        }).catch(function (error) {
+            button.disabled = false;
+            button.textContent = 'Restore failed: ' + error.message;
+        });
+    }
+
+    function revisionRow(base, revision) {
+        var id = String(revision.id);
+        var output = el('ul', { 'data-revision-changes': id, class: 'mt-2 text-sm' });
+        var preview = el('button', { type: 'button', 'data-revision-preview': id, class: 'btn' }, 'Preview');
+        var restore = el('button', { type: 'button', 'data-revision-restore': id, class: 'btn' }, 'Restore');
+
+        preview.addEventListener('click', function () {
+            previewRevision(base, id, output);
+        });
+
+        restore.addEventListener('click', function () {
+            restoreRevision(base, id, restore);
+        });
+
+        return el('li', { 'data-revision-id': id, class: 'py-3 border-b' }, [
+            el('time', { datetime: revision.created_at }, new Date(revision.created_at).toLocaleString()),
+            ' ',
+            preview,
+            ' ',
+            restore,
+            output,
+        ]);
+    }
+
+    function buildPanel(blueprint) {
+        var base = apiBase(blueprint);
+        var status = el('p', { class: 'text-sm text-gray-600' }, 'Loading revisions…');
+        var list = el('ol', { class: 'mt-4' });
+
+        api(base).then(function (data) {
+            status.textContent = data.revisions.length === 0 ? 'No revisions yet.' : '';
+
+            data.revisions.forEach(function (revision) {
+                list.appendChild(revisionRow(base, revision));
+            });
+        }).catch(function (error) {
+            status.textContent = 'Could not load revisions: ' + error.message;
+        });
+
+        return el('section', {
+            id: PANEL_ID,
+            class: 'card mt-8 p-6',
+            'data-blueprint': blueprint.namespace + '::' + blueprint.handle,
+        }, [
+            el('h2', { class: 'text-lg font-medium mb-2' }, 'Revisions'),
+            el('p', { class: 'text-sm text-gray-600' }, 'Each save records a revision. Preview shows what restoring would change without applying it.'),
+            status,
+            list,
+        ]);
+    }
+
+    // Inertia swaps the page without a reload, so keep the panel in step with the URL.
+    function mount() {
+        var blueprint = currentBlueprint();
+        var existing = document.getElementById(PANEL_ID);
+
+        if (! blueprint) {
+            if (existing) {
+                existing.remove();
+            }
+
+            return;
+        }
+
+        if (existing && existing.getAttribute('data-blueprint') === blueprint.namespace + '::' + blueprint.handle) {
+            return;
+        }
+
+        if (existing) {
+            existing.remove();
+        }
+
+        (document.querySelector('main') || document.body).appendChild(buildPanel(blueprint));
+    }
+
+    function start() {
+        new MutationObserver(mount).observe(document.body, { childList: true, subtree: true });
+        mount();
+    }
+
+    if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', start);
+    } else {
+        start();
+    }
+})();
