diff --git a/app/Revisions/BlueprintHistory.php b/app/Revisions/BlueprintHistory.php
new file mode 100644
index 0000000..fbf9a8c
--- /dev/null
+++ b/app/Revisions/BlueprintHistory.php
@@ -0,0 +1,142 @@
+<?php
+
+namespace App\Revisions;
+
+use App\Models\BlueprintRevision;
+use Illuminate\Database\Eloquent\Builder;
+use Illuminate\Database\Eloquent\Collection;
+
+class BlueprintHistory
+{
+    /**
+     * Snapshot the blueprint's stored contents as a revision.
+     */
+    public function record(?string $namespace, string $handle): void
+    {
+        $stored = $this->stored($namespace, $handle);
+
+        if (! $stored) {
+            return;
+        }
+
+        BlueprintRevision::create([
+            'namespace' => $namespace,
+            'handle' => $handle,
+            'data' => $stored->getAttributeValue('data'),
+        ]);
+    }
+
+    /**
+     * Revisions for a blueprint, newest first.
+     */
+    public function history(?string $namespace, string $handle): Collection
+    {
+        return $this->scope(BlueprintRevision::query(), $namespace, $handle)
+            ->latest('id')
+            ->get();
+    }
+
+    public function find(?string $namespace, string $handle, string $id): ?BlueprintRevision
+    {
+        return $this->scope(BlueprintRevision::query(), $namespace, $handle)
+            ->whereKey($id)
+            ->first();
+    }
+
+    /**
+     * The blueprint's currently stored contents, as the driver saved them.
+     */
+    public function current(?string $namespace, string $handle): array
+    {
+        return $this->stored($namespace, $handle)?->getAttributeValue('data') ?? [];
+    }
+
+    private function stored(?string $namespace, string $handle)
+    {
+        return $this->scope(app('statamic.eloquent.blueprints.model')::query(), $namespace, $handle)->first();
+    }
+
+    private function scope(Builder $query, ?string $namespace, string $handle): Builder
+    {
+        return $query
+            ->when(
+                $namespace === null,
+                fn (Builder $q) => $q->whereNull('namespace'),
+                fn (Builder $q) => $q->where('namespace', $namespace),
+            )
+            ->where('handle', $handle);
+    }
+
+    /**
+     * Drop the ordering keys the Eloquent driver adds (`__count`), sorting by
+     * them first, so two blueprints compare equal when their contents match.
+     */
+    public static function normalize(array $contents): array
+    {
+        $isList = array_is_list($contents);
+        $items = collect($contents);
+
+        if ($items->isNotEmpty() && $items->every(fn ($item) => is_array($item) && array_key_exists('__count', $item))) {
+            $items = $items->sortBy('__count');
+        }
+
+        $normalized = $items->map(function ($value) {
+            if (! is_array($value)) {
+                return $value;
+            }
+
+            unset($value['__count']);
+
+            return self::normalize($value);
+        });
+
+        return ($isList ? $normalized->values() : $normalized)->all();
+    }
+
+    /**
+     * The changes that take `$from` to `$to`, as dot paths to leaf values.
+     * Unchanged values are left out.
+     */
+    public static function diff(array $from, array $to): array
+    {
+        $before = self::flatten($from);
+        $after = self::flatten($to);
+        $changes = [];
+
+        $paths = array_unique(array_merge(array_keys($before), array_keys($after)));
+
+        foreach ($paths as $path) {
+            $inBefore = array_key_exists($path, $before);
+            $inAfter = array_key_exists($path, $after);
+
+            if ($inBefore === $inAfter && ($before[$path] ?? null) === ($after[$path] ?? null)) {
+                continue;
+            }
+
+            $changes[] = [
+                'path' => (string) $path,
+                'from' => $before[$path] ?? null,
+                'to' => $after[$path] ?? null,
+            ];
+        }
+
+        return $changes;
+    }
+
+    private static function flatten(array $data, string $prefix = ''): array
+    {
+        $leaves = [];
+
+        foreach ($data as $key => $value) {
+            $path = $prefix === '' ? (string) $key : $prefix.'.'.$key;
+
+            if (is_array($value) && $value !== []) {
+                $leaves += self::flatten($value, $path);
+            } else {
+                $leaves[$path] = $value;
+            }
+        }
+
+        return $leaves;
+    }
+}
