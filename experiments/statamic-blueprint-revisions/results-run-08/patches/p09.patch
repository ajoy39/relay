@@ -0,0 +1,17 @@
+<?php
+
+namespace App\Revisions;
+
+use Statamic\Events\BlueprintSaved;
+
+// Registered explicitly in AppServiceProvider. Lives outside app/Listeners
+// so Laravel's listener auto-discovery doesn't register it a second time.
+class RecordBlueprintRevision
+{
+    public function __construct(private BlueprintHistory $history) {}
+
+    public function handle(BlueprintSaved $event): void
+    {
+        $this->history->record($event->blueprint->namespace(), $event->blueprint->handle());
+    }
+}
