+<?php
+
+namespace App\Http\Controllers\CP;
+
+use App\Http\Controllers\Controller;
+use App\Models\BlueprintRevision;
+use App\Revisions\BlueprintHistory;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Support\Arr;
+use Statamic\Facades\Blueprint;
+
+class BlueprintRevisionController extends Controller
+{
+    public function __construct(private BlueprintHistory $history) {}
+
+    public function index(string $namespace, string $handle): JsonResponse
+    {
+        $revisions = $this->history->history($namespace, $handle)->map(fn (BlueprintRevision $revision) => [
+            'id' => $revision->id,
+            'created_at' => $revision->created_at->toIso8601String(),
+        ]);
+
+        return response()->json(['revisions' => $revisions->values()]);
+    }
+
+    public function diff(string $namespace, string $handle, string $id): JsonResponse
+    {
+        $revision = $this->revision($namespace, $handle, $id);
+
+        $changes = BlueprintHistory::diff(
+            BlueprintHistory::normalize($this->history->current($namespace, $handle)),
+            BlueprintHistory::normalize($revision->data),
+        );
+
+        return response()->json(['changes' => $changes]);
+    }
+
+    public function restore(string $namespace, string $handle, string $id): JsonResponse
+    {
+        $revision = $this->revision($namespace, $handle, $id);
+
+        $blueprint = Blueprint::find($namespace.'::'.$handle)
+            ?? Blueprint::make()->setNamespace($namespace)->setHandle($handle);
+
+        // Saving through the blueprint (rather than writing the row) fires
+        // BlueprintSaved, which records the restore as a revision of its own.
+        $blueprint
+            ->setContents(BlueprintHistory::normalize($revision->data))
+            ->setHidden(Arr::get($revision->data, 'hide'))
+            ->setOrder(Arr::get($revision->data, 'order'))
+            ->save();
+
+        return response()->json(['restored' => true]);
+    }
+
+    private function revision(string $namespace, string $handle, string $id): BlueprintRevision
+    {
+        return $this->history->find($namespace, $handle, $id) ?? abort(404);
+    }
+}
