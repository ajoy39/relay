diff --git a/tests/Feature/BlueprintRevisionsTest.php b/tests/Feature/BlueprintRevisionsTest.php
new file mode 100644
index 0000000..40948a5
--- /dev/null
+++ b/tests/Feature/BlueprintRevisionsTest.php
@@ -0,0 +1,162 @@
+<?php
+
+namespace Tests\Feature;
+
+use App\Models\BlueprintRevision;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Statamic\Facades\Blueprint;
+use Statamic\Facades\User;
+use Tests\TestCase;
+
+class BlueprintRevisionsTest extends TestCase
+{
+    use RefreshDatabase;
+
+    private function contents(string $label): array
+    {
+        return [
+            'title' => 'Page',
+            'tabs' => [
+                'main' => [
+                    'display' => 'Main',
+                    'sections' => [
+                        [
+                            '__count' => 0,
+                            'fields' => [
+                                ['handle' => 'title', 'field' => ['type' => 'text', 'display' => $label], '__count' => 0],
+                            ],
+                        ],
+                    ],
+                ],
+            ],
+        ];
+    }
+
+    private function save(string $label): void
+    {
+        Blueprint::make()
+            ->setNamespace('collections.pages')
+            ->setHandle('page')
+            ->setContents($this->contents($label))
+            ->save();
+    }
+
+    private function url(string $suffix = ''): string
+    {
+        return '/cp/blueprint-revisions/collections.pages/page'.$suffix;
+    }
+
+    private function asEditor(): void
+    {
+        $user = User::make()->email('editor@example.com');
+        $user->set('name', 'Editor');
+        $user->makeSuper();
+        $user->save();
+
+        $this->actingAs($user);
+    }
+
+    public function test_every_blueprint_save_records_a_revision_newest_first(): void
+    {
+        $this->asEditor();
+
+        $this->save('First');
+        $this->save('Second');
+
+        $revisions = $this->getJson($this->url())->assertOk()->json('revisions');
+
+        $this->assertCount(2, $revisions);
+        $this->assertSame(BlueprintRevision::max('id'), $revisions[0]['id']);
+        $this->assertLessThan($revisions[0]['id'], $revisions[1]['id']);
+        $this->assertNotFalse(\DateTime::createFromFormat(\DateTime::ATOM, $revisions[0]['created_at']));
+    }
+
+    public function test_history_is_empty_for_a_blueprint_without_revisions(): void
+    {
+        $this->asEditor();
+
+        $this->getJson($this->url())->assertOk()->assertExactJson(['revisions' => []]);
+    }
+
+    public function test_diff_describes_changes_from_current_to_revision(): void
+    {
+        $this->asEditor();
+
+        $this->save('First');
+        $firstId = BlueprintRevision::query()->orderBy('id')->value('id');
+        $this->save('Second');
+
+        $changes = $this->getJson($this->url("/{$firstId}/diff"))->assertOk()->json('changes');
+
+        $this->assertCount(1, $changes);
+        $this->assertSame('tabs.main.sections.0.fields.0.field.display', $changes[0]['path']);
+        $this->assertSame('Second', $changes[0]['from']);
+        $this->assertSame('First', $changes[0]['to']);
+    }
+
+    public function test_diff_of_the_current_contents_is_empty(): void
+    {
+        $this->asEditor();
+
+        $this->save('First');
+        $this->save('Second');
+        $latestId = BlueprintRevision::max('id');
+
+        $this->getJson($this->url("/{$latestId}/diff"))->assertOk()->assertExactJson(['changes' => []]);
+    }
+
+    public function test_preview_does_not_change_the_blueprint(): void
+    {
+        $this->asEditor();
+
+        $this->save('First');
+        $firstId = BlueprintRevision::max('id');
+        $this->save('Second');
+
+        $this->getJson($this->url("/{$firstId}/diff"))->assertOk();
+
+        $this->assertSame('Second', Blueprint::find('collections.pages.page')->field('title')->display());
+    }
+
+    public function test_restore_changes_the_blueprint_and_is_itself_recorded(): void
+    {
+        $this->asEditor();
+
+        $this->save('First');
+        $firstId = BlueprintRevision::max('id');
+        $this->save('Second');
+        $this->assertSame(2, BlueprintRevision::count());
+
+        $secondId = BlueprintRevision::max('id');
+
+        $this->postJson($this->url("/{$firstId}/restore"))->assertOk()->assertExactJson(['restored' => true]);
+
+        $this->assertSame('First', Blueprint::find('collections.pages.page')->field('title')->display());
+        $this->assertSame(3, BlueprintRevision::count());
+
+        // The restore is revertible: restoring the revision that was current before it brings back "Second".
+        $this->postJson($this->url("/{$secondId}/restore"))->assertOk();
+        $this->assertSame('Second', Blueprint::find('collections.pages.page')->field('title')->display());
+        $this->assertSame(4, BlueprintRevision::count());
+    }
+
+    public function test_unknown_revision_is_not_found(): void
+    {
+        $this->asEditor();
+
+        $this->save('First');
+
+        $this->getJson($this->url('/999/diff'))->assertNotFound();
+        $this->postJson($this->url('/999/restore'))->assertNotFound();
+    }
+
+    public function test_unauthenticated_requests_are_rejected(): void
+    {
+        $this->save('First');
+        $revisionId = BlueprintRevision::max('id');
+
+        $this->getJson($this->url())->assertUnauthorized();
+        $this->getJson($this->url("/{$revisionId}/diff"))->assertUnauthorized();
+        $this->postJson($this->url("/{$revisionId}/restore"))->assertUnauthorized();
+    }
+}
