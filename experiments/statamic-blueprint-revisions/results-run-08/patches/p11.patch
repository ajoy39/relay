diff --git a/resources/js/blueprint-revisions.js b/resources/js/blueprint-revisions.js
new file mode 100644
index 0000000..52e078d
--- /dev/null
+++ b/resources/js/blueprint-revisions.js
@@ -0,0 +1,196 @@
+// Revision history panel for the CP blueprint edit page.
+// The CP is a single-page app, so the URL is checked whenever the DOM changes;
+// the panel is mounted or removed to match the current blueprint.
+(function () {
+    if (window.__blueprintRevisionsLoaded) {
+        return;
+    }
+
+    window.__blueprintRevisionsLoaded = true;
+
+    var PANEL_ID = 'blueprint-revisions';
+    var EDIT_PATH = /^\/cp\/fields\/blueprints\/((?:[^/]+\/)+[^/]+)\/edit\/?$/;
+
+    function parse(pathname) {
+        var match = EDIT_PATH.exec(pathname);
+
+        if (!match) {
+            return null;
+        }
+
+        var parts = match[1].split('/');
+        var handle = parts.pop();
+
+        return { namespace: parts.join('.'), handle: handle };
+    }
+
+    function el(tag, attributes, text) {
+        var node = document.createElement(tag);
+
+        Object.keys(attributes || {}).forEach(function (name) {
+            node.setAttribute(name, attributes[name]);
+        });
+
+        if (text !== undefined) {
+            node.textContent = text;
+        }
+
+        return node;
+    }
+
+    function endpoint(target) {
+        return '/cp/blueprint-revisions/' + encodeURIComponent(target.namespace) + '/' + encodeURIComponent(target.handle);
+    }
+
+    function request(url, options) {
+        options = options || {};
+        options.credentials = 'same-origin';
+        options.headers = Object.assign({ Accept: 'application/json' }, options.headers || {});
+
+        return fetch(url, options).then(function (response) {
+            if (!response.ok) {
+                throw new Error('HTTP ' + response.status);
+            }
+
+            return response.json();
+        });
+    }
+
+    function xsrfToken() {
+        var match = document.cookie.match(/(?:^|; )XSRF-TOKEN=([^;]*)/);
+
+        return match ? decodeURIComponent(match[1]) : '';
+    }
+
+    function formatDate(value) {
+        var date = new Date(value);
+
+        return isNaN(date) ? value : date.toLocaleString();
+    }
+
+    function showPreview(target, id, ui) {
+        ui.preview.replaceChildren(el('p', {}, 'Loading changes…'));
+
+        request(endpoint(target) + '/' + encodeURIComponent(id) + '/diff').then(function (body) {
+            if (body.changes.length === 0) {
+                ui.preview.replaceChildren(el('p', {}, 'Restoring this revision would change nothing.'));
+
+                return;
+            }
+
+            var nodes = [el('p', {}, 'Restoring would change ' + body.changes.length + ' value(s):')];
+
+            body.changes.forEach(function (change) {
+                nodes.push(
+                    el('code', { style: 'display:block;margin-top:.5rem;font-weight:600' }, change.path),
+                    el('pre', { style: 'margin:.25rem 0;white-space:pre-wrap;word-break:break-all' }, 'from: ' + JSON.stringify(change.from)),
+                    el('pre', { style: 'margin:.25rem 0;white-space:pre-wrap;word-break:break-all' }, 'to:   ' + JSON.stringify(change.to))
+                );
+            });
+
+            ui.preview.replaceChildren(...nodes);
+        }).catch(function () {
+            ui.preview.replaceChildren(el('p', {}, 'Could not load the preview.'));
+        });
+    }
+
+    function restoreRevision(target, id, ui) {
+        var confirmed = window.confirm(
+            'Restore revision ' + id + '? The current blueprint will be replaced. The restore is itself recorded, so it can be undone.'
+        );
+
+        if (!confirmed) {
+            return;
+        }
+
+        request(endpoint(target) + '/' + encodeURIComponent(id) + '/restore', {
+            method: 'POST',
+            headers: { 'X-XSRF-TOKEN': xsrfToken() },
+        }).then(function () {
+            window.location.reload();
+        }).catch(function () {
+            ui.status.textContent = 'Restore failed. Nothing was changed.';
+        });
+    }
+
+    function row(target, revision, ui) {
+        var item = el('li', {
+            'data-revision-id': String(revision.id),
+            style: 'padding:.5rem 0;border-top:1px solid #e2e8f0',
+        });
+
+        var preview = el('button', { type: 'button', 'data-revision-preview': String(revision.id) }, 'Preview');
+        var restore = el('button', { type: 'button', 'data-revision-restore': String(revision.id) }, 'Restore');
+
+        preview.addEventListener('click', function () {
+            showPreview(target, revision.id, ui);
+        });
+
+        restore.addEventListener('click', function () {
+            restoreRevision(target, revision.id, ui);
+        });
+
+        item.append(el('div', { title: revision.created_at }, formatDate(revision.created_at)), preview, ' ', restore);
+
+        return item;
+    }
+
+    function mount(target, key) {
+        var panel = el('div', {
+            id: PANEL_ID,
+            'data-blueprint': key,
+            style: 'position:fixed;bottom:1rem;right:1rem;width:22rem;max-height:70vh;overflow:auto;z-index:1000;'
+                + 'padding:1rem;background:#fff;color:#111;border:1px solid #cbd5e1;border-radius:.5rem;'
+                + 'box-shadow:0 10px 30px rgba(0,0,0,.15);font:13px/1.4 system-ui,sans-serif',
+        });
+
+        var ui = {
+            status: el('p', {}, 'Loading…'),
+            list: el('ul', { style: 'list-style:none;margin:0;padding:0' }),
+            preview: el('div', {}),
+        };
+
+        panel.append(el('h2', { style: 'margin:0 0 .5rem;font-size:1rem;font-weight:600' }, 'Revisions'), ui.status, ui.list, ui.preview);
+        document.body.appendChild(panel);
+
+        request(endpoint(target)).then(function (body) {
+            ui.status.textContent = body.revisions.length === 0 ? 'No revisions yet.' : '';
+
+            body.revisions.forEach(function (revision) {
+                ui.list.appendChild(row(target, revision, ui));
+            });
+        }).catch(function () {
+            ui.status.textContent = 'Could not load revisions.';
+        });
+    }
+
+    function sync() {
+        var target = parse(window.location.pathname);
+        var key = target ? target.namespace + '/' + target.handle : null;
+        var panel = document.getElementById(PANEL_ID);
+
+        if (panel && panel.getAttribute('data-blueprint') === key) {
+            return;
+        }
+
+        if (panel) {
+            panel.remove();
+        }
+
+        if (target) {
+            mount(target, key);
+        }
+    }
+
+    function start() {
+        sync();
+        new MutationObserver(sync).observe(document.body, { childList: true, subtree: true });
+        window.addEventListener('popstate', sync);
+    }
+
+    if (document.body) {
+        start();
+    } else {
+        document.addEventListener('DOMContentLoaded', start);
+    }
+})();
