--- /dev/null
+++ b/app/Support/DataDiff.php
@@ -0,0 +1,52 @@
+<?php
+
+namespace App\Support;
+
+class DataDiff
+{
+    /**
+     * Leaf-level differences from $from to $to, keyed by dot path.
+     * Unchanged values are omitted. Blueprint `__count` keys are storage
+     * ordering metadata rather than content, so they are ignored.
+     *
+     * @return array<int, array{path: string, from: mixed, to: mixed}>
+     */
+    public static function between(array $from, array $to): array
+    {
+        return self::compare(self::normalize($from), self::normalize($to), '');
+    }
+
+    private static function compare(mixed $from, mixed $to, string $path): array
+    {
+        if (! is_array($from) || ! is_array($to)) {
+            return $from === $to ? [] : [['path' => $path, 'from' => $from, 'to' => $to]];
+        }
+
+        $changes = [];
+
+        foreach (array_unique([...array_keys($from), ...array_keys($to)]) as $key) {
+            $childPath = $path === '' ? (string) $key : $path.'.'.$key;
+
+            if (! array_key_exists($key, $from) || ! array_key_exists($key, $to)) {
+                $changes[] = ['path' => $childPath, 'from' => $from[$key] ?? null, 'to' => $to[$key] ?? null];
+
+                continue;
+            }
+
+            $changes = [...$changes, ...self::compare($from[$key], $to[$key], $childPath)];
+        }
+
+        return $changes;
+    }
+
+    private static function normalize(mixed $value): mixed
+    {
+        if (! is_array($value)) {
+            return $value;
+        }
+
+        unset($value['__count']);
+
+        return array_map(fn ($child) => self::normalize($child), $value);
+    }
+}
