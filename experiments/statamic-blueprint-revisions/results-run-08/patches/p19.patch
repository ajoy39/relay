+<?php
+
+namespace App\Support;
+
+class BlueprintContents
+{
+    /**
+     * Compare two stored blueprint payloads and list the leaf values that differ.
+     *
+     * @return array<int, array{path: string, from: mixed, to: mixed}>
+     */
+    public static function diff(array $from, array $to): array
+    {
+        $before = self::flatten(self::normalize($from));
+        $after = self::flatten(self::normalize($to));
+
+        $changes = [];
+
+        foreach (array_unique(array_merge(array_keys($before), array_keys($after))) as $path) {
+            $old = $before[$path] ?? null;
+            $new = $after[$path] ?? null;
+
+            if ($old !== $new) {
+                $changes[] = ['path' => (string) $path, 'from' => $old, 'to' => $new];
+            }
+        }
+
+        return $changes;
+    }
+
+    /**
+     * Strip the eloquent driver's ordering bookkeeping and apply the order it encodes,
+     * matching what the blueprint looks like once it is loaded back from the database.
+     */
+    public static function normalize(mixed $value): mixed
+    {
+        if (! is_array($value)) {
+            return $value;
+        }
+
+        if (collect($value)->every(fn ($item) => is_array($item) && array_key_exists('__count', $item))) {
+            uasort($value, fn ($a, $b) => $a['__count'] <=> $b['__count']);
+        }
+
+        return collect($value)
+            ->reject(fn ($item, $key) => $key === '__count')
+            ->map(fn ($item) => self::normalize($item))
+            ->all();
+    }
+
+    private static function flatten(mixed $value, string $path = ''): array
+    {
+        if (! is_array($value) || $value === []) {
+            return $path === '' ? [] : [$path => $value];
+        }
+
+        $flat = [];
+
+        foreach ($value as $key => $item) {
+            $flat += self::flatten($item, $path === '' ? (string) $key : $path.'.'.$key);
+        }
+
+        return $flat;
+    }
+}
