@@ -0,0 +1,208 @@
+(function () {
+    const EDIT_PATH = /\/fields\/blueprints\/(.+)\/edit\/?$/;
+    const PANEL_ID = 'blueprint-revisions';
+
+    let mountedKey = null;
+
+    function blueprintFromLocation() {
+        const match = window.location.pathname.match(EDIT_PATH);
+
+        if (! match) {
+            return null;
+        }
+
+        // e.g. collections/pages/page => namespace "collections.pages", handle "page"
+        const parts = match[1].split('/').filter(Boolean);
+        const handle = parts.pop();
+
+        return { namespace: parts.join('.'), handle, key: match[1] };
+    }
+
+    function endpoint(blueprint, suffix = '') {
+        const base = window.StatamicConfig.blueprintRevisionsUrl;
+
+        return `${base}/${encodeURIComponent(blueprint.namespace)}/${encodeURIComponent(blueprint.handle)}${suffix}`;
+    }
+
+    function csrfToken() {
+        const match = document.cookie.match(/(?:^|;\s*)XSRF-TOKEN=([^;]*)/);
+
+        return match ? decodeURIComponent(match[1]) : '';
+    }
+
+    async function request(url, options = {}) {
+        const response = await fetch(url, {
+            ...options,
+            headers: {
+                Accept: 'application/json',
+                'X-XSRF-TOKEN': csrfToken(),
+                ...options.headers,
+            },
+        });
+
+        if (! response.ok) {
+            throw new Error(`request failed with status ${response.status}`);
+        }
+
+        return response.json();
+    }
+
+    function el(tag, attributes, ...children) {
+        const node = document.createElement(tag);
+
+        for (const [name, value] of Object.entries(attributes || {})) {
+            node.setAttribute(name, value);
+        }
+
+        node.append(...children);
+
+        return node;
+    }
+
+    function formatValue(value) {
+        return JSON.stringify(value);
+    }
+
+    function diffTable(changes) {
+        if (changes.length === 0) {
+            return el('p', null, 'Restoring this revision would not change anything.');
+        }
+
+        return el('table', null,
+            el('thead', null,
+                el('tr', null, el('th', null, 'Field'), el('th', null, 'Current'), el('th', null, 'Revision')),
+            ),
+            el('tbody', null, ...changes.map((change) =>
+                el('tr', { 'data-revision-change': change.path },
+                    el('td', null, change.path),
+                    el('td', null, formatValue(change.from)),
+                    el('td', null, formatValue(change.to)),
+                ),
+            )),
+        );
+    }
+
+    async function showPreview(blueprint, id, details, status) {
+        status.textContent = '';
+
+        try {
+            const { changes } = await request(endpoint(blueprint, `/${id}/diff`));
+
+            details.replaceChildren(diffTable(changes));
+        } catch (error) {
+            status.textContent = `Could not load preview: ${error.message}`;
+        }
+    }
+
+    async function restoreRevision(blueprint, id, status) {
+        status.textContent = `Restoring revision ${id}…`;
+
+        try {
+            await request(endpoint(blueprint, `/${id}/restore`), { method: 'POST' });
+
+            // Reload so the open editor cannot save its stale form over the restored contents.
+            status.textContent = `Restored revision ${id}. Reloading…`;
+            setTimeout(() => window.location.reload(), 1000);
+        } catch (error) {
+            status.textContent = `Restore failed: ${error.message}`;
+        }
+    }
+
+    function revisionRow(blueprint, revision, status) {
+        const details = el('div', { 'data-revision-details': revision.id });
+
+        const preview = el('button', { type: 'button', 'data-revision-preview': revision.id }, 'Preview');
+        preview.addEventListener('click', () => showPreview(blueprint, revision.id, details, status));
+
+        const restore = el('button', { type: 'button', 'data-revision-restore': revision.id }, 'Restore');
+        restore.addEventListener('click', () => restoreRevision(blueprint, revision.id, status));
+
+        return el('li', { 'data-revision-id': revision.id },
+            el('time', { datetime: revision.created_at }, new Date(revision.created_at).toLocaleString()),
+            ' ',
+            preview,
+            ' ',
+            restore,
+            details,
+        );
+    }
+
+    async function loadHistory(blueprint, list, status) {
+        try {
+            const { revisions } = await request(endpoint(blueprint));
+
+            if (revisions.length === 0) {
+                status.textContent = 'No revisions yet.';
+            }
+
+            list.replaceChildren(...revisions.map((revision) => revisionRow(blueprint, revision, status)));
+        } catch (error) {
+            status.textContent = `Could not load revisions: ${error.message}`;
+        }
+    }
+
+    function mount(blueprint) {
+        let panel = document.getElementById(PANEL_ID);
+
+        if (! panel) {
+            panel = el('section', { id: PANEL_ID });
+            Object.assign(panel.style, {
+                position: 'fixed',
+                right: '1rem',
+                bottom: '1rem',
+                width: '26rem',
+                maxHeight: '60vh',
+                overflowY: 'auto',
+                padding: '1rem',
+                background: '#fff',
+                color: '#111',
+                border: '1px solid #ccc',
+                borderRadius: '0.5rem',
+                boxShadow: '0 4px 16px rgba(0,0,0,0.15)',
+                fontSize: '13px',
+                zIndex: '9999',
+            });
+            document.body.append(panel);
+        }
+
+        const status = el('p', { 'data-revision-status': '' });
+        const list = el('ol', { 'data-revision-list': '' });
+
+        panel.replaceChildren(el('h2', null, 'Revisions'), status, list);
+
+        loadHistory(blueprint, list, status);
+    }
+
+    function sync() {
+        const blueprint = blueprintFromLocation();
+        const panel = document.getElementById(PANEL_ID);
+
+        if (! blueprint) {
+            if (panel) {
+                panel.remove();
+            }
+
+            mountedKey = null;
+
+            return;
+        }
+
+        if (mountedKey === blueprint.key && panel) {
+            return;
+        }
+
+        mountedKey = blueprint.key;
+        mount(blueprint);
+    }
+
+    function start() {
+        new MutationObserver(sync).observe(document.body, { childList: true, subtree: true });
+        sync();
+    }
+
+    if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', start);
+    } else {
+        start();
+    }
+})();
