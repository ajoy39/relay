@@ -0,0 +1,146 @@
+<?php
+
+namespace Tests\Feature;
+
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Statamic\Fields\Blueprint;
+use Tests\TestCase;
+
+class BlueprintRevisionsTest extends TestCase
+{
+    use RefreshDatabase;
+
+    private string $endpoint = '/cp/blueprint-revisions/collections.pages/page';
+
+    public function test_requests_without_a_cp_user_are_rejected(): void
+    {
+        $this->saveBlueprint('Title');
+
+        $this->getJson($this->endpoint)->assertStatus(401);
+        $this->postJson($this->endpoint.'/1/restore')->assertStatus(401);
+        $this->getJson($this->endpoint.'/1/diff')->assertStatus(401);
+    }
+
+    public function test_history_is_empty_before_any_save(): void
+    {
+        $this->actingAsCpUser()
+            ->getJson($this->endpoint)
+            ->assertOk()
+            ->assertExactJson(['revisions' => []]);
+    }
+
+    public function test_each_save_records_a_revision_newest_first(): void
+    {
+        $this->saveBlueprint('Title');
+        $this->saveBlueprint('Headline');
+
+        $response = $this->actingAsCpUser()->getJson($this->endpoint)->assertOk();
+
+        $revisions = $response->json('revisions');
+
+        $this->assertCount(2, $revisions);
+        $this->assertGreaterThan($revisions[1]['id'], $revisions[0]['id']);
+        $this->assertNotEmpty($revisions[0]['created_at']);
+    }
+
+    public function test_diff_describes_what_restoring_a_revision_would_change(): void
+    {
+        $this->saveBlueprint('Title');
+        $this->saveBlueprint('Headline');
+
+        $oldId = $this->actingAsCpUser()->getJson($this->endpoint)->json('revisions.1.id');
+
+        $this->getJson($this->endpoint."/{$oldId}/diff")
+            ->assertOk()
+            ->assertJsonFragment(['path' => 'tabs.main.sections.0.fields.0.field.display', 'from' => 'Headline', 'to' => 'Title'])
+            ->assertJsonCount(1, 'changes');
+    }
+
+    public function test_identical_revision_yields_no_changes(): void
+    {
+        $this->saveBlueprint('Title');
+        $this->saveBlueprint('Title');
+
+        $oldId = $this->actingAsCpUser()->getJson($this->endpoint)->json('revisions.1.id');
+
+        $this->getJson($this->endpoint."/{$oldId}/diff")
+            ->assertOk()
+            ->assertExactJson(['changes' => []]);
+    }
+
+    public function test_restore_applies_the_revision_and_can_be_undone(): void
+    {
+        $this->saveBlueprint('Title');
+        $this->saveBlueprint('Headline');
+
+        $history = $this->actingAsCpUser()->getJson($this->endpoint)->json('revisions');
+        [$latestId, $originalId] = [$history[0]['id'], $history[1]['id']];
+
+        $this->postJson($this->endpoint."/{$originalId}/restore")
+            ->assertOk()
+            ->assertExactJson(['restored' => true]);
+
+        $this->assertEquals('Title', $this->storedTitle());
+        $this->assertCount(3, $this->getJson($this->endpoint)->json('revisions'));
+
+        $this->postJson($this->endpoint."/{$latestId}/restore")->assertOk();
+
+        $this->assertEquals('Headline', $this->storedTitle());
+    }
+
+    public function test_blueprint_edit_page_loads_the_revisions_panel(): void
+    {
+        $this->saveBlueprint('Title');
+
+        $this->actingAsCpUser()
+            ->get('/cp/fields/blueprints/collections/pages/page/edit')
+            ->assertOk()
+            ->assertSee('blueprint-revisions/js/revisions', false);
+    }
+
+    public function test_revisions_are_scoped_to_their_blueprint(): void
+    {
+        $this->saveBlueprint('Title');
+
+        $otherId = $this->actingAsCpUser()->getJson($this->endpoint)->json('revisions.0.id');
+
+        $this->getJson('/cp/blueprint-revisions/collections.articles/page/'.$otherId.'/diff')
+            ->assertNotFound();
+    }
+
+    private function actingAsCpUser(): static
+    {
+        return $this->actingAs(User::factory()->create(['super' => true]));
+    }
+
+    private function saveBlueprint(string $title): void
+    {
+        Blueprint::make()
+            ->setHandle('page')
+            ->setNamespace('collections.pages')
+            ->setContents([
+                'title' => 'Page',
+                'tabs' => [
+                    'main' => [
+                        'display' => 'Main',
+                        'sections' => [
+                            [
+                                'display' => 'Main',
+                                'fields' => [
+                                    ['handle' => 'title', 'field' => ['type' => 'text', 'display' => $title]],
+                                ],
+                            ],
+                        ],
+                    ],
+                ],
+            ])
+            ->save();
+    }
+
+    private function storedTitle(): ?string
+    {
+        return \Statamic\Facades\Blueprint::find('collections.pages.page')
+            ->contents()['tabs']['main']['sections'][0]['fields'][0]['field']['display'] ?? null;
+    }
+}
