@@ -0,0 +1,179 @@
+/*
+ * Revision history for blueprints, shown on the blueprint edit page.
+ * Talks to the routes in routes/web.php (cp/blueprint-revisions/...).
+ */
+(function () {
+    const EDIT_PAGE = /^\/cp\/fields\/blueprints\/([^/]+)\/([^/]+)\/([^/]+)\/edit\/?$/;
+    const SECTION_ID = 'blueprint-revisions';
+
+    function blueprintFromPath(path) {
+        const match = path.match(EDIT_PAGE);
+
+        return match ? { namespace: `${match[1]}.${match[2]}`, handle: match[3] } : null;
+    }
+
+    function element(tag, attributes = {}, text = null) {
+        const node = document.createElement(tag);
+
+        Object.entries(attributes).forEach(([name, value]) => node.setAttribute(name, value));
+
+        if (text !== null) {
+            node.textContent = text;
+        }
+
+        return node;
+    }
+
+    function csrfToken() {
+        const meta = document.querySelector('meta[name="csrf-token"]');
+
+        if (meta) {
+            return meta.content;
+        }
+
+        const cookie = document.cookie.match(/XSRF-TOKEN=([^;]+)/);
+
+        return cookie ? decodeURIComponent(cookie[1]) : '';
+    }
+
+    function request(blueprint, suffix = '', method = 'GET') {
+        const url = `/cp/blueprint-revisions/${encodeURIComponent(blueprint.namespace)}/${encodeURIComponent(blueprint.handle)}${suffix}`;
+        const headers = { Accept: 'application/json' };
+
+        if (method !== 'GET') {
+            headers['X-CSRF-TOKEN'] = csrfToken();
+        }
+
+        return fetch(url, { method, headers, credentials: 'same-origin' }).then(async (response) => {
+            const body = await response.json().catch(() => ({}));
+
+            if (!response.ok) {
+                throw new Error(body.message || `Request failed (${response.status})`);
+            }
+
+            return body;
+        });
+    }
+
+    function showStatus(section, message) {
+        section.querySelector('.revisions-status').textContent = message;
+    }
+
+    function renderChanges(container, changes) {
+        container.textContent = '';
+
+        if (changes.length === 0) {
+            container.appendChild(element('p', {}, 'Restoring this revision would not change the blueprint.'));
+
+            return;
+        }
+
+        const list = element('ul', { class: 'revisions-changes' });
+
+        changes.forEach((change) => {
+            const item = element('li');
+
+            item.appendChild(element('code', {}, change.path));
+            item.appendChild(document.createTextNode(`: ${JSON.stringify(change.from)} → ${JSON.stringify(change.to)}`));
+            list.appendChild(item);
+        });
+
+        container.appendChild(list);
+    }
+
+    function renderRow(section, blueprint, revision) {
+        const row = element('li', { 'data-revision-id': revision.id });
+        const details = element('div', { 'data-revision-changes': revision.id, hidden: '' });
+
+        const preview = element('button', { type: 'button', 'data-revision-preview': revision.id }, 'Preview');
+        const restore = element('button', { type: 'button', 'data-revision-restore': revision.id }, 'Restore');
+
+        preview.addEventListener('click', () => {
+            request(blueprint, `/${revision.id}/diff`)
+                .then((body) => {
+                    renderChanges(details, body.changes);
+                    details.hidden = false;
+                })
+                .catch((error) => showStatus(section, error.message));
+        });
+
+        restore.addEventListener('click', () => {
+            request(blueprint, `/${revision.id}/restore`, 'POST')
+                .then(() => load(section, blueprint))
+                .then(() => showStatus(section, 'Revision restored. Reload this page before editing so the form shows the restored blueprint.'))
+                .catch((error) => showStatus(section, error.message));
+        });
+
+        row.appendChild(element('time', { datetime: revision.created_at }, new Date(revision.created_at).toLocaleString()));
+        row.appendChild(document.createTextNode(' '));
+        row.appendChild(preview);
+        row.appendChild(document.createTextNode(' '));
+        row.appendChild(restore);
+        row.appendChild(details);
+
+        return row;
+    }
+
+    function load(section, blueprint) {
+        const list = section.querySelector('.revisions-list');
+
+        return request(blueprint)
+            .then((body) => {
+                list.textContent = '';
+
+                if (body.revisions.length === 0) {
+                    showStatus(section, 'No revisions yet. Each save of this blueprint creates one.');
+
+                    return;
+                }
+
+                showStatus(section, '');
+                body.revisions.forEach((revision) => list.appendChild(renderRow(section, blueprint, revision)));
+            })
+            .catch((error) => showStatus(section, error.message));
+    }
+
+    function mount(blueprint) {
+        const section = element('section', {
+            id: SECTION_ID,
+            'data-namespace': blueprint.namespace,
+            'data-handle': blueprint.handle,
+        });
+
+        section.appendChild(element('h2', {}, 'Revisions'));
+        section.appendChild(element('p', { class: 'revisions-status' }, 'Loading revisions…'));
+        section.appendChild(element('ol', { class: 'revisions-list' }));
+
+        (document.querySelector('main') || document.body).appendChild(section);
+
+        load(section, blueprint);
+    }
+
+    function sync() {
+        const blueprint = blueprintFromPath(window.location.pathname);
+        const existing = document.getElementById(SECTION_ID);
+
+        if (!blueprint) {
+            if (existing) {
+                existing.remove();
+            }
+
+            return;
+        }
+
+        if (existing && existing.dataset.namespace === blueprint.namespace && existing.dataset.handle === blueprint.handle) {
+            return;
+        }
+
+        if (existing) {
+            existing.remove();
+        }
+
+        mount(blueprint);
+    }
+
+    // The CP is an Inertia app, so pages change without a full load. Watch the DOM instead.
+    new MutationObserver(sync).observe(document.body, { childList: true, subtree: true });
+    window.addEventListener('popstate', sync);
+    sync();
+})();
