+<?php
+
+namespace App\Observers;
+
+use App\Models\BlueprintRevision;
+
+class BlueprintRevisionObserver
+{
+    /**
+     * Record the contents an edit replaced, so every earlier version stays restorable.
+     * Creating a blueprint replaces nothing, so it records nothing. Restores go through
+     * the same save path, so they are recorded too.
+     */
+    public function saved($blueprint): void
+    {
+        if ($blueprint->wasRecentlyCreated || ! $blueprint->wasChanged('data')) {
+            return;
+        }
+
+        $replaced = $blueprint->getOriginal('data');
+
+        BlueprintRevision::create([
+            'namespace' => $blueprint->getAttributeValue('namespace'),
+            'handle' => $blueprint->getAttributeValue('handle'),
+            'data' => is_array($replaced) ? $replaced : json_decode($replaced, true),
+        ]);
+    }
+}
