+<?php
+
+namespace App\Http\Controllers\CP;
+
+use App\Http\Controllers\Controller;
+use App\Models\BlueprintRevision;
+use App\Support\BlueprintContents;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Support\Arr;
+use Statamic\Facades\Blueprint;
+
+class BlueprintRevisionController extends Controller
+{
+    public function index(string $namespace, string $handle): JsonResponse
+    {
+        $revisions = BlueprintRevision::query()
+            ->where('namespace', $namespace)
+            ->where('handle', $handle)
+            ->orderByDesc('id')
+            ->get()
+            ->map(fn (BlueprintRevision $revision) => [
+                'id' => $revision->id,
+                'created_at' => $revision->created_at->toIso8601String(),
+            ])
+            ->values();
+
+        return response()->json(['revisions' => $revisions]);
+    }
+
+    public function diff(string $namespace, string $handle, int $id): JsonResponse
+    {
+        $revision = $this->revision($namespace, $handle, $id);
+
+        $current = app('statamic.eloquent.blueprints.model')::query()
+            ->where('namespace', $namespace)
+            ->where('handle', $handle)
+            ->first();
+
+        $changes = BlueprintContents::changes(
+            $current ? $current->getAttributeValue('data') : [],
+            $revision->data,
+        );
+
+        return response()->json(['changes' => $changes]);
+    }
+
+    public function restore(string $namespace, string $handle, int $id): JsonResponse
+    {
+        $revision = $this->revision($namespace, $handle, $id);
+
+        $blueprint = Blueprint::find("{$namespace}.{$handle}")
+            ?? Blueprint::make($handle)->setNamespace($namespace);
+
+        $blueprint
+            ->setHidden(Arr::get($revision->data, 'hide'))
+            ->setOrder(Arr::get($revision->data, 'order'))
+            ->setContents(Arr::except(BlueprintContents::ordered($revision->data), ['hide', 'order']))
+            ->save();
+
+        return response()->json(['restored' => true]);
+    }
+
+    private function revision(string $namespace, string $handle, int $id): BlueprintRevision
+    {
+        return BlueprintRevision::query()
+            ->where('namespace', $namespace)
+            ->where('handle', $handle)
+            ->findOrFail($id);
+    }
+}
