index 0000000..b32aa0c
--- /dev/null
+++ b/app/Support/BlueprintContents.php
@@ -0,0 +1,103 @@
+<?php
+
+namespace App\Support;
+
+class BlueprintContents
+{
+    /**
+     * Remove Statamic's internal ordering keys so contents can be compared by value.
+     */
+    public static function comparable(array $contents): array
+    {
+        unset($contents['__count']);
+
+        return array_map(
+            fn ($value) => is_array($value) ? self::comparable($value) : $value,
+            $contents,
+        );
+    }
+
+    /**
+     * Order tabs and sections by their stored position, then strip the ordering keys.
+     * Used before a revision is written back, so the restored order matches the revision.
+     */
+    public static function ordered(array $contents): array
+    {
+        if (is_array($contents['tabs'] ?? null)) {
+            $contents['tabs'] = collect($contents['tabs'])
+                ->sortBy('__count')
+                ->map(function ($tab) {
+                    if (is_array($tab['sections'] ?? null)) {
+                        $tab['sections'] = collect($tab['sections'])->sortBy('__count')->values()->all();
+                    }
+
+                    return $tab;
+                })
+                ->all();
+        }
+
+        return self::comparable($contents);
+    }
+
+    /**
+     * Describe what changes when going from $from to $to, as flat dot paths.
+     * Values that are equal on both sides are left out.
+     */
+    public static function changes(array $from, array $to): array
+    {
+        $before = self::flatten(self::comparable($from));
+        $after = self::flatten(self::comparable($to));
+
+        $changes = [];
+
+        foreach (array_unique(array_merge(array_keys($before), array_keys($after))) as $path) {
+            $fromValue = $before[$path] ?? null;
+            $toValue = $after[$path] ?? null;
+
+            if ($fromValue !== $toValue) {
+                $changes[] = [
+                    'path' => (string) $path,
+                    'from' => $fromValue,
+                    'to' => $toValue,
+                ];
+            }
+        }
+
+        return $changes;
+    }
+
+    private static function flatten(array $value, string $prefix = ''): array
+    {
+        $flat = [];
+        $segments = self::segments($value);
+
+        foreach ($value as $key => $item) {
+            $path = $prefix === '' ? (string) $segments[$key] : $prefix.'.'.$segments[$key];
+
+            if (is_array($item) && $item !== []) {
+                $flat += self::flatten($item, $path);
+            } else {
+                $flat[$path] = $item;
+            }
+        }
+
+        return $flat;
+    }
+
+    /**
+     * Use each item's handle as its path segment when a list of items has unique handles,
+     * so a field's path does not shift when another field is inserted above it.
+     */
+    private static function segments(array $value): array
+    {
+        if (! array_is_list($value)) {
+            return array_combine(array_keys($value), array_keys($value));
+        }
+
+        $handles = array_map(fn ($item) => is_array($item) ? ($item['handle'] ?? null) : null, $value);
+
+        $named = ! in_array(null, $handles, true) && count(array_unique($handles)) === count($handles);
+
+        return $named ? $handles : array_keys($value);
+    }
+}
