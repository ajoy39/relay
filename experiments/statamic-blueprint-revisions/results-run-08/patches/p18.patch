diff --git a/tests/Feature/BlueprintRevisionTest.php b/tests/Feature/BlueprintRevisionTest.php
new file mode 100644
index 0000000..bc36071
--- /dev/null
+++ b/tests/Feature/BlueprintRevisionTest.php
@@ -0,0 +1,172 @@
+<?php
+
+namespace Tests\Feature;
+
+use App\Models\BlueprintRevision;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Statamic\Facades\Blueprint;
+use Statamic\Facades\User;
+use Tests\TestCase;
+
+class BlueprintRevisionTest extends TestCase
+{
+    use RefreshDatabase;
+
+    private string $namespace = 'collections.pages';
+
+    private string $handle = 'page';
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+
+        // Creating the blueprint records nothing. The first edit records the 'Body' it replaced.
+        $this->saveBody('Body');
+        $this->saveBody('Body v1');
+    }
+
+    private function saveBody(string $display): void
+    {
+        $blueprint = Blueprint::find("{$this->namespace}.{$this->handle}")
+            ?? Blueprint::make($this->handle)->setNamespace($this->namespace);
+
+        $blueprint->setContents([
+            'title' => 'Page',
+            'tabs' => [
+                'main' => [
+                    'sections' => [
+                        ['fields' => [
+                            ['handle' => 'title', 'field' => ['type' => 'text', 'display' => 'Title']],
+                            ['handle' => 'content', 'field' => ['type' => 'markdown', 'display' => $display]],
+                        ]],
+                    ],
+                ],
+            ],
+        ])->save();
+    }
+
+    private function signIn(): void
+    {
+        $user = User::make()->email('editor@example.test')->set('name', 'Editor')->makeSuper();
+        $user->save();
+
+        $this->actingAs($user);
+    }
+
+    private function url(string $suffix = ''): string
+    {
+        return "/cp/blueprint-revisions/{$this->namespace}/{$this->handle}{$suffix}";
+    }
+
+    private function oldestId(): int
+    {
+        return BlueprintRevision::orderBy('id')->first()->id;
+    }
+
+    private function newestId(): int
+    {
+        return BlueprintRevision::orderByDesc('id')->first()->id;
+    }
+
+    private function displayOf($blueprint): ?string
+    {
+        return $this->displayIn($blueprint->contents());
+    }
+
+    private function displayIn(array $contents): ?string
+    {
+        return $contents['tabs']['main']['sections'][0]['fields'][1]['field']['display'] ?? null;
+    }
+
+    private function current()
+    {
+        return Blueprint::find("{$this->namespace}.{$this->handle}");
+    }
+
+    public function test_every_edit_records_the_contents_it_replaced(): void
+    {
+        $this->saveBody('Body v2');
+
+        $this->assertSame(2, BlueprintRevision::count());
+        $this->assertSame('Body v1', $this->revisionDisplay($this->newestId()));
+    }
+
+    public function test_a_save_without_changes_records_nothing(): void
+    {
+        $this->saveBody('Body v1');
+
+        $this->assertSame(1, BlueprintRevision::count());
+    }
+
+    public function test_creating_a_blueprint_records_nothing(): void
+    {
+        $this->assertSame(1, BlueprintRevision::count());
+    }
+
+    public function test_revisions_are_listed_newest_first(): void
+    {
+        $this->saveBody('Body v2');
+        $this->signIn();
+
+        $response = $this->getJson($this->url())->assertOk();
+
+        $ids = collect($response->json('revisions'))->pluck('id')->all();
+        $this->assertSame(BlueprintRevision::orderByDesc('id')->pluck('id')->all(), $ids);
+        $this->assertNotEmpty($response->json('revisions.0.created_at'));
+    }
+
+    public function test_diff_reports_only_the_values_restoring_would_change(): void
+    {
+        $this->signIn();
+
+        $changes = $this->getJson($this->url("/{$this->oldestId()}/diff"))->assertOk()->json('changes');
+
+        $this->assertCount(1, $changes);
+        $this->assertSame('tabs.main.sections.0.fields.content.field.display', $changes[0]['path']);
+        $this->assertSame('Body v1', $changes[0]['from']);
+        $this->assertSame('Body', $changes[0]['to']);
+    }
+
+    public function test_preview_does_not_apply_the_revision(): void
+    {
+        $this->signIn();
+
+        $this->getJson($this->url("/{$this->oldestId()}/diff"))->assertOk();
+
+        $this->assertSame('Body v1', $this->displayOf($this->current()));
+    }
+
+    public function test_restore_reverts_the_blueprint_and_is_itself_recorded(): void
+    {
+        $this->signIn();
+
+        $this->postJson($this->url("/{$this->oldestId()}/restore"))->assertOk()->assertExactJson(['restored' => true]);
+
+        $this->assertSame('Body', $this->displayOf($this->current()));
+        $this->assertSame(2, BlueprintRevision::count());
+        $this->getJson($this->url("/{$this->oldestId()}/diff"))->assertOk()->assertExactJson(['changes' => []]);
+    }
+
+    public function test_restore_can_be_undone(): void
+    {
+        $this->signIn();
+
+        $this->postJson($this->url("/{$this->oldestId()}/restore"))->assertOk();
+        // The restore recorded the contents it replaced ('Body v1'); restoring that undoes it.
+        $this->postJson($this->url("/{$this->newestId()}/restore"))->assertOk();
+
+        $this->assertSame('Body v1', $this->displayOf($this->current()));
+    }
+
+    public function test_unauthenticated_requests_are_refused(): void
+    {
+        $this->assertNotSame(200, $this->get($this->url())->getStatusCode());
+        $this->assertNotSame(200, $this->get($this->url("/{$this->oldestId()}/diff"))->getStatusCode());
+        $this->assertNotSame(200, $this->post($this->url("/{$this->oldestId()}/restore"))->getStatusCode());
+    }
+
+    private function revisionDisplay(int $id): ?string
+    {
+        return $this->displayIn(BlueprintRevision::find($id)->data);
+    }
+}
