+<?php
+
+namespace App\Listeners;
+
+use App\Models\BlueprintRevision;
+
+class RecordBlueprintRevision
+{
+    public function handle($event)
+    {
+        try {
+            $blueprint = $event->blueprint;
+
+            \Log::debug('RecordBlueprintRevision: Recording revision', [
+                'handle' => $blueprint->handle(),
+                'namespace' => $blueprint->namespace(),
+            ]);
+
+            BlueprintRevision::create([
+                'namespace' => $blueprint->namespace(),
+                'handle' => $blueprint->handle(),
+                'data' => $blueprint->contents(),
+            ]);
+
+            \Log::debug('RecordBlueprintRevision: Revision recorded successfully');
+        } catch (\Exception $e) {
+            \Log::error('Failed to record blueprint revision', [
+                'error' => $e->getMessage(),
+                'trace' => $e->getTraceAsString(),
+            ]);
+        }
+    }
+}
