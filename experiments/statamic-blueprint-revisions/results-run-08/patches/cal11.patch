+<?php
+
+namespace App\Http\Controllers;
+
+use App\Models\BlueprintRevision;
+use Illuminate\Http\Request;
+
+class BlueprintRevisionController extends Controller
+{
+    public function index($namespace, $handle)
+    {
+        if (!auth()->check()) {
+            return response()->json(['error' => 'Unauthorized'], 401);
+        }
+
+        $ns = $namespace === 'null' ? null : $namespace;
+        $revisions = BlueprintRevision::where('namespace', $ns)
+            ->where('handle', $handle)
+            ->orderByDesc('created_at')
+            ->get(['id', 'created_at']);
+
+        return response()->json([
+            'revisions' => $revisions->map(fn ($r) => [
+                'id' => $r->id,
+                'created_at' => $r->created_at->toIso8601String(),
+            ]),
+        ]);
+    }
+
+    public function diff($namespace, $handle, $id)
+    {
+        if (!auth()->check()) {
+            return response()->json(['error' => 'Unauthorized'], 401);
+        }
+
+        $ns = $namespace === 'null' ? null : $namespace;
+        $revision = BlueprintRevision::find($id);
+
+        if (!$revision || $revision->namespace !== $ns || $revision->handle !== $handle) {
+            return response()->json(['changes' => []], 404);
+        }
+
+        $blueprintKey = $ns ? "$ns.$handle" : $handle;
+        $current = \Statamic\Facades\Blueprint::find($blueprintKey);
+        if (!$current) {
+            return response()->json(['changes' => []], 404);
+        }
+
+        $currentData = $current->contents();
+        $revisionData = $revision->data;
+
+        $changes = $this->computeDiff($revisionData, $currentData);
+
+        return response()->json(['changes' => $changes]);
+    }
+
+    public function restore($namespace, $handle, $id, Request $request)
+    {
+        if (!auth()->check()) {
+            return response()->json(['error' => 'Unauthorized'], 401);
+        }
+
+        $ns = $namespace === 'null' ? null : $namespace;
+        $revision = BlueprintRevision::find($id);
+
+        if (!$revision || $revision->namespace !== $ns || $revision->handle !== $handle) {
+            return response()->json(['restored' => false], 404);
+        }
+
+        $blueprintKey = $ns ? "$ns.$handle" : $handle;
+        $blueprint = \Statamic\Facades\Blueprint::find($blueprintKey);
+        if (!$blueprint) {
+            return response()->json(['restored' => false], 404);
+        }
+
+        $blueprint->setContents($revision->data);
+        $blueprint->save();
+
+        return response()->json(['restored' => true]);
+    }
+
+    private function computeDiff($from, $to)
+    {
+        $changes = [];
+        $this->diffRecursive($from, $to, '', $changes);
+        return $changes;
+    }
+
+    private function diffRecursive($from, $to, $path, &$changes)
+    {
+        $allKeys = array_unique(array_merge(array_keys((array) $from), array_keys((array) $to)));
+
+        foreach ($allKeys as $key) {
+            $currentPath = $path ? "$path.$key" : $key;
+            $fromVal = $from[$key] ?? null;
+            $toVal = $to[$key] ?? null;
+
+            if (is_array($fromVal) && is_array($toVal)) {
+                $this->diffRecursive($fromVal, $toVal, $currentPath, $changes);
+            } elseif ($fromVal !== $toVal) {
+                $changes[] = [
+                    'path' => $currentPath,
+                    'from' => $fromVal,
+                    'to' => $toVal,
+                ];
+            }
+        }
+    }
+}
