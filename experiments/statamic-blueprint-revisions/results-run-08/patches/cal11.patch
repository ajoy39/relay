diff --git a/public/js/blueprint-revisions.js b/public/js/blueprint-revisions.js
new file mode 100644
index 0000000..fc2dd2c
--- /dev/null
+++ b/public/js/blueprint-revisions.js
@@ -0,0 +1,259 @@
+// Blueprint revisions UI injection
+const injectUI = async () => {
+  // Check if we're on a blueprint edit page by looking at the URL
+  // URL format: /cp/fields/blueprints/{collection}/{type}/{handle}/edit
+  // or: /cp/fields/blueprints/{namespace.with.dots}/{handle}/edit
+  const match = window.location.pathname.match(/\/cp\/fields\/blueprints\/(.+)\/([^/]+)\/edit/);
+  if (!match) {
+    // Try again in a moment if page not fully loaded
+    setTimeout(injectUI, 1000);
+    return;
+  }
+
+  let [, namespace, handle] = match;
+  // Convert URL parts to dot notation
+  // If namespace is like "collections/pages", convert to "collections.pages"
+  namespace = namespace.replace(/\//g, '.');
+  const apiBase = '/cp/blueprint-revisions';
+  const apiUrl = `${apiBase}/${namespace}/${handle}`;
+
+  try {
+    // Fetch revisions
+    const res = await fetch(apiUrl);
+    if (!res.ok) return;
+
+    const data = await res.json();
+    if (!data.revisions || !Array.isArray(data.revisions)) return;
+
+    // Wait a bit for the page to fully render
+    await new Promise(resolve => setTimeout(resolve, 500));
+
+    // Inject revision UI into the page
+    injectRevisionUI(namespace, handle, data.revisions, apiBase);
+  } catch (e) {
+    console.error('Failed to load blueprint revisions:', e);
+  }
+};
+
+// Start injection immediately
+if (document.readyState === 'loading') {
+  document.addEventListener('DOMContentLoaded', injectUI);
+} else {
+  injectUI();
+}
+
+function injectRevisionUI(namespace, handle, revisions, apiBase) {
+  // Find or create a section for revisions
+  let revisionsSection = document.querySelector('[data-revisions-section]');
+
+  if (!revisionsSection) {
+    // Create the revisions section
+    const mainContent = document.querySelector('main') || document.body;
+    revisionsSection = document.createElement('div');
+    revisionsSection.setAttribute('data-revisions-section', '');
+    revisionsSection.innerHTML = `
+      <div style="padding: 20px; border-top: 1px solid #e5e7eb;">
+        <h3 style="margin: 0 0 15px 0; font-size: 16px; font-weight: 600;">Revisions</h3>
+        <div data-revisions-list style="display: flex; flex-direction: column; gap: 10px;"></div>
+      </div>
+    `;
+    mainContent.appendChild(revisionsSection);
+  }
+
+  const list = document.querySelector('[data-revisions-list]');
+  if (!list) return;
+
+  // Clear existing revisions
+  list.innerHTML = '';
+
+  // Add each revision
+  revisions.forEach(revision => {
+    const row = document.createElement('div');
+    row.setAttribute('data-revision-id', revision.id);
+    row.style.cssText = `
+      padding: 10px;
+      border: 1px solid #d1d5db;
+      border-radius: 4px;
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+    `;
+
+    const dateStr = new Date(revision.created_at).toLocaleString();
+    const info = document.createElement('div');
+    info.textContent = dateStr;
+
+    const buttons = document.createElement('div');
+    buttons.style.cssText = 'display: flex; gap: 8px;';
+
+    // Preview button
+    const previewBtn = document.createElement('button');
+    previewBtn.setAttribute('data-revision-preview', revision.id);
+    previewBtn.textContent = 'Preview';
+    previewBtn.style.cssText = `
+      padding: 6px 12px;
+      background: #3b82f6;
+      color: white;
+      border: none;
+      border-radius: 4px;
+      cursor: pointer;
+      font-size: 12px;
+    `;
+    previewBtn.addEventListener('click', () => showPreview(namespace, handle, revision.id, apiBase));
+
+    // Restore button
+    const restoreBtn = document.createElement('button');
+    restoreBtn.setAttribute('data-revision-restore', revision.id);
+    restoreBtn.textContent = 'Restore';
+    restoreBtn.style.cssText = `
+      padding: 6px 12px;
+      background: #10b981;
+      color: white;
+      border: none;
+      border-radius: 4px;
+      cursor: pointer;
+      font-size: 12px;
+    `;
+    restoreBtn.addEventListener('click', () => restoreRevision(namespace, handle, revision.id, apiBase));
+
+    buttons.appendChild(previewBtn);
+    buttons.appendChild(restoreBtn);
+
+    row.appendChild(info);
+    row.appendChild(buttons);
+
+    list.appendChild(row);
+  });
+}
+
+function showPreview(namespace, handle, revisionId, apiBase) {
+  const apiUrl = `${apiBase}/${namespace}/${handle}/${revisionId}/diff`;
+
+  fetch(apiUrl)
+    .then(res => res.json())
+    .then(data => {
+      // Create and show a preview modal or section
+      let preview = document.querySelector(`[data-revision-preview-modal="${revisionId}"]`);
+      if (!preview) {
+        preview = document.createElement('div');
+        preview.setAttribute('data-revision-preview-modal', revisionId);
+        preview.style.cssText = `
+          position: fixed;
+          top: 20px;
+          right: 20px;
+          background: white;
+          border: 1px solid #d1d5db;
+          border-radius: 8px;
+          padding: 20px;
+          max-width: 500px;
+          max-height: 80vh;
+          overflow-y: auto;
+          box-shadow: 0 10px 25px rgba(0,0,0,0.1);
+          z-index: 9999;
+        `;
+
+        const closeBtn = document.createElement('button');
+        closeBtn.innerHTML = '&times;';
+        closeBtn.style.cssText = `
+          position: absolute;
+          top: 10px;
+          right: 10px;
+          background: none;
+          border: none;
+          font-size: 24px;
+          cursor: pointer;
+        `;
+        closeBtn.addEventListener('click', () => preview.remove());
+
+        preview.appendChild(closeBtn);
+
+        const title = document.createElement('h4');
+        title.textContent = 'Preview Changes';
+        title.style.cssText = 'margin: 0 0 15px 0; font-size: 14px; font-weight: 600;';
+        preview.appendChild(title);
+
+        const changesList = document.createElement('div');
+        changesList.setAttribute('data-preview-changes', '');
+        preview.appendChild(changesList);
+
+        document.body.appendChild(preview);
+      }
+
+      // Populate changes
+      const changesList = preview.querySelector('[data-preview-changes]');
+      changesList.innerHTML = '';
+
+      if (!data.changes || data.changes.length === 0) {
+        changesList.textContent = 'No changes';
+      } else {
+        data.changes.forEach(change => {
+          const changeEl = document.createElement('div');
+          changeEl.style.cssText = `
+            margin-bottom: 12px;
+            padding: 10px;
+            background: #f3f4f6;
+            border-radius: 4px;
+            font-size: 12px;
+          `;
+
+          const pathEl = document.createElement('div');
+          pathEl.textContent = `Path: ${change.path}`;
+          pathEl.style.cssText = 'font-weight: 600; margin-bottom: 5px;';
+
+          const fromEl = document.createElement('div');
+          fromEl.textContent = `From: ${JSON.stringify(change.from)}`;
+          fromEl.style.cssText = 'color: #ef4444; margin-bottom: 3px; word-break: break-all;';
+
+          const toEl = document.createElement('div');
+          toEl.textContent = `To: ${JSON.stringify(change.to)}`;
+          toEl.style.cssText = 'color: #10b981; word-break: break-all;';
+
+          changeEl.appendChild(pathEl);
+          changeEl.appendChild(fromEl);
+          changeEl.appendChild(toEl);
+
+          changesList.appendChild(changeEl);
+        });
+      }
+    })
+    .catch(e => console.error('Failed to load preview:', e));
+}
+
+function restoreRevision(namespace, handle, revisionId, apiBase) {
+  const apiUrl = `${apiBase}/${namespace}/${handle}/${revisionId}/restore`;
+
+  // Get CSRF token from meta tag or cookies
+  const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
+  const xsrfCookie = document.cookie.split('; ').find(row => row.startsWith('XSRF-TOKEN='));
+
+  const headers = {
+    'Content-Type': 'application/json',
+    'Accept': 'application/json',
+    'X-Requested-With': 'XMLHttpRequest',
+  };
+
+  if (csrfToken) {
+    headers['X-CSRF-TOKEN'] = csrfToken;
+  }
+  if (xsrfCookie) {
+    headers['X-XSRF-TOKEN'] = decodeURIComponent(xsrfCookie.split('=')[1]);
+  }
+
+  fetch(apiUrl, {
+    method: 'POST',
+    headers,
+  })
+    .then(res => res.json())
+    .then(data => {
+      if (data.restored) {
+        alert('Revision restored successfully');
+        window.location.reload();
+      } else {
+        alert('Failed to restore revision');
+      }
+    })
+    .catch(e => {
+      console.error('Failed to restore revision:', e);
+      alert('Error restoring revision');
+    });
+}
