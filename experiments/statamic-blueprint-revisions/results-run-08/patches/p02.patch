@@ -0,0 +1,159 @@
+(() => {
+    const cpRoute = @json($cpRoute);
+    const endpoint = cpRoute + '/blueprint-revisions';
+    const editPrefix = cpRoute + '/fields/blueprints/';
+    const panelAttr = 'data-blueprint-revisions';
+
+    // Returns { namespace, handle } when the URL is a blueprint edit page.
+    const editing = () => {
+        const path = window.location.pathname.replace(/\/+$/, '');
+        if (! path.startsWith(editPrefix) || ! path.endsWith('/edit')) return null;
+
+        const parts = path.slice(editPrefix.length, -'/edit'.length).split('/').filter(Boolean);
+        if (parts.length < 2) return null;
+
+        return { namespace: parts.slice(0, -1).join('.'), handle: parts[parts.length - 1] };
+    };
+
+    const el = (tag, attrs = {}, children = []) => {
+        const node = document.createElement(tag);
+        Object.entries(attrs).forEach(([name, value]) => node.setAttribute(name, value));
+        children.forEach((child) => node.append(child));
+        return node;
+    };
+
+    const xsrfToken = () => {
+        const match = document.cookie.match(/(?:^|; )XSRF-TOKEN=([^;]*)/);
+        return match ? decodeURIComponent(match[1]) : '';
+    };
+
+    const request = async (url, options = {}) => {
+        const response = await fetch(url, {
+            ...options,
+            credentials: 'same-origin',
+            headers: { Accept: 'application/json', 'X-XSRF-TOKEN': xsrfToken() },
+        });
+
+        if (! response.ok) throw new Error(`HTTP ${response.status}`);
+
+        return response.json();
+    };
+
+    const showPreview = (panel, changes, id) => {
+        const output = panel.querySelector('[data-revision-diff]');
+        output.replaceChildren();
+
+        if (changes.length === 0) {
+            output.append(el('p', {}, [`Restoring revision ${id} would change nothing.`]));
+            return;
+        }
+
+        const header = el('tr', {}, ['Field path', 'Current', 'Restored'].map((text) => el('th', { style: 'text-align: left; padding: 4px 8px;' }, [text])));
+        const rows = changes.map((change) => el('tr', {}, [
+            el('td', { style: 'padding: 4px 8px; font-family: monospace;' }, [change.path]),
+            el('td', { style: 'padding: 4px 8px; font-family: monospace; white-space: pre-wrap;' }, [JSON.stringify(change.from)]),
+            el('td', { style: 'padding: 4px 8px; font-family: monospace; white-space: pre-wrap;' }, [JSON.stringify(change.to)]),
+        ]));
+
+        output.append(
+            el('p', {}, [`Restoring revision ${id} would change ${changes.length} ${changes.length === 1 ? 'value' : 'values'}. Nothing has been applied.`]),
+            el('table', {}, [el('thead', {}, [header]), el('tbody', {}, rows)]),
+        );
+    };
+
+    const buildPanel = ({ namespace, handle }) => {
+        const base = `${endpoint}/${encodeURIComponent(namespace)}/${encodeURIComponent(handle)}`;
+        const panel = el('section', { [panelAttr]: `${namespace}/${handle}`, style: 'margin: 2rem 0; padding: 1rem 1.5rem; border: 1px solid rgba(128,128,128,.3); border-radius: 8px;' }, [
+            el('h2', { style: 'font-size: 1.125rem; font-weight: 600; margin-bottom: .5rem;' }, ['Revisions']),
+            el('p', { style: 'margin-bottom: .75rem; opacity: .75;' }, ['Each save records a revision. Preview shows what restoring one would change.']),
+            el('ul', { 'data-revision-list': '', style: 'margin-bottom: .75rem;' }, []),
+            el('div', { 'data-revision-diff': '' }, []),
+            el('p', { 'data-revision-status': '', style: 'margin-top: .5rem;' }, []),
+        ]);
+
+        const status = panel.querySelector('[data-revision-status]');
+        const list = panel.querySelector('[data-revision-list]');
+
+        panel.addEventListener('click', async (event) => {
+            const preview = event.target.closest('[data-revision-preview]');
+            const restore = event.target.closest('[data-revision-restore]');
+
+            if (preview) {
+                const id = preview.getAttribute('data-revision-preview');
+                status.textContent = '';
+                try {
+                    const { changes } = await request(`${base}/${id}/diff`);
+                    showPreview(panel, changes, id);
+                } catch (error) {
+                    status.textContent = `Preview failed: ${error.message}`;
+                }
+            }
+
+            if (restore) {
+                const id = restore.getAttribute('data-revision-restore');
+                status.textContent = 'Restoring…';
+                try {
+                    await request(`${base}/${id}/restore`, { method: 'POST' });
+                    window.location.reload();
+                } catch (error) {
+                    status.textContent = `Restore failed: ${error.message}`;
+                }
+            }
+        });
+
+        request(base)
+            .then(({ revisions }) => {
+                if (! panel.isConnected) return;
+
+                if (revisions.length === 0) {
+                    list.replaceChildren(el('li', {}, ['No revisions yet.']));
+                    return;
+                }
+
+                list.replaceChildren(...revisions.map((revision) => el('li', {
+                    'data-revision-id': String(revision.id),
+                    style: 'display: flex; gap: .75rem; align-items: center; padding: 4px 0;',
+                }, [
+                    el('time', { datetime: revision.created_at }, [new Date(revision.created_at).toLocaleString()]),
+                    el('button', { type: 'button', 'data-revision-preview': String(revision.id) }, ['Preview']),
+                    el('button', { type: 'button', 'data-revision-restore': String(revision.id) }, ['Restore']),
+                ])));
+            })
+            .catch((error) => {
+                if (panel.isConnected) status.textContent = `Could not load revisions: ${error.message}`;
+            });
+
+        return panel;
+    };
+
+    // Statamic renders the CP with Inertia, so the page can change without a reload.
+    // Keep the panel in step with whichever page is showing.
+    const mount = () => {
+        const target = editing();
+        const current = document.querySelector(`[${panelAttr}]`);
+
+        if (! target) {
+            current?.remove();
+            return;
+        }
+
+        const key = `${target.namespace}/${target.handle}`;
+        if (current && current.getAttribute(panelAttr) === key) return;
+
+        current?.remove();
+
+        const host = document.querySelector('#main-content > div');
+        if (host) host.append(buildPanel(target));
+    };
+
+    const start = () => {
+        new MutationObserver(mount).observe(document.body, { childList: true, subtree: true });
+        mount();
+    };
+
+    if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', start);
+    } else {
+        start();
+    }
+})()
