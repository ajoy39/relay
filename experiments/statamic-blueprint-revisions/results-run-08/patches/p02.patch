+<?php
+
+namespace App\Http\Controllers\CP;
+
+use App\Http\Controllers\Controller;
+use App\Models\BlueprintRevision;
+use App\Support\BlueprintContents;
+use Illuminate\Http\JsonResponse;
+use Statamic\Facades\Blueprint;
+
+class BlueprintRevisionController extends Controller
+{
+    public function index(string $namespace, string $handle): JsonResponse
+    {
+        $revisions = BlueprintRevision::forBlueprint($namespace, $handle)
+            ->orderByDesc('id')
+            ->get()
+            ->map(fn (BlueprintRevision $revision) => [
+                'id' => $revision->id,
+                'created_at' => $revision->created_at->toIso8601String(),
+            ]);
+
+        return response()->json(['revisions' => $revisions->values()]);
+    }
+
+    public function diff(string $namespace, string $handle, string $revisionId): JsonResponse
+    {
+        $current = $this->currentContents($namespace, $handle);
+        $restored = $this->revision($namespace, $handle, $revisionId)->data;
+
+        return response()->json([
+            'changes' => BlueprintContents::diff(
+                BlueprintContents::normalize($current),
+                BlueprintContents::normalize($restored),
+            ),
+        ]);
+    }
+
+    public function restore(string $namespace, string $handle, string $revisionId): JsonResponse
+    {
+        $this->currentContents($namespace, $handle);
+        $contents = BlueprintContents::normalize($this->revision($namespace, $handle, $revisionId)->data);
+
+        // Saving through Statamic's own path fires its events, clears its caches,
+        // and records a new revision, so the restore can itself be undone.
+        Blueprint::find("{$namespace}.{$handle}")
+            ->setHidden($contents['hide'] ?? null)
+            ->setOrder($contents['order'] ?? null)
+            ->setContents(array_diff_key($contents, ['hide' => true, 'order' => true]))
+            ->save();
+
+        return response()->json(['restored' => true]);
+    }
+
+    private function currentContents(string $namespace, string $handle): array
+    {
+        $model = app('statamic.eloquent.blueprints.model')::query()
+            ->where('namespace', $namespace)
+            ->where('handle', $handle)
+            ->first();
+
+        abort_if($model === null, 404);
+
+        return $model->data;
+    }
+
+    private function revision(string $namespace, string $handle, string $id): BlueprintRevision
+    {
+        return BlueprintRevision::forBlueprint($namespace, $handle)->findOrFail($id);
+    }
+}
