+<?php
+
+namespace App\Observers;
+
+use App\Models\BlueprintRevision;
+
+class BlueprintRevisionObserver
+{
+    /**
+     * Snapshot the blueprint as it was just saved. Each revision holds the
+     * contents produced by one save, so the newest one matches the current blueprint.
+     */
+    public function saved($blueprint): void
+    {
+        BlueprintRevision::create([
+            'namespace' => $blueprint->namespace,
+            'handle' => $blueprint->handle,
+            'data' => $blueprint->data,
+        ]);
+    }
+}
