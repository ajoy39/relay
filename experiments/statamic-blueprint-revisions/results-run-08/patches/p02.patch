+<?php
+
+namespace App\Support;
+
+class BlueprintContents
+{
+    /**
+     * Strip the __count ordering markers the eloquent driver adds to stored blueprints,
+     * so they never show up as changes.
+     */
+    public static function normalize(array $contents): array
+    {
+        unset($contents['__count']);
+
+        return array_map(
+            fn ($value) => is_array($value) ? static::normalize($value) : $value,
+            $contents,
+        );
+    }
+
+    /**
+     * Changes needed to turn $from into $to, as dot paths with before/after values.
+     * Unchanged values are left out.
+     */
+    public static function diff(array $from, array $to, string $prefix = ''): array
+    {
+        $changes = [];
+
+        foreach (array_unique([...array_keys($from), ...array_keys($to)]) as $key) {
+            $path = $prefix === '' ? (string) $key : $prefix.'.'.$key;
+            $before = $from[$key] ?? null;
+            $after = $to[$key] ?? null;
+
+            if (is_array($before) && is_array($after)) {
+                array_push($changes, ...static::diff($before, $after, $path));
+
+                continue;
+            }
+
+            if (array_key_exists($key, $from) && array_key_exists($key, $to) && $before === $after) {
+                continue;
+            }
+
+            $changes[] = ['path' => $path, 'from' => $before, 'to' => $after];
+        }
+
+        return $changes;
+    }
+}
