diff --git a/resources/js/blueprint-revisions.js b/resources/js/blueprint-revisions.js
new file mode 100644
index 0000000..aee7933
--- /dev/null
+++ b/resources/js/blueprint-revisions.js
@@ -0,0 +1,142 @@
+// Revision history panel for the blueprint edit page. Injected into every CP
+// page by AppServiceProvider; it does nothing unless the URL is a blueprint
+// edit page. Plain DOM, no build step: the CP is an Inertia app, so the panel
+// is added once the page has rendered and re-added if the page re-renders.
+(function () {
+    if (window.blueprintRevisionsLoaded) return;
+    window.blueprintRevisionsLoaded = true;
+
+    var EDIT_PATH = /^\/cp\/fields\/blueprints\/(.+)\/edit\/?$/;
+    var PANEL_ID = 'blueprint-revisions';
+
+    var match = decodeURIComponent(location.pathname).match(EDIT_PATH);
+    if (!match) return;
+
+    var segments = match[1].split('/');
+    var handle = segments.pop();
+    var namespace = segments.join('.');
+    var api = '/cp/blueprint-revisions/' + encodeURIComponent(namespace) + '/' + encodeURIComponent(handle);
+
+    function request(url, options) {
+        options = options || {};
+        var headers = { Accept: 'application/json', 'X-Requested-With': 'XMLHttpRequest' };
+        var xsrf = document.cookie.split('; ').find(function (c) { return c.indexOf('XSRF-TOKEN=') === 0; });
+        if (xsrf) headers['X-XSRF-TOKEN'] = decodeURIComponent(xsrf.split('=')[1]);
+        return fetch(url, { method: options.method || 'GET', headers: headers, credentials: 'same-origin' })
+            .then(function (res) {
+                if (!res.ok) throw new Error('HTTP ' + res.status);
+                return res.json();
+            });
+    }
+
+    function el(tag, text, attrs) {
+        var node = document.createElement(tag);
+        if (text !== undefined && text !== null) node.textContent = text;
+        Object.keys(attrs || {}).forEach(function (key) { node.setAttribute(key, attrs[key]); });
+        return node;
+    }
+
+    function button(label, attrs, onClick) {
+        var node = el('button', label, Object.assign({ type: 'button' }, attrs));
+        node.style.cssText = 'margin-right:.5rem;padding:.25rem .6rem;border:1px solid #cbd5e1;border-radius:.375rem;background:#fff;cursor:pointer;font-size:.8125rem';
+        node.addEventListener('click', onClick);
+        return node;
+    }
+
+    function show(value) {
+        return value === undefined ? 'undefined' : JSON.stringify(value);
+    }
+
+    function renderDiff(container, changes) {
+        container.textContent = '';
+        if (changes.length === 0) {
+            container.appendChild(el('p', 'No differences: restoring this revision would change nothing.'));
+            return;
+        }
+        container.appendChild(el('p', changes.length + (changes.length === 1 ? ' value' : ' values') + ' would change:'));
+        var list = el('ul');
+        changes.forEach(function (change) {
+            var item = el('li');
+            item.appendChild(el('code', change.path));
+            item.appendChild(document.createTextNode(': '));
+            item.appendChild(el('code', show(change.from)));
+            item.appendChild(document.createTextNode(' → '));
+            item.appendChild(el('code', show(change.to)));
+            list.appendChild(item);
+        });
+        container.appendChild(list);
+    }
+
+    function renderRow(list, revision) {
+        var item = el('li', null, { 'data-revision-id': String(revision.id) });
+        item.style.cssText = 'padding:.5rem 0;border-bottom:1px solid #e2e8f0';
+
+        var row = el('div');
+        row.style.cssText = 'display:flex;align-items:center;justify-content:space-between';
+
+        var when = new Date(revision.created_at);
+        row.appendChild(el('span', when.toLocaleString(), { title: revision.created_at }));
+
+        var actions = el('span');
+        var diff = el('div', null, { 'data-revision-diff': String(revision.id) });
+        diff.style.cssText = 'margin-top:.5rem;font-size:.8125rem';
+
+        actions.appendChild(button('Preview', { 'data-revision-preview': String(revision.id) }, function () {
+            diff.textContent = 'Loading…';
+            request(api + '/' + revision.id + '/diff')
+                .then(function (body) { renderDiff(diff, body.changes); })
+                .catch(function () { diff.textContent = 'Could not load the preview.'; });
+        }));
+
+        actions.appendChild(button('Restore', { 'data-revision-restore': String(revision.id) }, function () {
+            var message = 'Restore the blueprint to the revision from ' + when.toLocaleString() + '? The current version is kept in the history.';
+            if (!window.confirm(message)) return;
+            request(api + '/' + revision.id + '/restore', { method: 'POST' })
+                .then(function () { window.location.reload(); })
+                .catch(function () { diff.textContent = 'Restore failed.'; });
+        }));
+
+        row.appendChild(actions);
+        item.appendChild(row);
+        item.appendChild(diff);
+        list.appendChild(item);
+    }
+
+    function render(panel, revisions) {
+        var list = panel.querySelector('[data-revision-list]');
+        list.textContent = '';
+        if (revisions.length === 0) {
+            list.appendChild(el('p', 'No revisions yet. Each save of this blueprint records one.'));
+            return;
+        }
+        var ol = el('ul');
+        ol.style.cssText = 'list-style:none;padding:0;margin:0';
+        revisions.forEach(function (revision) { renderRow(ol, revision); });
+        list.appendChild(ol);
+    }
+
+    function load(panel) {
+        request(api).then(function (body) {
+            render(panel, body.revisions);
+        }).catch(function () {
+            panel.querySelector('[data-revision-list]').textContent = 'Could not load revisions.';
+        });
+    }
+
+    function mount() {
+        if (document.getElementById(PANEL_ID)) return;
+        var host = document.querySelector('main') || document.getElementById('statamic');
+        if (!host) return;
+
+        var panel = el('section', null, { id: PANEL_ID });
+        panel.style.cssText = 'margin:2rem auto;max-width:48rem;padding:1rem 1.25rem;background:#fff;border:1px solid #e2e8f0;border-radius:.5rem';
+        panel.appendChild(el('h2', 'Revisions'));
+        panel.appendChild(el('div', null, { 'data-revision-list': '' }));
+        host.appendChild(panel);
+
+        load(panel);
+    }
+
+    mount();
+    new MutationObserver(mount).observe(document.body, { childList: true, subtree: true });
+})();
