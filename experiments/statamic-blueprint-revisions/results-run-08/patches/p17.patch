+<?php
+
+namespace App\Blueprints;
+
+use App\Models\BlueprintRevision;
+
+/**
+ * Records a revision each time an eloquent-driven blueprint is saved, and
+ * restores a revision by writing its stored contents back over the blueprint.
+ */
+class BlueprintRevisions
+{
+    /**
+     * Snapshot the blueprint's stored contents as a new revision.
+     */
+    public static function record(?string $namespace, string $handle): void
+    {
+        $blueprint = static::blueprintQuery($namespace, $handle)->first();
+
+        if (! $blueprint) {
+            return;
+        }
+
+        BlueprintRevision::create([
+            'namespace' => $namespace ?? '',
+            'handle' => $handle,
+            'data' => $blueprint->data,
+        ]);
+    }
+
+    /**
+     * The blueprint's currently stored contents, or an empty array if it has none.
+     */
+    public static function current(string $namespace, string $handle): array
+    {
+        $blueprint = static::blueprintQuery($namespace, $handle)->first();
+
+        return $blueprint ? (array) $blueprint->data : [];
+    }
+
+    /**
+     * Make the revision's contents the blueprint's stored contents, and record that as a revision of its own.
+     */
+    public static function restore(string $namespace, string $handle, BlueprintRevision $revision): void
+    {
+        $model = app('statamic.eloquent.blueprints.model')::firstOrNew([
+            'namespace' => $namespace ?: null,
+            'handle' => $handle,
+        ]);
+
+        $model->data = $revision->data;
+        $model->save();
+
+        static::record($namespace, $handle);
+    }
+
+    /**
+     * Changes that restoring a revision would make to the current contents, keyed by dot path.
+     */
+    public static function diff(array $current, array $revision): array
+    {
+        $changes = [];
+
+        static::compare(static::withoutSortKeys($current), static::withoutSortKeys($revision), '', $changes);
+
+        return $changes;
+    }
+
+    private static function compare(mixed $from, mixed $to, string $path, array &$changes): void
+    {
+        if ($from === $to) {
+            return;
+        }
+
+        if (is_array($from) && is_array($to)) {
+            foreach (array_unique([...array_keys($from), ...array_keys($to)]) as $key) {
+                static::compare(
+                    $from[$key] ?? null,
+                    $to[$key] ?? null,
+                    $path === '' ? (string) $key : $path.'.'.$key,
+                    $changes,
+                );
+            }
+
+            return;
+        }
+
+        $changes[] = ['path' => $path, 'from' => $from, 'to' => $to];
+    }
+
+    /**
+     * The `__count` keys are the editor's ordering bookkeeping, not blueprint content.
+     */
+    private static function withoutSortKeys(array $data): array
+    {
+        unset($data['__count']);
+
+        foreach ($data as $key => $value) {
+            if (is_array($value)) {
+                $data[$key] = static::withoutSortKeys($value);
+            }
+        }
+
+        return $data;
+    }
+
+    private static function blueprintQuery(?string $namespace, string $handle)
+    {
+        return app('statamic.eloquent.blueprints.model')::query()
+            ->where('namespace', $namespace ?: null)
+            ->where('handle', $handle);
+    }
+}
