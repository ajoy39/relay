+++ b/public/vendor/blueprint-revisions/js/revisions.js
@@ -0,0 +1,204 @@
+// Adds a Revisions section to the blueprint edit page: history, diff preview and restore.
+(function () {
+    const EDIT_PATH = /\/cp\/fields\/blueprints\/(.+)\/([^/]+)\/edit\/?$/;
+    const PANEL_ID = 'blueprint-revisions';
+
+    function target() {
+        const match = window.location.pathname.match(EDIT_PATH);
+
+        if (!match) {
+            return null;
+        }
+
+        // e.g. /cp/fields/blueprints/collections/pages/page/edit => collections.pages / page
+        return {
+            base: `/cp/blueprint-revisions/${match[1].replace(/\//g, '.')}/${match[2]}`,
+            key: `${match[1]}/${match[2]}`,
+        };
+    }
+
+    function xsrfToken() {
+        const cookie = document.cookie.split('; ').find((row) => row.startsWith('XSRF-TOKEN='));
+
+        return cookie ? decodeURIComponent(cookie.split('=')[1]) : '';
+    }
+
+    async function request(url, method = 'GET') {
+        const response = await fetch(url, {
+            method,
+            credentials: 'same-origin',
+            headers: {
+                Accept: 'application/json',
+                'X-XSRF-TOKEN': xsrfToken(),
+            },
+        });
+
+        if (!response.ok) {
+            throw new Error(`Request failed with status ${response.status}`);
+        }
+
+        return response.json();
+    }
+
+    function el(tag, attributes = {}, text = null) {
+        const node = document.createElement(tag);
+
+        Object.entries(attributes).forEach(([name, value]) => node.setAttribute(name, value));
+
+        if (text !== null) {
+            node.textContent = text;
+        }
+
+        return node;
+    }
+
+    function button(label, attributes) {
+        return el('button', { type: 'button', class: 'btn', ...attributes }, label);
+    }
+
+    function formatValue(value) {
+        return value === undefined ? 'undefined' : JSON.stringify(value);
+    }
+
+    function mount() {
+        const mountPoint = target();
+        const existing = document.getElementById(PANEL_ID);
+
+        if (!mountPoint) {
+            existing?.remove();
+            return;
+        }
+
+        if (existing && existing.dataset.blueprint === mountPoint.key) {
+            return;
+        }
+
+        existing?.remove();
+        render(mountPoint);
+    }
+
+    function render({ base, key }) {
+        const panel = el('section', {
+            id: PANEL_ID,
+            'data-blueprint': key,
+            style: 'margin: 2rem auto; max-width: 56rem; padding: 1.5rem; background: #fff; border: 1px solid #e5e7eb; border-radius: 0.5rem;',
+        });
+
+        const heading = el('h2', { style: 'font-size: 1.25rem; font-weight: 600; margin-bottom: 1rem;' }, 'Revisions');
+        const status = el('p', { style: 'color: #6b7280; margin-bottom: 0.75rem;' });
+        const list = el('ul', { style: 'list-style: none; padding: 0; margin: 0;' });
+        const preview = el('div', { style: 'margin-top: 1rem;' });
+
+        panel.append(heading, status, list, preview);
+
+        const anchor = document.querySelector('main') || document.body;
+        anchor.append(panel);
+
+        async function load() {
+            status.textContent = 'Loading revisions…';
+            list.replaceChildren();
+            preview.replaceChildren();
+
+            try {
+                const { revisions } = await request(`${base}`);
+
+                status.textContent = revisions.length ? '' : 'No revisions yet. A revision is recorded each time this blueprint is saved.';
+
+                revisions.forEach((revision) => list.append(row(revision)));
+            } catch (error) {
+                status.textContent = `Could not load revisions: ${error.message}`;
+            }
+        }
+
+        function row(revision) {
+            const id = String(revision.id);
+            const time = el('time', { datetime: revision.created_at, style: 'flex: 1;' }, new Date(revision.created_at).toLocaleString());
+
+            const item = el('li', {
+                'data-revision-id': id,
+                style: 'display: flex; align-items: center; gap: 0.5rem; padding: 0.5rem 0; border-top: 1px solid #f3f4f6;',
+            });
+
+            item.append(
+                time,
+                button('Preview', { 'data-revision-preview': id, onclick: () => showPreview(id) }),
+                button('Restore', { 'data-revision-restore': id, onclick: () => restore(id, revision.created_at) }),
+            );
+
+            return item;
+        }
+
+        async function showPreview(id) {
+            preview.replaceChildren(el('p', {}, 'Loading preview…'));
+
+            try {
+                const { changes } = await request(`${base}/${id}/diff`);
+
+                if (changes.length === 0) {
+                    preview.replaceChildren(el('p', { style: 'color: #6b7280;' }, 'Restoring this revision would change nothing.'));
+
+                    return;
+                }
+
+                const table = el('table', { style: 'width: 100%; border-collapse: collapse; font-size: 0.875rem;' });
+                const head = el('tr');
+
+                ['Field path', 'Current', 'Revision'].forEach((label) => {
+                    head.append(el('th', { style: 'text-align: left; padding: 0.25rem 0.5rem; border-bottom: 1px solid #e5e7eb;' }, label));
+                });
+
+                table.append(head);
+
+                changes.forEach((change) => {
+                    const tr = el('tr');
+                    const cellStyle = 'vertical-align: top; padding: 0.25rem 0.5rem; font-family: monospace; word-break: break-all;';
+
+                    tr.append(
+                        el('td', { style: cellStyle }, change.path),
+                        el('td', { style: cellStyle }, formatValue(change.from)),
+                        el('td', { style: cellStyle }, formatValue(change.to)),
+                    );
+
+                    table.append(tr);
+                });
+
+                preview.replaceChildren(
+                    el('p', { style: 'margin-bottom: 0.5rem;' }, `Restoring revision ${id} would change ${changes.length} ${changes.length === 1 ? 'field' : 'fields'}. Nothing has been applied.`),
+                    table,
+                );
+            } catch (error) {
+                preview.replaceChildren(el('p', { style: 'color: #b91c1c;' }, `Could not load preview: ${error.message}`));
+            }
+        }
+
+        async function restore(id, createdAt) {
+            const when = new Date(createdAt).toLocaleString();
+
+            if (!window.confirm(`Restore the blueprint to the revision from ${when}? This replaces the current contents. The current contents are kept as a revision, so this can be undone.`)) {
+                return;
+            }
+
+            try {
+                await request(`${base}/${id}/restore`, 'POST');
+                window.location.reload();
+            } catch (error) {
+                window.alert(`Restore failed: ${error.message}`);
+            }
+        }
+
+        load();
+    }
+
+    function start() {
+        mount();
+
+        // Inertia swaps pages without a full load, so keep the section in step with the URL and DOM.
+        new MutationObserver(() => mount()).observe(document.body, { childList: true, subtree: true });
+    }
+
+    if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', start);
+    } else {
+        start();
+    }
+})();
