+<?php
+
+namespace App\Blueprints;
+
+use App\Models\BlueprintRevision;
+use Statamic\Eloquent\Fields\BlueprintModel;
+
+class BlueprintRevisions
+{
+    public function record(BlueprintModel $blueprint): void
+    {
+        BlueprintRevision::create([
+            'namespace' => $blueprint->namespace,
+            'handle' => $blueprint->handle,
+            'data' => $blueprint->data,
+        ]);
+    }
+
+    public function current(string $namespace, string $handle): ?BlueprintModel
+    {
+        return BlueprintModel::where('namespace', $namespace)
+            ->where('handle', $handle)
+            ->first();
+    }
+
+    public function history(string $namespace, string $handle)
+    {
+        return BlueprintRevision::where('namespace', $namespace)
+            ->where('handle', $handle)
+            ->orderByDesc('id')
+            ->get();
+    }
+
+    public function find(string $namespace, string $handle, int|string $id): BlueprintRevision
+    {
+        return BlueprintRevision::where('namespace', $namespace)
+            ->where('handle', $handle)
+            ->findOrFail($id);
+    }
+
+    /**
+     * Changes that restoring $revision would make to the current blueprint.
+     */
+    public function diff(BlueprintModel $current, BlueprintRevision $revision): array
+    {
+        $from = $this->flatten($this->withoutOrderMarkers($current->data));
+        $to = $this->flatten($this->withoutOrderMarkers($revision->data));
+
+        $changes = [];
+
+        foreach (array_unique([...array_keys($from), ...array_keys($to)]) as $path) {
+            $fromValue = $from[$path] ?? null;
+            $toValue = $to[$path] ?? null;
+
+            if ($fromValue === $toValue) {
+                continue;
+            }
+
+            $changes[] = [
+                'path' => $path,
+                'from' => $fromValue,
+                'to' => $toValue,
+            ];
+        }
+
+        return $changes;
+    }
+
+    /**
+     * Writes the revision's contents back onto the blueprint. The save goes
+     * through the model, so the saved listener records the restore as a
+     * revision of its own and it can be undone the same way.
+     */
+    public function restore(BlueprintModel $current, BlueprintRevision $revision): void
+    {
+        $current->data = $revision->data;
+        $current->save();
+    }
+
+    private function withoutOrderMarkers($value)
+    {
+        if (! is_array($value)) {
+            return $value;
+        }
+
+        unset($value['__count']);
+
+        return array_map(fn ($item) => $this->withoutOrderMarkers($item), $value);
+    }
+
+    /**
+     * Flattens nested data into dot-path => leaf value. Empty arrays are leaves.
+     */
+    private function flatten($value, string $prefix = '', array $out = []): array
+    {
+        if (! is_array($value) || $value === []) {
+            if ($prefix !== '') {
+                $out[$prefix] = $value;
+            }
+
+            return $out;
+        }
+
+        foreach ($value as $key => $item) {
+            $path = $prefix === '' ? (string) $key : $prefix.'.'.$key;
+            $out = $this->flatten($item, $path, $out);
+        }
+
+        return $out;
+    }
+}
