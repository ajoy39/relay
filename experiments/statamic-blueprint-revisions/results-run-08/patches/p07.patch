@@ -0,0 +1,159 @@
+<?php
+
+namespace Tests\Feature;
+
+use App\Models\BlueprintRevision;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Statamic\Eloquent\Fields\BlueprintModel;
+use Statamic\Facades\Blueprint;
+use Statamic\Facades\User;
+use Tests\TestCase;
+
+class BlueprintRevisionTest extends TestCase
+{
+    use RefreshDatabase;
+
+    private const BASE = '/cp/blueprint-revisions/collections.pages/page';
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+
+        $editor = User::make()->email('editor@example.com');
+        $editor->set('name', 'Editor');
+        $editor->makeSuper();
+        $editor->save();
+
+        $this->actingAs($editor);
+    }
+
+    private function saveBlueprint(array $fields): void
+    {
+        $fieldsDefinition = collect($fields)->map(fn ($type, $handle) => [
+            'handle' => $handle,
+            'field' => ['type' => $type, 'display' => ucfirst($handle)],
+        ])->values()->all();
+
+        Blueprint::make()
+            ->setHandle('page')
+            ->setNamespace('collections.pages')
+            ->setContents([
+                'title' => 'Page',
+                'tabs' => [
+                    'main' => [
+                        'display' => 'Main',
+                        'sections' => [['fields' => $fieldsDefinition]],
+                    ],
+                ],
+            ])
+            ->save();
+    }
+
+    public function test_each_save_records_a_revision_newest_first(): void
+    {
+        $this->saveBlueprint(['title' => 'text']);
+        $this->saveBlueprint(['title' => 'text', 'body' => 'markdown']);
+
+        $response = $this->getJson(self::BASE)->assertOk();
+
+        $revisions = $response->json('revisions');
+        $this->assertCount(2, $revisions);
+        $this->assertGreaterThan($revisions[1]['id'], $revisions[0]['id']);
+        $this->assertArrayHasKey('created_at', $revisions[0]);
+    }
+
+    public function test_history_is_empty_without_saves(): void
+    {
+        $this->getJson(self::BASE)
+            ->assertOk()
+            ->assertExactJson(['revisions' => []]);
+    }
+
+    public function test_diff_describes_what_restoring_would_change(): void
+    {
+        $this->saveBlueprint(['title' => 'text']);
+        $this->saveBlueprint(['title' => 'text', 'body' => 'markdown']);
+
+        $oldest = BlueprintRevision::orderBy('id')->first();
+
+        $changes = $this->getJson(self::BASE.'/'.$oldest->id.'/diff')
+            ->assertOk()
+            ->json('changes');
+
+        $paths = collect($changes)->pluck('path')->all();
+
+        $this->assertContains('tabs.main.sections.0.fields.1.handle', $paths);
+        $this->assertNotContains('title', $paths);
+        $this->assertNotContains('tabs.main.sections.0.fields.0.field.type', $paths);
+        $this->assertFalse(collect($changes)->contains(fn ($change) => str_ends_with($change['path'], '__count')));
+    }
+
+    public function test_identical_revision_yields_no_changes(): void
+    {
+        $this->saveBlueprint(['title' => 'text']);
+
+        $latest = BlueprintRevision::orderByDesc('id')->first();
+
+        $this->getJson(self::BASE.'/'.$latest->id.'/diff')
+            ->assertOk()
+            ->assertExactJson(['changes' => []]);
+    }
+
+    public function test_restore_changes_contents_and_is_itself_revertible(): void
+    {
+        $this->saveBlueprint(['title' => 'text']);
+        $this->saveBlueprint(['title' => 'text', 'body' => 'markdown']);
+
+        $original = BlueprintRevision::orderBy('id')->first();
+
+        $this->postJson(self::BASE.'/'.$original->id.'/restore')
+            ->assertOk()
+            ->assertExactJson(['restored' => true]);
+
+        $stored = BlueprintModel::where('namespace', 'collections.pages')->where('handle', 'page')->first();
+        $this->assertCount(1, $stored->data['tabs']['main']['sections'][0]['fields']);
+
+        // The restore itself was recorded, so there are now three revisions and the newest matches the original.
+        $this->assertSame(3, BlueprintRevision::count());
+        $this->getJson(self::BASE.'/'.BlueprintRevision::max('id').'/diff')
+            ->assertOk()
+            ->assertExactJson(['changes' => []]);
+
+        // Restoring the pre-restore state undoes the restore.
+        $this->postJson(self::BASE.'/'.BlueprintRevision::orderByDesc('id')->skip(1)->first()->id.'/restore')
+            ->assertOk();
+
+        $stored = BlueprintModel::where('namespace', 'collections.pages')->where('handle', 'page')->first();
+        $this->assertCount(2, $stored->data['tabs']['main']['sections'][0]['fields']);
+    }
+
+    public function test_revisions_are_scoped_to_their_blueprint(): void
+    {
+        $this->saveBlueprint(['title' => 'text']);
+        $revision = BlueprintRevision::first();
+
+        $this->getJson('/cp/blueprint-revisions/collections.articles/article/'.$revision->id.'/diff')
+            ->assertNotFound();
+    }
+
+    public function test_blueprint_edit_page_loads_the_revisions_script(): void
+    {
+        $this->saveBlueprint(['title' => 'text']);
+
+        $this->get('/cp/fields/blueprints/collections/pages/page/edit')
+            ->assertOk()
+            ->assertSee('blueprint-revisions', false);
+    }
+
+    public function test_unauthenticated_requests_are_rejected(): void
+    {
+        $this->saveBlueprint(['title' => 'text']);
+        $revision = BlueprintRevision::first();
+
+        $this->app['auth']->forgetGuards();
+
+        $this->getJson(self::BASE)->assertStatus(401);
+        $this->getJson(self::BASE.'/'.$revision->id.'/diff')->assertStatus(401);
+        $this->postJson(self::BASE.'/'.$revision->id.'/restore')->assertStatus(401);
+    }
+}
