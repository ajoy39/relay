+<?php
+
+namespace App\Http\Controllers;
+
+use App\Blueprints\BlueprintRevisions;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Routing\Controller;
+
+class BlueprintRevisionController extends Controller
+{
+    public function __construct(private BlueprintRevisions $revisions) {}
+
+    public function index(string $namespace, string $handle): JsonResponse
+    {
+        $revisions = $this->revisions->history($namespace, $handle)->map(fn ($revision) => [
+            'id' => $revision->id,
+            'created_at' => $revision->created_at->toIso8601String(),
+        ]);
+
+        return response()->json(['revisions' => $revisions->values()]);
+    }
+
+    public function diff(string $namespace, string $handle, int $id): JsonResponse
+    {
+        $current = $this->current($namespace, $handle);
+        $revision = $this->revisions->find($namespace, $handle, $id);
+
+        return response()->json([
+            'changes' => $this->revisions->diff($current, $revision),
+        ]);
+    }
+
+    public function restore(string $namespace, string $handle, int $id): JsonResponse
+    {
+        $current = $this->current($namespace, $handle);
+        $revision = $this->revisions->find($namespace, $handle, $id);
+
+        $this->revisions->restore($current, $revision);
+
+        return response()->json(['restored' => true]);
+    }
+
+    private function current(string $namespace, string $handle)
+    {
+        return $this->revisions->current($namespace, $handle)
+            ?? abort(404, 'Blueprint not found.');
+    }
+}
