+<?php
+
+namespace App\Providers;
+
+use App\Models\BlueprintRevision;
+use Illuminate\Support\ServiceProvider;
+use Statamic\Events\BlueprintSaved;
+
+class BlueprintRevisionProvider extends ServiceProvider
+{
+    public function register(): void
+    {
+    }
+
+    public function boot(): void
+    {
+        $this->listenForBlueprintSaves();
+    }
+
+    private function listenForBlueprintSaves(): void
+    {
+        \Event::listen(BlueprintSaved::class, function (BlueprintSaved $event) {
+            $blueprint = $event->blueprint;
+            $namespace = $blueprint->namespace();
+            $handle = $blueprint->handle();
+
+            $data = $blueprint->contents();
+
+            BlueprintRevision::recordRevision($namespace, $handle, $data);
+        });
+    }
+}
