+<?php
+
+namespace App\Models;
+
+use Illuminate\Database\Eloquent\Model;
+
+class BlueprintRevision extends Model
+{
+    protected $table = 'blueprint_revisions';
+
+    protected $fillable = ['namespace', 'handle', 'data'];
+
+    protected $casts = [
+        'data' => 'array',
+    ];
+
+    public static function recordRevision($namespace, $handle, $data)
+    {
+        return self::create([
+            'namespace' => $namespace,
+            'handle' => $handle,
+            'data' => $data,
+        ]);
+    }
+
+    public static function getRevisions($namespace, $handle)
+    {
+        return self::where('namespace', $namespace)
+            ->where('handle', $handle)
+            ->orderBy('created_at', 'desc')
+            ->get();
+    }
+}
