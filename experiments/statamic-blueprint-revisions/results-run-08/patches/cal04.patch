+<?php
+
+namespace App\Http\Middleware;
+
+use App\Models\BlueprintRevision;
+use Closure;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+
+class InjectBlueprintRevisions
+{
+    public function handle(Request $request, Closure $next): Response
+    {
+        $response = $next($request);
+
+        try {
+            if ($this->shouldInjectRevisions($request, $response)) {
+                $response = $this->injectRevisions($request, $response);
+            }
+        } catch (\Exception $e) {
+            // Silently fail - don't break the response
+        }
+
+        return $response;
+    }
+
+    private function shouldInjectRevisions(Request $request, Response $response): bool
+    {
+        if (!$response->isSuccessful()) {
+            return false;
+        }
+
+        $contentType = $response->headers->get('Content-Type', '');
+        if (!str_contains($contentType, 'text/html')) {
+            return false;
+        }
+
+        if (!preg_match('~/cp/fields/blueprints/(.+)/([^/]+)/edit$~', $request->getPathInfo())) {
+            return false;
+        }
+
+        return true;
+    }
+
+    private function injectRevisions(Request $request, Response $response): Response
+    {
+        if (!preg_match('~/cp/fields/blueprints/(.+)/([^/]+)/edit$~', $request->getPathInfo(), $matches)) {
+            return $response;
+        }
+
+        $namespace = str_replace('/', '.', $matches[1]);
+        $handle = $matches[2];
+
+        $revisions = BlueprintRevision::getRevisions($namespace, $handle);
+
+        $html = $response->getContent();
+
+        $revisionsHtml = $this->generateRevisionsHtml($namespace, $handle, $revisions);
+
+        if (str_contains($html, '</body>')) {
+            $html = str_replace('</body>', $revisionsHtml . "\n</body>", $html);
+        } elseif (str_contains($html, '</html>')) {
+            $html = str_replace('</html>', $revisionsHtml . "\n</html>", $html);
+        } else {
+            $html .= $revisionsHtml;
+        }
+
+        $response->setContent($html);
+
+        return $response;
+    }
+
+    private function generateRevisionsHtml($namespace, $handle, $revisions): string
+    {
+        $html = '<section id="blueprint-revisions" style="margin-top: 2rem; padding: 1.5rem; border: 1px solid #e5e7eb; border-radius: 0.5rem;">';
+        $html .= '<h3 style="margin: 0 0 1rem 0; font-size: 1.125rem; font-weight: 600;">Revisions</h3>';
+
+        if ($revisions->isEmpty()) {
+            $html .= '<p style="margin: 0; color: #6b7280;">No revisions yet.</p>';
+        } else {
+            $html .= '<div style="space-y: 0.5rem;">';
+            foreach ($revisions as $revision) {
+                $html .= '<div data-revision-id="' . htmlspecialchars($revision->id) . '" style="padding: 0.75rem; border-bottom: 1px solid #e5e7eb; display: flex; justify-content: space-between; align-items: center;">';
+                $html .= '<span style="color: #374151;">' . htmlspecialchars($revision->created_at->format('Y-m-d H:i:s')) . '</span>';
+                $html .= '<div>';
+                $html .= '<button data-revision-preview="' . htmlspecialchars($revision->id) . '" type="button" style="margin-right: 0.5rem; padding: 0.375rem 0.75rem; background-color: #3b82f6; color: white; border: none; border-radius: 0.25rem; cursor: pointer;">Preview</button>';
+                $html .= '<button data-revision-restore="' . htmlspecialchars($revision->id) . '" type="button" style="padding: 0.375rem 0.75rem; background-color: #10b981; color: white; border: none; border-radius: 0.25rem; cursor: pointer;">Restore</button>';
+                $html .= '</div>';
+                $html .= '</div>';
+            }
+            $html .= '</div>';
+        }
+
+        $html .= '</section>';
+
+        $escapedNamespace = htmlspecialchars($namespace);
+        $escapedHandle = htmlspecialchars($handle);
+
+        $html .= '<script>';
+        $html .= "const __BLUEPRINT_REVISIONS_API_BASE = '/cp/blueprint-revisions/{$escapedNamespace}/{$escapedHandle}';";
+        $html .= '
+(function() {
+    const API_BASE = __BLUEPRINT_REVISIONS_API_BASE;
+
+    document.addEventListener("click", function(e) {
+        if (e.target.hasAttribute("data-revision-preview")) {
+            const id = e.target.getAttribute("data-revision-preview");
+            fetch(API_BASE + "/" + id + "/diff")
+                .then(r => r.json())
+                .then(data => {
+                    alert("Changes:\n" + JSON.stringify(data.changes, null, 2));
+                });
+            e.preventDefault();
+        }
+        if (e.target.hasAttribute("data-revision-restore")) {
+            const id = e.target.getAttribute("data-revision-restore");
+            if (confirm("Restore this revision?")) {
+                fetch(API_BASE + "/" + id + "/restore", {
+                    method: "POST",
+                    headers: {
+                        "X-CSRF-TOKEN": document.querySelector("meta[name=\"csrf-token\"]")?.content || "",
+                        "Content-Type": "application/json"
+                    }
+                })
+                .then(r => r.json())
+                .then(data => {
+                    if (data.restored) {
+                        location.reload();
+                    }
+                });
+            }
+            e.preventDefault();
+        }
+    });
+})();';
+        $html .= '</script>';
+
+        return $html;
+    }
+}
