+<?php
+
+namespace App\Http\Controllers;
+
+use App\Models\BlueprintRevision;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+
+class BlueprintRevisionsController extends Controller
+{
+    public function list($namespace, $handle): JsonResponse
+    {
+        $revisions = BlueprintRevision::getRevisions($namespace, $handle);
+
+        return response()->json([
+            'revisions' => $revisions->map(fn($r) => [
+                'id' => $r->id,
+                'created_at' => $r->created_at->toIso8601String(),
+            ])->toArray(),
+        ]);
+    }
+
+    public function diff($namespace, $handle, $id): JsonResponse
+    {
+        $revision = BlueprintRevision::where('id', $id)
+            ->where('namespace', $namespace)
+            ->where('handle', $handle)
+            ->firstOrFail();
+
+        $current = \DB::table('blueprints')
+            ->where('namespace', $namespace)
+            ->where('handle', $handle)
+            ->first();
+
+        $currentData = $current ? (is_string($current->data) ? json_decode($current->data, true) : $current->data) : [];
+        $revisionData = is_array($revision->data) ? $revision->data : json_decode($revision->data, true);
+
+        $changes = $this->calculateDiff($currentData, $revisionData);
+
+        return response()->json([
+            'changes' => $changes,
+        ]);
+    }
+
+    public function restore($namespace, $handle, $id): JsonResponse
+    {
+        $revision = BlueprintRevision::where('id', $id)
+            ->where('namespace', $namespace)
+            ->where('handle', $handle)
+            ->firstOrFail();
+
+        $blueprintId = $namespace ? "{$namespace}::{$handle}" : $handle;
+        $blueprint = \Statamic\Facades\Blueprint::find($blueprintId);
+
+        if ($blueprint) {
+            $blueprint->setContents($revision->data);
+            $blueprint->save();
+        }
+
+        return response()->json(['restored' => true]);
+    }
+
+    private function calculateDiff($from, $to, $prefix = ''): array
+    {
+        $changes = [];
+        $from = $from ?? [];
+        $to = $to ?? [];
+
+        $allKeys = array_unique(array_merge(array_keys((array)$from), array_keys((array)$to)));
+
+        foreach ($allKeys as $key) {
+            $currentPath = $prefix ? "{$prefix}.{$key}" : $key;
+            $fromValue = $from[$key] ?? null;
+            $toValue = $to[$key] ?? null;
+
+            if (is_array($fromValue) && is_array($toValue)) {
+                $nestedChanges = $this->calculateDiff($fromValue, $toValue, $currentPath);
+                $changes = array_merge($changes, $nestedChanges);
+            } elseif (json_encode($fromValue) !== json_encode($toValue)) {
+                $changes[] = [
+                    'path' => $currentPath,
+                    'from' => $fromValue,
+                    'to' => $toValue,
+                ];
+            }
+        }
+
+        return $changes;
+    }
+}
