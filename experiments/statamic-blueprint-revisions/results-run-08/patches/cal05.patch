+<?php
+
+namespace App\Http\Middleware;
+
+use Closure;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+
+class InjectBlueprintRevisionsScript
+{
+    public function handle(Request $request, Closure $next): Response
+    {
+        $response = $next($request);
+
+        if (!$this->shouldInjectScript($request, $response)) {
+            return $response;
+        }
+
+        if ($response->headers->get('content-type') && str_contains($response->headers->get('content-type'), 'text/html')) {
+            $content = $response->getContent();
+
+            // Inject the script inline before closing body tag
+            $scriptPath = base_path('resources/js/blueprint-revisions.js');
+            if (file_exists($scriptPath)) {
+                $scriptContent = file_get_contents($scriptPath);
+                $script = "<script>" . $scriptContent . "</script>";
+                $content = str_replace('</body>', $script . "\n</body>", $content);
+                $response->setContent($content);
+            }
+        }
+
+        return $response;
+    }
+
+    protected function shouldInjectScript(Request $request, Response $response): bool
+    {
+        // Only inject on CP blueprint edit pages
+        if (!$request->is('cp/*')) {
+            return false;
+        }
+
+        if (!$request->is('*/blueprints/*/*/edit') && !$request->is('cp/fields/blueprints/*/*/edit')) {
+            return false;
+        }
+
+        return $response->getStatusCode() === 200;
+    }
+}
