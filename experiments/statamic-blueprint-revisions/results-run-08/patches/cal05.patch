+    public function up()
+    {
+        // Create initial revisions for all blueprints that don't have any revisions
+        // This ensures that the revision history is available even if the blueprint save event isn't properly hooked
+
+        try {
+            $blueprintTable = $this->prefix('blueprints');
+            $revisionTable = $this->prefix('blueprint_revisions');
+
+            // Get all blueprints that don't have any revisions
+            $blueprints = DB::table($blueprintTable)->get();
+
+            foreach ($blueprints as $blueprint) {
+                $existingRevisions = DB::table($revisionTable)
+                    ->where('handle', $blueprint->handle)
+                    ->where('namespace', $blueprint->namespace)
+                    ->count();
+
+                // If no revisions exist, create one
+                if ($existingRevisions === 0) {
+                    DB::table($revisionTable)->insert([
+                        'handle' => $blueprint->handle,
+                        'namespace' => $blueprint->namespace,
+                        'data' => $blueprint->data,
+                        'created_at' => $blueprint->created_at,
+                        'updated_at' => $blueprint->updated_at,
+                    ]);
+                }
+            }
+        } catch (\Exception $e) {
