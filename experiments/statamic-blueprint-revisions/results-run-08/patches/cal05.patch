@@ -0,0 +1,141 @@
+document.addEventListener('DOMContentLoaded', async () => {
+  // Wait for the page to be fully loaded
+  await new Promise(resolve => setTimeout(resolve, 100));
+
+  const path = window.location.pathname;
+  const match = path.match(/\/cp\/fields\/blueprints\/(.+?)\/(.+?)\/edit/);
+
+  if (!match) return;
+
+  const [, namespace, handle] = match;
+  const apiUrl = `/cp/blueprint-revisions/${namespace}/${handle}`;
+
+  try {
+    const response = await fetch(apiUrl);
+    if (!response.ok) return;
+
+    const data = await response.json();
+    if (!data.revisions || data.revisions.length === 0) return;
+
+    // Find a good place to inject the revisions UI
+    let container = document.querySelector('[data-blueprint-edit-container]') ||
+                   document.querySelector('.statamic-container') ||
+                   document.querySelector('main') ||
+                   document.body;
+
+    if (!container) return;
+
+    // Create the revisions section
+    const section = document.createElement('div');
+    section.className = 'revision-history-section';
+    section.innerHTML = `
+      <div style="margin-top: 40px; padding: 20px; border: 1px solid #e5e7eb; border-radius: 8px; background-color: #f9fafb;">
+        <h2 style="margin: 0 0 20px 0; font-size: 18px; font-weight: 600;">Revisions</h2>
+        <div style="overflow-x: auto;">
+          <table style="width: 100%; border-collapse: collapse; font-size: 14px;">
+            <thead>
+              <tr style="border-bottom: 2px solid #d1d5db;">
+                <th style="text-align: left; padding: 12px; font-weight: 600;">Date</th>
+                <th style="text-align: right; padding: 12px; font-weight: 600;">Actions</th>
+              </tr>
+            </thead>
+            <tbody>
+              ${data.revisions.map((rev, index) => `
+                <tr data-revision-id="${rev.id}" style="border-bottom: 1px solid #e5e7eb; hover: {background-color: #f3f4f6;}">
+                  <td style="padding: 12px;">
+                    ${new Date(rev.created_at).toLocaleString()}
+                  </td>
+                  <td style="text-align: right; padding: 12px;">
+                    <button data-revision-preview="${rev.id}" style="margin-right: 8px; padding: 6px 12px; background-color: #3b82f6; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 12px;">Preview</button>
+                    <button data-revision-restore="${rev.id}" style="padding: 6px 12px; background-color: #10b981; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 12px;">Restore</button>
+                  </td>
+                </tr>
+              `).join('')}
+            </tbody>
+          </table>
+        </div>
+      </div>
+    `;
+
+    // Insert the section before closing main or at the end of body
+    if (container === document.body) {
+      container.appendChild(section);
+    } else {
+      container.appendChild(section);
+    }
+
+    // Add event listeners for preview and restore buttons
+    document.querySelectorAll('[data-revision-preview]').forEach(btn => {
+      btn.addEventListener('click', async (e) => {
+        e.preventDefault();
+        const revisionId = btn.getAttribute('data-revision-preview');
+        const diffUrl = `${apiUrl}/${revisionId}/diff`;
+
+        try {
+          const response = await fetch(diffUrl);
+          const diffData = await response.json();
+
+          // Show diff in a modal or panel
+          const diffText = diffData.changes.length === 0
+            ? 'No changes (identical to current blueprint)'
+            : diffData.changes.map(c => `${c.path}: ${JSON.stringify(c.from)} → ${JSON.stringify(c.to)}`).join('\n');
+
+          alert('Changes that would be made:\n\n' + diffText);
+        } catch (err) {
+          alert('Error loading diff: ' + err.message);
+        }
+      });
+    });
+
+    document.querySelectorAll('[data-revision-restore]').forEach(btn => {
+      btn.addEventListener('click', async (e) => {
+        e.preventDefault();
+        const revisionId = btn.getAttribute('data-revision-restore');
+        const restoreUrl = `${apiUrl}/${revisionId}/restore`;
+
+        if (!confirm('Are you sure you want to restore this revision?')) return;
+
+        try {
+          const headers = {
+            'Content-Type': 'application/json',
+            'X-Requested-With': 'XMLHttpRequest',
+          };
+
+          // Add CSRF token if available
+          const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
+          if (csrfToken) {
+            headers['X-CSRF-TOKEN'] = csrfToken;
+          }
+
+          // Try to get from cookies too
+          const cookies = document.cookie.split(';');
+          const xsrfCookie = cookies.find(c => c.includes('XSRF-TOKEN'));
+          if (xsrfCookie) {
+            const value = xsrfCookie.split('=')[1];
+            headers['X-XSRF-TOKEN'] = decodeURIComponent(value);
+          }
+
+          const response = await fetch(restoreUrl, {
+            method: 'POST',
+            headers: headers,
+          });
+
+          if (response.ok) {
+            const result = await response.json();
+            if (result.restored) {
+              alert('Blueprint restored successfully!');
+              window.location.reload();
+            }
+          } else {
+            alert('Error restoring blueprint: ' + response.status);
+          }
+        } catch (err) {
+          alert('Error restoring blueprint: ' + err.message);
+        }
+      });
+    });
+
+  } catch (err) {
+    console.error('Error loading revisions:', err);
+  }
+});
