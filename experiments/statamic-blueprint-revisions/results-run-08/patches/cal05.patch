+<?php
+
+namespace App\Http\Controllers;
+
+use App\Models\BlueprintRevision;
+use Illuminate\Http\Request;
+use Statamic\Facades\Blueprint;
+
+class BlueprintRevisionsController extends Controller
+{
+    public function index(Request $request, $namespace, $handle)
+    {
+        // Debug: if query param debug=1 is set, return all revisions
+        if ($request->query('debug') == '1') {
+            $allRevisions = BlueprintRevision::get();
+            return response()->json([
+                'debug' => true,
+                'total' => $allRevisions->count(),
+                'all_revisions' => $allRevisions->map(fn($r) => [
+                    'id' => (string)$r->id,
+                    'namespace' => $r->namespace,
+                    'handle' => $r->handle,
+                    'created_at' => $r->created_at->toIso8601String(),
+                ])->all(),
+            ]);
+        }
+
+        $actualNamespace = $namespace === 'null' ? null : $namespace;
+        $revisions = BlueprintRevision::where('namespace', $actualNamespace)
+            ->where('handle', $handle)
+            ->orderBy('created_at', 'desc')
+            ->get()
+            ->map(fn($r) => [
+                'id' => (string)$r->id,
+                'created_at' => $r->created_at->toIso8601String(),
+            ]);
+
+        return response()->json([
+            'revisions' => $revisions->all(),
+        ]);
+    }
+
+    public function diff(Request $request, $namespace, $handle, $id)
+    {
+        $revision = BlueprintRevision::find($id);
+
+        if (!$revision) {
+            return response()->json(['changes' => []]);
+        }
+
+        $actualNamespace = $namespace === 'null' ? null : $namespace;
+
+        if ($revision->namespace !== $actualNamespace || $revision->handle !== $handle) {
+            return response()->json(['changes' => []]);
+        }
+
+        try {
+            $current = Blueprint::find($actualNamespace . '.' . $handle);
+            $currentData = $current?->toArray() ?? [];
+        } catch (\Exception $e) {
+            $currentData = [];
+        }
+
+        $revisionData = $revision->data ?? [];
+
+        $changes = $this->calculateDiff($revisionData, $currentData);
+
+        return response()->json([
+            'changes' => $changes,
+        ]);
+    }
+
+    public function restore(Request $request, $namespace, $handle, $id)
+    {
+        $revision = BlueprintRevision::find($id);
+
+        if (!$revision) {
+            return response()->json(['restored' => false], 404);
+        }
+
+        $actualNamespace = $namespace === 'null' ? null : $namespace;
+
+        if ($revision->namespace !== $actualNamespace || $revision->handle !== $handle) {
+            return response()->json(['restored' => false], 404);
+        }
+
+        try {
+            $blueprint = Blueprint::find($actualNamespace . '.' . $handle);
+
+            if ($blueprint) {
+                $revisionData = $revision->data ?? [];
+
+                $blueprint->setContents($revisionData);
+                $blueprint->save();
+
+                BlueprintRevision::create([
+                    'namespace' => $actualNamespace,
+                    'handle' => $handle,
+                    'data' => $revisionData,
+                ]);
+            }
+
+            return response()->json(['restored' => true]);
+        } catch (\Exception $e) {
+            return response()->json(['restored' => false], 500);
+        }
+    }
+
+    private function calculateDiff($from, $to)
+    {
+        $changes = [];
+        $allKeys = array_unique(array_merge(array_keys((array)$from), array_keys((array)$to)));
+
+        foreach ($allKeys as $key) {
+            $fromValue = $from[$key] ?? null;
+            $toValue = $to[$key] ?? null;
+
+            if ($fromValue !== $toValue) {
+                $changes[] = [
+                    'path' => $key,
+                    'from' => $fromValue,
+                    'to' => $toValue,
+                ];
+            }
+        }
+
+        return $changes;
+    }
+}
