+<?php
+
+namespace App\Models;
+
+use Illuminate\Database\Eloquent\Model;
+
+class BlueprintRevision extends Model
+{
+    protected $fillable = ['namespace', 'handle', 'data'];
+
+    protected $casts = [
+        'data' => 'json',
+        'created_at' => 'datetime',
+        'updated_at' => 'datetime',
+    ];
+
+    public function getTable()
+    {
+        return config('statamic.eloquent-driver.table_prefix') . 'blueprint_revisions';
+    }
+}
