+<?php
+
+namespace App\Observers;
+
+use App\Models\BlueprintRevision;
+use Statamic\Eloquent\Fields\BlueprintModel;
+use Illuminate\Support\Carbon;
+
+class BlueprintModelObserver
+{
+    public function saved(BlueprintModel $blueprint)
+    {
+        // Get the namespace and handle from the model
+        $namespace = $blueprint->namespace;
+        $handle = $blueprint->handle;
+        $data = $blueprint->data ?? [];
+
+        // Skip if data is empty (shouldn't happen, but just in case)
+        if (empty($data) || !$handle) {
+            return;
+        }
+
+        try {
+            // Check if a revision was already created in the last 2 seconds (to avoid duplicates from the event listener)
+            $recentRevision = BlueprintRevision::where('namespace', $namespace)
+                ->where('handle', $handle)
+                ->where('created_at', '>=', Carbon::now()->subSeconds(2))
+                ->first();
+
+            // Only create if no recent revision exists
+            if (!$recentRevision) {
+                BlueprintRevision::create([
+                    'namespace' => $namespace,
+                    'handle' => $handle,
+                    'data' => $data,
+                ]);
+            }
+        } catch (\Exception $e) {
+            // Silently fail - don't break blueprint saves
+        }
+    }
+}
