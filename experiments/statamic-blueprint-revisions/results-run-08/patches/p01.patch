+<?php
+
+namespace App\Blueprints;
+
+use App\Models\BlueprintRevision;
+use Illuminate\Database\Eloquent\Model;
+
+class BlueprintHistory
+{
+    /**
+     * Record the blueprint's stored data as a revision, unless it matches the latest one.
+     */
+    public static function record(Model $blueprint): ?BlueprintRevision
+    {
+        $namespace = $blueprint->getAttributeValue('namespace');
+        $handle = $blueprint->getAttributeValue('handle');
+        $data = $blueprint->getAttributeValue('data');
+
+        $latest = BlueprintRevision::ofBlueprint($namespace, $handle)->latest('id')->first();
+
+        if ($latest && static::normalize($latest->data) == static::normalize($data)) {
+            return null;
+        }
+
+        return BlueprintRevision::create([
+            'namespace' => $namespace,
+            'handle' => $handle,
+            'data' => $data,
+        ]);
+    }
+
+    /**
+     * The blueprint's currently stored data, or an empty array if it has none.
+     */
+    public static function current(?string $namespace, string $handle): array
+    {
+        return static::model()::query()
+            ->when(
+                $namespace === null,
+                fn ($query) => $query->whereNull('namespace'),
+                fn ($query) => $query->where('namespace', $namespace),
+            )
+            ->where('handle', $handle)
+            ->first()
+            ?->getAttributeValue('data') ?? [];
+    }
+
+    /**
+     * Blueprint data without the editor's ordering markers, so that only real content differences count.
+     */
+    public static function normalize(mixed $value): mixed
+    {
+        if (! is_array($value)) {
+            return $value;
+        }
+
+        unset($value['__count']);
+
+        return array_map(fn ($item) => static::normalize($item), $value);
+    }
+
+    /**
+     * Changes that restoring $revision over $current would make, keyed by dot path.
+     */
+    public static function changes(array $current, array $revision): array
+    {
+        $from = static::flatten(static::normalize($current));
+        $to = static::flatten(static::normalize($revision));
+
+        $changes = [];
+
+        foreach (array_unique([...array_keys($from), ...array_keys($to)]) as $path) {
+            $before = $from[$path] ?? null;
+            $after = $to[$path] ?? null;
+
+            if ($before !== $after) {
+                $changes[] = ['path' => (string) $path, 'from' => $before, 'to' => $after];
+            }
+        }
+
+        return $changes;
+    }
+
+    public static function flatten(array $data, string $prefix = ''): array
+    {
+        $flat = [];
+
+        foreach ($data as $key => $value) {
+            $path = $prefix === '' ? (string) $key : $prefix.'.'.$key;
+
+            if (is_array($value) && $value !== []) {
+                $flat += static::flatten($value, $path);
+            } else {
+                $flat[$path] = $value;
+            }
+        }
+
+        return $flat;
+    }
+
+    public static function model(): string
+    {
+        return app('statamic.eloquent.blueprints.model');
+    }
+}
