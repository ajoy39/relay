+<?php
+
+namespace App\Http\Controllers;
+
+use App\Blueprints\BlueprintHistory;
+use App\Models\BlueprintRevision;
+use Illuminate\Http\JsonResponse;
+use Statamic\Facades\Blueprint;
+
+class BlueprintRevisionController extends Controller
+{
+    public function index(string $namespace, string $handle): JsonResponse
+    {
+        $revisions = BlueprintRevision::ofBlueprint($namespace, $handle)
+            ->latest('id')
+            ->get()
+            ->map(fn (BlueprintRevision $revision) => [
+                'id' => $revision->id,
+                'created_at' => $revision->created_at->toIso8601String(),
+            ])
+            ->values();
+
+        return response()->json(['revisions' => $revisions]);
+    }
+
+    public function diff(string $namespace, string $handle, int $id): JsonResponse
+    {
+        $revision = BlueprintRevision::ofBlueprint($namespace, $handle)->findOrFail($id);
+
+        return response()->json([
+            'changes' => BlueprintHistory::changes(
+                BlueprintHistory::current($namespace, $handle),
+                $revision->data,
+            ),
+        ]);
+    }
+
+    public function restore(string $namespace, string $handle, int $id): JsonResponse
+    {
+        $revision = BlueprintRevision::ofBlueprint($namespace, $handle)->findOrFail($id);
+
+        // Saving through Statamic's blueprint API clears its caches and fires its save events.
+        // The save also goes through the revision observer, so the restore is recorded as a
+        // new revision and can itself be restored.
+        $name = implode('.', array_filter([$namespace, $handle]));
+
+        (Blueprint::find($name) ?? Blueprint::make()->setNamespace($namespace)->setHandle($handle))
+            ->setContents(BlueprintHistory::normalize($revision->data))
+            ->save();
+
+        return response()->json(['restored' => true]);
+    }
+}
