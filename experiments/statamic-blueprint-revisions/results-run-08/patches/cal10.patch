+<?php
+
+namespace App\Http\Middleware;
+
+use Closure;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+
+class InjectBlueprintRevisionUI
+{
+    public function handle(Request $request, Closure $next): Response
+    {
+        $response = $next($request);
+
+        if (! $this->shouldInject($request)) {
+            return $response;
+        }
+
+        $content = $response->getContent();
+        $script = $this->getRevisionScript($request);
+
+        $content = str_replace('</body>', $script . '</body>', $content);
+        $response->setContent($content);
+
+        return $response;
+    }
+
+    private function shouldInject(Request $request): bool
+    {
+        return $request->is('cp/fields/blueprints/*') &&
+               preg_match('#/edit$#', $request->path());
+    }
+
+    private function getRevisionScript(Request $request): string
+    {
+        $path = $request->path();
+        // Extract namespace and handle from path like: cp/fields/blueprints/collections/pages/page/edit
+        if (! preg_match('#cp/fields/blueprints/([^/]+)/([^/]+)/([^/]+)/edit$#', $path, $matches)) {
+            return '';
+        }
+
+        $type = $matches[1];      // collections
+        $name = $matches[2];      // pages
+        $handle = $matches[3];    // page
+        $namespace = "{$type}.{$name}";
+
+        return <<<JS
+<script>
+(function() {
+  const namespace = '$namespace';
+  const handle = '$handle';
+
+  async function initRevisions() {
+    try {
+      const response = await fetch(\`/cp/blueprint-revisions/\${namespace}/\${handle}\`);
+      if (response.status !== 200) return;
+
+      const data = await response.json();
+      renderRevisions(data.revisions);
+    } catch (e) {
+      console.error('Failed to load revisions:', e);
+    }
+  }
+
+  function renderRevisions(revisions) {
+    // Find or create revisions section
+    let section = document.querySelector('[data-revisions-section]');
+    if (!section) {
+      section = document.createElement('div');
+      section.setAttribute('data-revisions-section', '');
+      section.innerHTML = '<h2>Revisions</h2><div data-revisions-list></div>';
+
+      // Insert after the main content
+      const container = document.querySelector('[role="main"]') || document.body;
+      container.appendChild(section);
+    }
+
+    const list = section.querySelector('[data-revisions-list]');
+    list.innerHTML = '';
+
+    revisions.forEach(rev => {
+      const row = document.createElement('div');
+      row.setAttribute('data-revision-id', rev.id);
+      row.innerHTML = \`
+        <div style="border: 1px solid #ccc; padding: 10px; margin: 10px 0;">
+          <div>\${new Date(rev.created_at).toLocaleString()}</div>
+          <button data-revision-preview="\${rev.id}">Preview</button>
+          <button data-revision-restore="\${rev.id}">Restore</button>
+        </div>
+      \`;
+
+      // Attach preview handler
+      const previewBtn = row.querySelector(\`[data-revision-preview="\${rev.id}"]\`);
+      previewBtn.addEventListener('click', () => showPreview(rev.id));
+
+      // Attach restore handler
+      const restoreBtn = row.querySelector(\`[data-revision-restore="\${rev.id}"]\`);
+      restoreBtn.addEventListener('click', () => restoreRevision(rev.id));
+
+      list.appendChild(row);
+    });
+  }
+
+  async function showPreview(revisionId) {
+    try {
+      const response = await fetch(\`/cp/blueprint-revisions/\${namespace}/\${handle}/\${revisionId}/diff\`);
+      const data = await response.json();
+
+      let preview = document.querySelector('[data-revision-preview-modal]');
+      if (!preview) {
+        preview = document.createElement('div');
+        preview.setAttribute('data-revision-preview-modal', '');
+        preview.style.cssText = 'position: fixed; top: 50px; left: 50%; transform: translateX(-50%); background: white; border: 1px solid #ccc; padding: 20px; max-width: 600px; z-index: 1000; border-radius: 4px; max-height: 80vh; overflow-y: auto;';
+        document.body.appendChild(preview);
+      }
+
+      let html = '<h3>Changes in this revision</h3>';
+      if (data.changes.length === 0) {
+        html += '<p>No changes</p>';
+      } else {
+        html += '<div style="font-family: monospace; font-size: 12px;">';
+        data.changes.forEach(change => {
+          html += \`<div style="border: 1px solid #eee; padding: 8px; margin: 5px 0;">
+            <div><strong>\${change.path}</strong></div>
+            <div style="color: red; margin: 4px 0;">- \${JSON.stringify(change.from)}</div>
+            <div style="color: green; margin: 4px 0;">+ \${JSON.stringify(change.to)}</div>
+          </div>\`;
+        });
+        html += '</div>';
+      }
+      html += '<button onclick="this.closest(\\\'[data-revision-preview-modal]\\\').remove()">Close</button>';
+      preview.innerHTML = html;
+    } catch (e) {
+      console.error('Failed to load preview:', e);
+    }
+  }
+
+  async function restoreRevision(revisionId) {
+    if (!confirm('Are you sure you want to restore this revision?')) return;
+
+    try {
+      const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content ||
+                       document.cookie.split(';').find(c => c.includes('XSRF-TOKEN'))?.split('=')[1];
+
+      const response = await fetch(\`/cp/blueprint-revisions/\${namespace}/\${handle}/\${revisionId}/restore\`, {
+        method: 'POST',
+        headers: {
+          'X-CSRF-TOKEN': csrfToken,
+          'X-Requested-With': 'XMLHttpRequest',
+          'Accept': 'application/json'
+        }
+      });
+
+      if (response.ok) {
+        const data = await response.json();
+        if (data.restored) {
+          alert('Revision restored!');
+          location.reload();
+        }
+      }
+    } catch (e) {
+      console.error('Failed to restore revision:', e);
+    }
+  }
+
+  // Wait for page to be ready
+  if (document.readyState === 'loading') {
+    document.addEventListener('DOMContentLoaded', initRevisions);
+  } else {
+    initRevisions();
+  }
+})();
+</script>
+JS;
+    }
+}
