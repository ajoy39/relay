+<?php
+
+namespace App\Providers;
+
+use App\Models\BlueprintRevision;
+use Illuminate\Support\ServiceProvider;
+use Statamic\Events\BlueprintSaved;
+
+class BlueprintRevisionServiceProvider extends ServiceProvider
+{
+    public function boot(): void
+    {
+        $this->registerEventListeners();
+    }
+
+    private function registerEventListeners(): void
+    {
+        $this->app['events']->listen(BlueprintSaved::class, function (BlueprintSaved $event) {
+            $blueprint = $event->blueprint;
+
+            BlueprintRevision::create([
+                'namespace' => $blueprint->namespace(),
+                'handle' => $blueprint->handle(),
+                'data' => $blueprint->contents(),
+            ]);
+        });
+    }
+}
