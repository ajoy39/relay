+<?php
+
+namespace App\Http\Controllers;
+
+use App\Models\BlueprintRevision;
+use Illuminate\Http\Request;
+use Statamic\Facades\Blueprint;
+
+class BlueprintRevisionController extends Controller
+{
+    public function index($namespace, $handle)
+    {
+        $revisions = BlueprintRevision::where('namespace', $namespace === 'null' ? null : $namespace)
+            ->where('handle', $handle)
+            ->orderByDesc('created_at')
+            ->get(['id', 'created_at']);
+
+        return response()->json(['revisions' => $revisions]);
+    }
+
+    public function diff($namespace, $handle, $id)
+    {
+        $revision = BlueprintRevision::find($id);
+
+        if (! $revision) {
+            return response()->json(['changes' => []], 404);
+        }
+
+        $currentBlueprint = Blueprint::find("{$namespace}::{$handle}");
+        if (! $currentBlueprint) {
+            return response()->json(['changes' => []], 404);
+        }
+
+        $currentData = $currentBlueprint->contents();
+        $revisionData = $revision->data;
+
+        $changes = $this->computeDiff($currentData, $revisionData);
+
+        return response()->json(['changes' => $changes]);
+    }
+
+    public function restore($namespace, $handle, $id, Request $request)
+    {
+        $revision = BlueprintRevision::find($id);
+
+        if (! $revision) {
+            return response()->json(['restored' => false], 404);
+        }
+
+        $blueprint = Blueprint::find("{$namespace}::{$handle}");
+        if (! $blueprint) {
+            return response()->json(['restored' => false], 404);
+        }
+
+        $blueprint->setContents($revision->data);
+        Blueprint::save($blueprint);
+
+        return response()->json(['restored' => true]);
+    }
+
+    private function computeDiff($current, $revision)
+    {
+        $changes = [];
+        $this->diffArrays($current, $revision, '', $changes);
+        return $changes;
+    }
+
+    private function diffArrays($current, $revision, $path, &$changes)
+    {
+        $allKeys = array_keys($current) + array_keys($revision);
+
+        foreach (array_unique($allKeys) as $key) {
+            $currentValue = $current[$key] ?? null;
+            $revisionValue = $revision[$key] ?? null;
+            $newPath = $path ? "{$path}.{$key}" : $key;
+
+            if (is_array($currentValue) && is_array($revisionValue)) {
+                $this->diffArrays($currentValue, $revisionValue, $newPath, $changes);
+            } elseif ($currentValue !== $revisionValue) {
+                $changes[] = [
+                    'path' => $newPath,
+                    'from' => $revisionValue,
+                    'to' => $currentValue,
+                ];
+            }
+        }
+    }
+}
