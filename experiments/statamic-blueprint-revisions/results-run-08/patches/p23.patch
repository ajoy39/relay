+<?php
+
+namespace App\Support;
+
+class BlueprintDiff
+{
+    /**
+     * The field-level changes between the current blueprint contents and a
+     * revision: what restoring the revision would change. Each change carries
+     * the dot path plus the current ("from") and revision ("to") values.
+     */
+    public static function between(?array $current, array $revision): array
+    {
+        $from = self::flatten(self::normalize($current ?? []));
+        $to = self::flatten(self::normalize($revision));
+
+        $paths = array_unique(array_merge(array_keys($from), array_keys($to)));
+        sort($paths);
+
+        $changes = [];
+
+        foreach ($paths as $path) {
+            $fromValue = $from[$path] ?? null;
+            $toValue = $to[$path] ?? null;
+
+            if ($fromValue !== $toValue) {
+                $changes[] = [
+                    'path' => (string) $path,
+                    'from' => $fromValue,
+                    'to' => $toValue,
+                ];
+            }
+        }
+
+        return $changes;
+    }
+
+    /**
+     * Drop the driver's __count ordering keys, which are storage bookkeeping
+     * rather than blueprint content.
+     */
+    private static function normalize(mixed $value): mixed
+    {
+        if (! is_array($value)) {
+            return $value;
+        }
+
+        $normalized = [];
+
+        foreach ($value as $key => $item) {
+            if ($key === '__count') {
+                continue;
+            }
+
+            $normalized[$key] = self::normalize($item);
+        }
+
+        return $normalized;
+    }
+
+    /**
+     * Flatten to dot paths. List items that carry a handle (fields) are keyed
+     * by it, so inserting a field does not shift every path after it.
+     */
+    private static function flatten(mixed $value, string $prefix = '', array &$out = []): array
+    {
+        if (is_array($value) && $value !== []) {
+            foreach ($value as $key => $item) {
+                $segment = is_array($item) && isset($item['handle']) && is_string($item['handle'])
+                    ? $item['handle']
+                    : $key;
+
+                self::flatten($item, $prefix === '' ? (string) $segment : $prefix.'.'.$segment, $out);
+            }
+        } else {
+            $out[$prefix] = $value;
+        }
+
+        return $out;
+    }
+}
