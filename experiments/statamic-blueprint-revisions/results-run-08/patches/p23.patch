+<?php
+
+namespace App\Models;
+
+use Illuminate\Database\Eloquent\Model;
+
+class BlueprintRevision extends Model
+{
+    protected $guarded = [];
+
+    protected function casts(): array
+    {
+        return [
+            'data' => 'array',
+        ];
+    }
+
+    /**
+     * Snapshot the stored contents of a blueprint row as a new revision.
+     */
+    public static function record(Model $blueprint): static
+    {
+        return static::create([
+            'namespace' => $blueprint->getAttributeValue('namespace'),
+            'handle' => $blueprint->getAttributeValue('handle'),
+            'data' => $blueprint->getAttributeValue('data'),
+        ]);
+    }
+}
