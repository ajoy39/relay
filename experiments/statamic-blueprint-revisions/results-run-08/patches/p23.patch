@@ -0,0 +1,196 @@
+// Blueprint revision tracker for the CP blueprint edit page. Injected into CP
+// pages by AppServiceProvider via Statamic::inlineScript(); it does nothing
+// anywhere else. The CP is a client-side app, so the page is re-checked on a
+// timer rather than only on load.
+(function () {
+    var EDIT_PATH = /^\/cp\/fields\/blueprints\/(.+)\/edit\/?$/;
+    var API = '/cp/blueprint-revisions';
+    var SECTION_ID = 'blueprint-revisions';
+
+    function target() {
+        var match = EDIT_PATH.exec(window.location.pathname);
+
+        if (!match) {
+            return null;
+        }
+
+        var parts = match[1].split('/');
+        var handle = parts.pop();
+
+        return { namespace: parts.join('.'), handle: handle };
+    }
+
+    function headers() {
+        var h = { Accept: 'application/json', 'X-Requested-With': 'XMLHttpRequest' };
+        var meta = document.querySelector('meta[name="csrf-token"]');
+        var xsrf = document.cookie.split('; ').find(function (c) { return c.indexOf('XSRF-TOKEN=') === 0; });
+
+        if (meta) {
+            h['X-CSRF-TOKEN'] = meta.getAttribute('content');
+        }
+
+        if (xsrf) {
+            h['X-XSRF-TOKEN'] = decodeURIComponent(xsrf.slice('XSRF-TOKEN='.length));
+        }
+
+        return h;
+    }
+
+    function call(method, url) {
+        return fetch(url, { method: method, credentials: 'same-origin', headers: headers() }).then(function (res) {
+            return res.json().catch(function () { return {}; }).then(function (body) {
+                if (!res.ok) {
+                    throw new Error('Request failed with status ' + res.status);
+                }
+
+                return body;
+            });
+        });
+    }
+
+    function el(tag, text, attrs) {
+        var node = document.createElement(tag);
+
+        if (text !== undefined) {
+            node.textContent = text;
+        }
+
+        Object.keys(attrs || {}).forEach(function (key) { node.setAttribute(key, attrs[key]); });
+
+        return node;
+    }
+
+    function button(label, attrs, onClick) {
+        var node = el('button', label, Object.assign({ type: 'button' }, attrs));
+        node.style.cssText = 'margin-right:.5rem;padding:.25rem .6rem;border:1px solid #cbd5e1;border-radius:.25rem;background:#fff;cursor:pointer;';
+        node.addEventListener('click', onClick);
+
+        return node;
+    }
+
+    function format(value) {
+        return value === undefined ? 'null' : JSON.stringify(value);
+    }
+
+    function renderChanges(container, changes, id) {
+        container.textContent = '';
+
+        if (changes.length === 0) {
+            container.appendChild(el('p', 'Restoring revision ' + id + ' would not change this blueprint.'));
+
+            return;
+        }
+
+        container.appendChild(el('p', 'Restoring revision ' + id + ' would change ' + changes.length + ' path(s). Nothing has been applied yet.'));
+
+        var table = el('table');
+        var head = el('tr');
+        ['Path', 'Current', 'Revision'].forEach(function (label) { head.appendChild(el('th', label, { style: 'text-align:left;padding:.25rem .5rem;' })); });
+        table.appendChild(head);
+
+        changes.forEach(function (change) {
+            var row = el('tr');
+            row.appendChild(el('td', change.path, { style: 'padding:.25rem .5rem;font-family:monospace;' }));
+            row.appendChild(el('td', format(change.from), { style: 'padding:.25rem .5rem;font-family:monospace;' }));
+            row.appendChild(el('td', format(change.to), { style: 'padding:.25rem .5rem;font-family:monospace;' }));
+            table.appendChild(row);
+        });
+
+        container.appendChild(table);
+    }
+
+    function build(t, key) {
+        var root = el('section', undefined, { id: SECTION_ID, 'data-key': key });
+        root.style.cssText = 'margin:2rem auto;max-width:960px;padding:1.5rem;background:#fff;border:1px solid #e2e8f0;border-radius:.5rem;font-size:14px;';
+
+        root.appendChild(el('h2', 'Revisions', { style: 'font-size:1.125rem;font-weight:600;margin-bottom:.75rem;' }));
+
+        var status = el('p', 'Loading revision history…');
+        var list = el('ul', undefined, { style: 'list-style:none;padding:0;margin:0 0 1rem;' });
+        var diff = el('div', undefined, { 'data-revision-diff': '' });
+
+        root.appendChild(status);
+        root.appendChild(list);
+        root.appendChild(diff);
+        document.body.appendChild(root);
+
+        var base = API + '/' + t.namespace + '/' + t.handle;
+
+        function preview(id) {
+            diff.textContent = 'Loading preview…';
+
+            call('GET', base + '/' + id + '/diff')
+                .then(function (body) { renderChanges(diff, body.changes || [], id); })
+                .catch(function (err) { diff.textContent = err.message; });
+        }
+
+        function restore(id) {
+            call('POST', base + '/' + id + '/restore')
+                .then(function () { window.location.reload(); })
+                .catch(function (err) { diff.textContent = err.message; });
+        }
+
+        call('GET', base)
+            .then(function (body) {
+                var revisions = body.revisions || [];
+
+                status.textContent = revisions.length === 0
+                    ? 'No revisions recorded for this blueprint yet.'
+                    : 'Newest first. Every save and restore is recorded.';
+
+                revisions.forEach(function (revision) {
+                    var row = el('li', undefined, { 'data-revision-id': revision.id });
+                    row.style.cssText = 'display:flex;align-items:center;justify-content:space-between;padding:.5rem 0;border-bottom:1px solid #f1f5f9;';
+
+                    var time = new Date(revision.created_at);
+                    row.appendChild(el('span', isNaN(time) ? revision.created_at : time.toLocaleString()));
+
+                    var actions = el('span');
+                    actions.appendChild(button('Preview', { 'data-revision-preview': revision.id }, function () { preview(revision.id); }));
+                    actions.appendChild(button('Restore', { 'data-revision-restore': revision.id }, function () { restore(revision.id); }));
+                    row.appendChild(actions);
+
+                    list.appendChild(row);
+                });
+            })
+            .catch(function (err) { status.textContent = 'Could not load revisions: ' + err.message; });
+    }
+
+    var mounted = null;
+
+    function tick() {
+        var t = target();
+        var existing = document.getElementById(SECTION_ID);
+
+        if (!t) {
+            if (existing) {
+                existing.remove();
+            }
+
+            mounted = null;
+
+            return;
+        }
+
+        var key = t.namespace + '/' + t.handle;
+
+        if (mounted === key && existing) {
+            return;
+        }
+
+        if (existing) {
+            existing.remove();
+        }
+
+        mounted = key;
+        build(t, key);
+    }
+
+    if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', tick);
+    } else {
+        tick();
+    }
+
+    setInterval(tick, 500);
+})();
