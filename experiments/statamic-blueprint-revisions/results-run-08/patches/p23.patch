+<?php
+
+namespace App\Http\Controllers;
+
+use App\Models\BlueprintRevision;
+use App\Support\BlueprintDiff;
+use Illuminate\Http\JsonResponse;
+
+class BlueprintRevisionController extends Controller
+{
+    public function index(string $namespace, string $handle): JsonResponse
+    {
+        $revisions = BlueprintRevision::query()
+            ->where('namespace', $namespace)
+            ->where('handle', $handle)
+            ->orderByDesc('id')
+            ->get()
+            ->map(fn (BlueprintRevision $revision) => [
+                'id' => $revision->id,
+                'created_at' => $revision->created_at->toIso8601String(),
+            ]);
+
+        return response()->json(['revisions' => $revisions->values()]);
+    }
+
+    public function diff(string $namespace, string $handle, string $id): JsonResponse
+    {
+        $revision = $this->revision($namespace, $handle, $id);
+
+        return response()->json([
+            'changes' => BlueprintDiff::between($this->current($namespace, $handle), $revision->data),
+        ]);
+    }
+
+    public function restore(string $namespace, string $handle, string $id): JsonResponse
+    {
+        $revision = $this->revision($namespace, $handle, $id);
+
+        // Saving through the model fires the same revision hook as any other save,
+        // so the restore is itself recorded and can be undone.
+        $model = $this->blueprintModel();
+        $blueprint = $model::firstOrNew([
+            'namespace' => $namespace,
+            'handle' => $handle,
+        ]);
+
+        $blueprint->data = $revision->data;
+        $blueprint->save();
+
+        return response()->json(['restored' => true]);
+    }
+
+    private function revision(string $namespace, string $handle, string $id): BlueprintRevision
+    {
+        return BlueprintRevision::query()
+            ->where('namespace', $namespace)
+            ->where('handle', $handle)
+            ->findOrFail($id);
+    }
+
+    private function current(string $namespace, string $handle): ?array
+    {
+        $model = $this->blueprintModel();
+        $blueprint = $model::query()
+            ->where('namespace', $namespace)
+            ->where('handle', $handle)
+            ->first();
+
+        return $blueprint?->getAttributeValue('data');
+    }
+
+    private function blueprintModel(): string
+    {
+        return app('statamic.eloquent.blueprints.model');
+    }
+}
