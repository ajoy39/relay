+<?php
+
+namespace App\Http\Middleware;
+
+use Closure;
+use Illuminate\Http\Request;
+
+class InjectBlueprintRevisions
+{
+    public function handle(Request $request, Closure $next)
+    {
+        $response = $next($request);
+
+        $path = $request->path();
+
+        // Try to match /cp/fields/blueprints/{...}/edit pattern
+        if (preg_match('#cp/fields/blueprints/(.+)/edit$#', $path, $matches)) {
+            $parts = explode('/', $matches[1]);
+            if (count($parts) >= 2) {
+                // Last part is the handle
+                $handle = array_pop($parts);
+                // Remaining parts make up the namespace
+                $namespace = implode('.', $parts);
+
+                if ($response->headers->get('content-type') && strpos($response->headers->get('content-type'), 'text/html') !== false) {
+                    $revisions = \App\Models\BlueprintRevision::where('namespace', $namespace)
+                        ->where('handle', $handle)
+                        ->orderBy('created_at', 'desc')
+                        ->get(['id', 'created_at']);
+
+                    $html = $this->renderRevisions($namespace, $handle, $revisions);
+                    $content = $response->getContent();
+                    if (strpos($content, '</body>') !== false) {
+                        $content = str_replace('</body>', $html . '</body>', $content);
+                    } else {
+                        $content .= $html;
+                    }
+                    $response->setContent($content);
+                }
+            }
+        }
+
+        return $response;
+    }
+
+    private function renderRevisions($namespace, $handle, $revisions)
+    {
+        if ($revisions->isEmpty()) {
+            return '<div style="display:none;" id="blueprint-revisions-section"></div><script src="/js/blueprint-revisions.js"></script>';
+        }
+
+        $html = '<div id="blueprint-revisions-section" style="margin-top: 2rem; padding: 1rem; border: 1px solid #e5e7eb; border-radius: 0.375rem;">';
+        $html .= '<h2 style="font-size: 1.25rem; font-weight: 600; margin-bottom: 1rem;">Revisions</h2>';
+        $html .= '<div style="overflow-x: auto;"><table style="width: 100%; border-collapse: collapse;">';
+        $html .= '<thead><tr style="background-color: #f3f4f6;"><th style="padding: 0.5rem; text-align: left; border: 1px solid #e5e7eb;">Created</th><th style="padding: 0.5rem; text-align: left; border: 1px solid #e5e7eb;">Actions</th></tr></thead>';
+        $html .= '<tbody>';
+
+        foreach ($revisions as $revision) {
+            $html .= '<tr style="border: 1px solid #e5e7eb;" data-revision-id="' . htmlspecialchars($revision->id) . '">';
+            $html .= '<td style="padding: 0.5rem; border: 1px solid #e5e7eb;">';
+            $html .= htmlspecialchars($revision->created_at->format('Y-m-d H:i:s'));
+            $html .= '</td>';
+            $html .= '<td style="padding: 0.5rem; border: 1px solid #e5e7eb;">';
+            $html .= '<button data-revision-preview="' . htmlspecialchars($revision->id) . '" style="padding: 0.25rem 0.75rem; margin-right: 0.5rem; background-color: #3b82f6; color: white; border: none; border-radius: 0.25rem; cursor: pointer;">Preview</button>';
+            $html .= '<button data-revision-restore="' . htmlspecialchars($revision->id) . '" style="padding: 0.25rem 0.75rem; background-color: #10b981; color: white; border: none; border-radius: 0.25rem; cursor: pointer;">Restore</button>';
+            $html .= '</td>';
+            $html .= '</tr>';
+        }
+
+        $html .= '</tbody></table></div>';
+        $html .= '</div>';
+        $html .= '<script src="/js/blueprint-revisions.js"></script>';
+
+        return $html;
+    }
+}
