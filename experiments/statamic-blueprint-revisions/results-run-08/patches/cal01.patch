+<?php
+
+namespace App\Http\Controllers\CP;
+
+use App\Http\Controllers\Controller;
+use App\Models\BlueprintRevision;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Support\Facades\DB;
+
+class BlueprintRevisionsController extends Controller
+{
+
+    public function index($namespace, $handle): JsonResponse
+    {
+        $revisions = BlueprintRevision::where('namespace', $namespace)
+            ->where('handle', $handle)
+            ->orderBy('created_at', 'desc')
+            ->get(['id', 'created_at'])
+            ->map(function ($revision) {
+                return [
+                    'id' => (string) $revision->id,
+                    'created_at' => $revision->created_at->toIso8601String(),
+                ];
+            });
+
+        return response()->json(['revisions' => $revisions->values()]);
+    }
+
+    public function diff($namespace, $handle, $id): JsonResponse
+    {
+        $revision = BlueprintRevision::where('namespace', $namespace)
+            ->where('handle', $handle)
+            ->findOrFail($id);
+
+        // Get the current blueprint data from the blueprints table
+        $blueprint = DB::table('blueprints')
+            ->where('namespace', $namespace)
+            ->where('handle', $handle)
+            ->first();
+
+        $currentData = $blueprint ? json_decode($blueprint->data, true) : [];
+
+        $changes = $this->computeDiff($currentData, $revision->data);
+
+        return response()->json(['changes' => $changes]);
+    }
+
+    public function restore($namespace, $handle, $id): JsonResponse
+    {
+        $revision = BlueprintRevision::where('namespace', $namespace)
+            ->where('handle', $handle)
+            ->findOrFail($id);
+
+        $current = BlueprintRevision::where('namespace', $namespace)
+            ->where('handle', $handle)
+            ->orderBy('created_at', 'desc')
+            ->first();
+
+        // Record the current state as a new revision before restoring
+        if ($current) {
+            BlueprintRevision::create([
+                'blueprint_id' => $current->blueprint_id,
+                'namespace' => $current->namespace,
+                'handle' => $current->handle,
+                'data' => $current->data,
+            ]);
+        }
+
+        // Update the blueprint in the blueprints table
+        DB::table('blueprints')
+            ->where('namespace', $namespace)
+            ->where('handle', $handle)
+            ->update([
+                'data' => json_encode($revision->data),
+                'updated_at' => now(),
+            ]);
+
+        return response()->json(['restored' => true]);
+    }
+
+    private function computeDiff($from, $to): array
+    {
+        $changes = [];
+        $this->diffArray($from, $to, '', $changes);
+        return $changes;
+    }
+
+    private function diffArray($from, $to, $path, &$changes): void
+    {
+        $allKeys = array_unique(array_merge(array_keys((array) $from), array_keys((array) $to)));
+
+        foreach ($allKeys as $key) {
+            $fromValue = $from[$key] ?? null;
+            $toValue = $to[$key] ?? null;
+            $newPath = $path ? $path . '.' . $key : $key;
+
+            if (is_array($fromValue) && is_array($toValue)) {
+                $this->diffArray($fromValue, $toValue, $newPath, $changes);
+            } elseif ($fromValue !== $toValue) {
+                $changes[] = [
+                    'path' => $newPath,
+                    'from' => $fromValue,
+                    'to' => $toValue,
+                ];
+            }
+        }
+    }
+}
