diff --git a/public/js/blueprint-revisions.js b/public/js/blueprint-revisions.js
new file mode 100644
index 0000000..68c1d1d
--- /dev/null
+++ b/public/js/blueprint-revisions.js
@@ -0,0 +1,92 @@
+document.addEventListener('DOMContentLoaded', function () {
+    const urlMatch = window.location.pathname.match(/\/cp\/fields\/blueprints\/(.+)\/edit$/);
+    if (!urlMatch) return;
+
+    const parts = urlMatch[1].split('/');
+    if (parts.length < 2) return;
+
+    const handle = parts.pop();
+    const namespace = parts.join('.');
+    const apiBase = `/cp/blueprint-revisions/${namespace}/${handle}`;
+
+    document.addEventListener('click', async function (e) {
+        if (e.target.matches('[data-revision-preview]')) {
+            const revisionId = e.target.getAttribute('data-revision-preview');
+            try {
+                const response = await fetch(`${apiBase}/${revisionId}/diff`);
+                const data = await response.json();
+                showPreviewModal(data.changes);
+            } catch (error) {
+                alert('Error loading preview: ' + error.message);
+            }
+        }
+
+        if (e.target.matches('[data-revision-restore]')) {
+            const revisionId = e.target.getAttribute('data-revision-restore');
+            if (!confirm('Are you sure you want to restore this revision?')) return;
+
+            try {
+                const response = await fetch(`${apiBase}/${revisionId}/restore`, {
+                    method: 'POST',
+                    headers: {
+                        'Content-Type': 'application/json',
+                        'X-CSRF-TOKEN': getCsrfToken(),
+                    },
+                });
+                const data = await response.json();
+                if (data.restored) {
+                    alert('Revision restored successfully');
+                    window.location.reload();
+                }
+            } catch (error) {
+                alert('Error restoring revision: ' + error.message);
+            }
+        }
+    });
+
+    function showPreviewModal(changes) {
+        let html = '<div style="padding: 1rem;">';
+        html += '<h3 style="margin-bottom: 1rem;">Preview of Changes</h3>';
+
+        if (changes.length === 0) {
+            html += '<p>No changes</p>';
+        } else {
+            html += '<table style="width: 100%; border-collapse: collapse;">';
+            html += '<tr style="background-color: #f3f4f6;"><th style="padding: 0.5rem; text-align: left; border: 1px solid #e5e7eb;">Path</th><th style="padding: 0.5rem; text-align: left; border: 1px solid #e5e7eb;">From</th><th style="padding: 0.5rem; text-align: left; border: 1px solid #e5e7eb;">To</th></tr>';
+            for (const change of changes) {
+                html += '<tr>';
+                html += '<td style="padding: 0.5rem; border: 1px solid #e5e7eb;">' + escapeHtml(change.path) + '</td>';
+                html += '<td style="padding: 0.5rem; border: 1px solid #e5e7eb;"><pre style="margin: 0; white-space: pre-wrap; word-break: break-word;">' + escapeHtml(JSON.stringify(change.from, null, 2)) + '</pre></td>';
+                html += '<td style="padding: 0.5rem; border: 1px solid #e5e7eb;"><pre style="margin: 0; white-space: pre-wrap; word-break: break-word;">' + escapeHtml(JSON.stringify(change.to, null, 2)) + '</pre></td>';
+                html += '</tr>';
+            }
+            html += '</table>';
+        }
+        html += '</div>';
+
+        // Create a simple modal
+        const modal = document.createElement('div');
+        modal.style.cssText = 'position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0, 0, 0, 0.5); display: flex; align-items: center; justify-content: center; z-index: 9999;';
+        modal.innerHTML = '<div style="background: white; padding: 2rem; border-radius: 0.5rem; max-width: 90%; max-height: 90%; overflow: auto;">' + html + '<button onclick="this.parentElement.parentElement.remove()" style="margin-top: 1rem; padding: 0.5rem 1rem; background-color: #6b7280; color: white; border: none; border-radius: 0.25rem; cursor: pointer;">Close</button></div>';
+        document.body.appendChild(modal);
+    }
+
+    function getCsrfToken() {
+        const meta = document.querySelector('meta[name="csrf-token"]');
+        if (meta) return meta.getAttribute('content');
+
+        const cookies = document.cookie.split('; ');
+        for (const cookie of cookies) {
+            const [name, value] = cookie.split('=');
+            if (name === 'XSRF-TOKEN') return decodeURIComponent(value);
+        }
+
+        return '';
+    }
+
+    function escapeHtml(text) {
+        const div = document.createElement('div');
+        div.textContent = text;
+        return div.innerHTML;
+    }
+});
