+<?php
+
+namespace App\Listeners;
+
+use App\Models\BlueprintRevision;
+use Illuminate\Support\Facades\DB;
+use Statamic\Events\BlueprintSaved;
+
+class RecordBlueprintRevision
+{
+    public function handle(BlueprintSaved $event): void
+    {
+        try {
+            $blueprint = $event->blueprint;
+            $namespace = $blueprint->namespace();
+            $handle = $blueprint->handle();
+
+            $blueprintRecord = DB::table('blueprints')
+                ->where('namespace', $namespace)
+                ->where('handle', $handle)
+                ->first();
+
+            if (!$blueprintRecord) {
+                return;
+            }
+
+            $currentData = $blueprint->contents();
+
+            // Check if the most recent revision has the exact same data
+            $latestRevision = BlueprintRevision::where('namespace', $namespace)
+                ->where('handle', $handle)
+                ->latest('created_at')
+                ->latest('id')
+                ->first();
+
+            if ($latestRevision && $latestRevision->data === $currentData) {
+                return;
+            }
+
+            BlueprintRevision::create([
+                'blueprint_id' => $blueprintRecord->id,
+                'namespace' => $namespace,
+                'handle' => $handle,
+                'data' => $currentData,
+            ]);
+        } catch (\Exception $e) {
+            // Log the error but don't throw to avoid breaking the blueprint save
+            \Log::error('Failed to record blueprint revision: ' . $e->getMessage());
+        }
+    }
+}
