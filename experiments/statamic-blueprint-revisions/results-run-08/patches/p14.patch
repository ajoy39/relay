@@ -0,0 +1,171 @@
+// Revisions panel for the blueprint edit page. Injected into every CP page by
+// AppServiceProvider; it only mounts on /cp/fields/blueprints/{type}/{parent}/{handle}/edit.
+(function () {
+    const EDIT_PATH = /^\/cp\/fields\/blueprints\/([^/]+)\/([^/]+)\/([^/]+)\/edit\/?$/;
+    const API = '/cp/blueprint-revisions';
+
+    let mountedKey = null;
+
+    function blueprintFromPath() {
+        const match = window.location.pathname.match(EDIT_PATH);
+
+        return match ? { namespace: `${match[1]}.${match[2]}`, handle: match[3] } : null;
+    }
+
+    function mount() {
+        const blueprint = blueprintFromPath();
+        const existing = document.getElementById('blueprint-revisions');
+
+        if (!blueprint) {
+            existing?.remove();
+            mountedKey = null;
+
+            return;
+        }
+
+        const key = `${blueprint.namespace}/${blueprint.handle}`;
+
+        if (existing && mountedKey === key) {
+            return;
+        }
+
+        existing?.remove();
+        mountedKey = key;
+
+        const panel = buildPanel(blueprint);
+        document.body.appendChild(panel);
+        loadRevisions(blueprint, panel);
+    }
+
+    function buildPanel(blueprint) {
+        const section = el('section', {
+            id: 'blueprint-revisions',
+            style: 'margin:2rem auto;max-width:48rem;padding:1rem 1.25rem;border:1px solid #d4d4d8;border-radius:0.5rem;background:#fff;color:#18181b;font:14px/1.5 system-ui,sans-serif',
+        });
+
+        section.appendChild(el('h2', { style: 'margin:0 0 0.5rem;font-size:1.125rem' }, 'Revisions'));
+        section.appendChild(el('p', { 'data-revision-status': '', role: 'status', style: 'margin:0 0 0.5rem;color:#71717a' }));
+        section.appendChild(el('ul', { 'data-revision-list': '', style: 'margin:0;padding:0;list-style:none' }));
+
+        return section;
+    }
+
+    async function loadRevisions(blueprint, panel) {
+        const status = panel.querySelector('[data-revision-status]');
+        const list = panel.querySelector('[data-revision-list]');
+
+        status.textContent = 'Loading revisions…';
+
+        try {
+            const { revisions } = await request(`${API}/${blueprint.namespace}/${blueprint.handle}`);
+
+            status.textContent = revisions.length ? '' : 'No revisions yet.';
+
+            revisions.forEach((revision) => list.appendChild(buildRow(blueprint, revision)));
+        } catch (error) {
+            status.textContent = `Could not load revisions (${error.message}).`;
+        }
+    }
+
+    function buildRow(blueprint, revision) {
+        const row = el('li', {
+            'data-revision-id': String(revision.id),
+            style: 'padding:0.5rem 0;border-top:1px solid #e4e4e7',
+        });
+
+        const time = el('time', { datetime: revision.created_at, style: 'margin-right:1rem' }, new Date(revision.created_at).toLocaleString());
+        const preview = el('button', { type: 'button', 'data-revision-preview': String(revision.id), style: 'margin-right:0.5rem' }, 'Preview');
+        const restore = el('button', { type: 'button', 'data-revision-restore': String(revision.id) }, 'Restore');
+        const diff = el('ul', { 'data-revision-diff': String(revision.id), style: 'margin:0.5rem 0 0;padding-left:1.25rem', hidden: '' });
+
+        preview.addEventListener('click', () => showPreview(blueprint, revision.id, diff, preview));
+        restore.addEventListener('click', () => restoreRevision(blueprint, revision.id, restore));
+
+        row.append(time, preview, restore, diff);
+
+        return row;
+    }
+
+    async function showPreview(blueprint, id, diffList, button) {
+        button.disabled = true;
+
+        try {
+            const { changes } = await request(`${API}/${blueprint.namespace}/${blueprint.handle}/${id}/diff`);
+
+            diffList.replaceChildren();
+
+            if (changes.length === 0) {
+                diffList.appendChild(el('li', {}, 'No changes: this revision matches the current blueprint.'));
+            }
+
+            changes.forEach((change) => {
+                diffList.appendChild(el('li', {}, `${change.path}: ${format(change.from)} → ${format(change.to)}`));
+            });
+
+            diffList.hidden = false;
+        } catch (error) {
+            diffList.replaceChildren(el('li', {}, `Preview failed (${error.message}).`));
+            diffList.hidden = false;
+        } finally {
+            button.disabled = false;
+        }
+    }
+
+    async function restoreRevision(blueprint, id, button) {
+        const status = document.querySelector('[data-revision-status]');
+
+        button.disabled = true;
+
+        try {
+            await request(`${API}/${blueprint.namespace}/${blueprint.handle}/${id}/restore`, 'POST');
+
+            status.textContent = 'Revision restored. Reloading…';
+            window.location.reload();
+        } catch (error) {
+            status.textContent = `Restore failed (${error.message}).`;
+            button.disabled = false;
+        }
+    }
+
+    async function request(url, method = 'GET') {
+        const headers = { Accept: 'application/json', 'X-Requested-With': 'XMLHttpRequest' };
+
+        if (method !== 'GET') {
+            headers['X-XSRF-TOKEN'] = xsrfToken();
+        }
+
+        const response = await fetch(url, { method, headers, credentials: 'same-origin' });
+
+        if (!response.ok) {
+            throw new Error(`HTTP ${response.status}`);
+        }
+
+        return response.json();
+    }
+
+    function xsrfToken() {
+        const match = document.cookie.match(/(?:^|;\s*)XSRF-TOKEN=([^;]+)/);
+
+        return match ? decodeURIComponent(match[1]) : '';
+    }
+
+    function format(value) {
+        return JSON.stringify(value) ?? 'null';
+    }
+
+    function el(tag, attributes = {}, text) {
+        const node = document.createElement(tag);
+
+        Object.entries(attributes).forEach(([name, value]) => node.setAttribute(name, value));
+
+        if (text !== undefined) {
+            node.textContent = text;
+        }
+
+        return node;
+    }
+
+    mount();
+    window.addEventListener('popstate', mount);
+    document.addEventListener('inertia:success', mount);
+})();
