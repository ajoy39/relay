+<?php
+
+namespace App\Support;
+
+class ContentDiff
+{
+    /**
+     * List the leaf values that differ between two nested arrays.
+     *
+     * @return array<int, array{path: string, from: mixed, to: mixed}>
+     */
+    public static function between(array $from, array $to): array
+    {
+        $fromLeaves = self::flatten($from);
+        $toLeaves = self::flatten($to);
+
+        $changes = [];
+
+        foreach (array_unique([...array_keys($fromLeaves), ...array_keys($toLeaves)]) as $path) {
+            $before = $fromLeaves[$path] ?? null;
+            $after = $toLeaves[$path] ?? null;
+
+            if ($before !== $after) {
+                $changes[] = ['path' => (string) $path, 'from' => $before, 'to' => $after];
+            }
+        }
+
+        return $changes;
+    }
+
+    private static function flatten(array $values, string $prefix = ''): array
+    {
+        $leaves = [];
+
+        foreach ($values as $key => $value) {
+            $path = $prefix === '' ? (string) $key : $prefix.'.'.$key;
+
+            if (is_array($value) && $value !== []) {
+                $leaves += self::flatten($value, $path);
+            } else {
+                $leaves[$path] = $value;
+            }
+        }
+
+        return $leaves;
+    }
+}
