+<?php
+
+namespace Tests\Feature;
+
+use App\Models\BlueprintRevision;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Statamic\Facades\Blueprint;
+use Tests\TestCase;
+
+class BlueprintRevisionsTest extends TestCase
+{
+    use RefreshDatabase;
+
+    private string $api = '/cp/blueprint-revisions/collections.pages/page';
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+
+        $this->actingAs(User::factory()->create(['super' => true]));
+    }
+
+    public function test_each_blueprint_save_records_a_revision_newest_first(): void
+    {
+        $this->saveBlueprint('First');
+        $this->saveBlueprint('Second');
+
+        $revisions = $this->getJson($this->api)->assertOk()->json('revisions');
+
+        $this->assertCount(2, $revisions);
+        $this->assertSame(BlueprintRevision::query()->latest('id')->value('id'), $revisions[0]['id']);
+        $this->assertNotSame($revisions[0]['id'], $revisions[1]['id']);
+        $this->assertArrayHasKey('created_at', $revisions[0]);
+    }
+
+    public function test_history_is_empty_when_nothing_was_saved(): void
+    {
+        $this->getJson($this->api)->assertOk()->assertExactJson(['revisions' => []]);
+    }
+
+    public function test_diff_describes_changes_from_current_to_revision(): void
+    {
+        $this->saveBlueprint('Original');
+        $originalId = BlueprintRevision::query()->value('id');
+        $this->saveBlueprint('Changed');
+
+        $changes = $this->getJson("{$this->api}/{$originalId}/diff")->assertOk()->json('changes');
+
+        $this->assertSame(
+            ['tabs.main.sections.0.fields.0.field.display'],
+            array_column($changes, 'path'),
+        );
+        $this->assertSame('Changed', $changes[0]['from']);
+        $this->assertSame('Original', $changes[0]['to']);
+    }
+
+    public function test_identical_revision_has_no_changes(): void
+    {
+        $this->saveBlueprint('Same');
+        $this->saveBlueprint('Same');
+        $newestId = BlueprintRevision::query()->latest('id')->value('id');
+
+        $this->getJson("{$this->api}/{$newestId}/diff")->assertOk()->assertExactJson(['changes' => []]);
+    }
+
+    public function test_restore_applies_the_revision_and_is_itself_recorded(): void
+    {
+        $this->saveBlueprint('Original');
+        $originalId = BlueprintRevision::query()->value('id');
+        $this->saveBlueprint('Changed');
+
+        $changedId = BlueprintRevision::query()->latest('id')->value('id');
+
+        $this->postJson("{$this->api}/{$originalId}/restore")->assertOk()->assertExactJson(['restored' => true]);
+
+        $this->assertSame('Original', $this->storedTitle());
+        $this->assertCount(3, BlueprintRevision::all());
+
+        $this->postJson("{$this->api}/{$changedId}/restore")->assertOk();
+        $this->assertSame('Changed', $this->storedTitle());
+    }
+
+    public function test_unauthenticated_requests_are_refused(): void
+    {
+        $this->saveBlueprint('Original');
+        $revisionId = BlueprintRevision::query()->value('id');
+
+        auth()->guard('web')->logout();
+        $this->app['auth']->forgetGuards();
+
+        $this->getJson($this->api)->assertStatus(401);
+        $this->getJson("{$this->api}/{$revisionId}/diff")->assertStatus(401);
+        $this->postJson("{$this->api}/{$revisionId}/restore")->assertStatus(401);
+    }
+
+    private function saveBlueprint(string $title): void
+    {
+        Blueprint::make()
+            ->setNamespace('collections.pages')
+            ->setHandle('page')
+            ->setContents([
+                'tabs' => [
+                    'main' => [
+                        'display' => 'Main',
+                        'sections' => [
+                            [
+                                'fields' => [
+                                    ['handle' => 'title', 'field' => ['type' => 'text', 'display' => $title]],
+                                ],
+                            ],
+                        ],
+                    ],
+                ],
+            ])
+            ->save();
+    }
+
+    private function storedTitle(): string
+    {
+        return Blueprint::find('collections.pages.page')->field('title')->display();
+    }
+}
