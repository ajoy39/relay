diff --git a/public/js/blueprint-revisions.js b/public/js/blueprint-revisions.js
new file mode 100644
index 0000000..6820c3d
--- /dev/null
+++ b/public/js/blueprint-revisions.js
@@ -0,0 +1,227 @@
+(function () {
+    var PANEL_ID = 'blueprint-revisions';
+    var EDIT_PATH = /^(.*)\/fields\/blueprints\/([^/]+)\/([^/]+)\/([^/]+)\/edit\/?$/;
+
+    function currentBlueprint() {
+        var match = window.location.pathname.match(EDIT_PATH);
+
+        if (! match) {
+            return null;
+        }
+
+        return {
+            base: match[1],
+            namespace: match[2] + '.' + match[3],
+            handle: match[4],
+        };
+    }
+
+    function element(tag, attributes, children) {
+        var node = document.createElement(tag);
+
+        Object.keys(attributes || {}).forEach(function (name) {
+            if (name === 'text') {
+                node.textContent = attributes[name];
+            } else {
+                node.setAttribute(name, attributes[name]);
+            }
+        });
+
+        (children || []).forEach(function (child) {
+            node.appendChild(child);
+        });
+
+        return node;
+    }
+
+    function xsrfToken() {
+        var match = document.cookie.match(/(?:^|;\s*)XSRF-TOKEN=([^;]+)/);
+
+        return match ? decodeURIComponent(match[1]) : '';
+    }
+
+    function request(url, method) {
+        return fetch(url, {
+            method: method || 'GET',
+            credentials: 'same-origin',
+            headers: {
+                'Accept': 'application/json',
+                'X-XSRF-TOKEN': xsrfToken(),
+            },
+        }).then(function (response) {
+            if (! response.ok) {
+                throw new Error('Request failed with status ' + response.status);
+            }
+
+            return response.json();
+        });
+    }
+
+    function revisionUrl(blueprint, id, action) {
+        var url = blueprint.base + '/blueprint-revisions/' + encodeURIComponent(blueprint.namespace) + '/' + encodeURIComponent(blueprint.handle);
+
+        if (id === undefined) {
+            return url;
+        }
+
+        return url + '/' + encodeURIComponent(id) + (action ? '/' + action : '');
+    }
+
+    function setStatus(panel, message) {
+        panel.querySelector('[data-revision-status]').textContent = message;
+    }
+
+    function showChanges(panel, changes) {
+        var output = panel.querySelector('[data-revision-output]');
+
+        if (changes.length === 0) {
+            output.replaceChildren(element('p', { text: 'Restoring this revision would not change anything.' }));
+
+            return;
+        }
+
+        var rows = changes.map(function (change) {
+            return element('tr', {}, [
+                element('td', { text: change.path }),
+                element('td', { text: JSON.stringify(change.from) }),
+                element('td', { text: JSON.stringify(change.to) }),
+            ]);
+        });
+
+        output.replaceChildren(element('table', {}, [
+            element('thead', {}, [
+                element('tr', {}, [
+                    element('th', { text: 'Path' }),
+                    element('th', { text: 'Current' }),
+                    element('th', { text: 'Revision' }),
+                ]),
+            ]),
+            element('tbody', {}, rows),
+        ]));
+    }
+
+    function previewRevision(blueprint, id, panel) {
+        setStatus(panel, 'Loading preview…');
+
+        request(revisionUrl(blueprint, id, 'diff')).then(function (body) {
+            showChanges(panel, body.changes);
+            setStatus(panel, '');
+        }).catch(function (error) {
+            setStatus(panel, error.message);
+        });
+    }
+
+    function restoreRevision(blueprint, id, panel) {
+        setStatus(panel, 'Restoring…');
+
+        request(revisionUrl(blueprint, id, 'restore'), 'POST').then(function () {
+            // Reload so the blueprint editor shows the restored contents and
+            // cannot save its stale copy over them.
+            window.location.reload();
+        }).catch(function (error) {
+            setStatus(panel, error.message);
+        });
+    }
+
+    function revisionRow(blueprint, revision, panel) {
+        var id = String(revision.id);
+        var created = new Date(revision.created_at);
+
+        var preview = element('button', { type: 'button', 'data-revision-preview': id, text: 'Preview' });
+        var restore = element('button', { type: 'button', 'data-revision-restore': id, text: 'Restore' });
+
+        preview.addEventListener('click', function () {
+            previewRevision(blueprint, id, panel);
+        });
+
+        restore.addEventListener('click', function () {
+            restoreRevision(blueprint, id, panel);
+        });
+
+        return element('li', { 'data-revision-id': id }, [
+            element('time', { datetime: revision.created_at, text: created.toLocaleString() }),
+            element('span', { text: ' ' }),
+            preview,
+            element('span', { text: ' ' }),
+            restore,
+        ]);
+    }
+
+    function loadRevisions(blueprint, panel) {
+        var list = panel.querySelector('[data-revision-list]');
+
+        request(revisionUrl(blueprint)).then(function (body) {
+            if (body.revisions.length === 0) {
+                list.replaceChildren(element('li', { text: 'No revisions yet.' }));
+
+                return;
+            }
+
+            list.replaceChildren(...body.revisions.map(function (revision) {
+                return revisionRow(blueprint, revision, panel);
+            }));
+        }).catch(function (error) {
+            setStatus(panel, error.message);
+        });
+    }
+
+    function mount(blueprint) {
+        var panel = element('section', {
+            id: PANEL_ID,
+            'data-namespace': blueprint.namespace,
+            'data-handle': blueprint.handle,
+            style: [
+                'position: fixed',
+                'bottom: 16px',
+                'right: 16px',
+                'z-index: 9999',
+                'width: 380px',
+                'max-height: 60vh',
+                'overflow: auto',
+                'padding: 12px',
+                'background: #fff',
+                'color: #111',
+                'border: 1px solid #ccc',
+                'border-radius: 6px',
+                'box-shadow: 0 4px 16px rgba(0,0,0,.15)',
+                'font: 13px/1.4 system-ui, sans-serif',
+            ].join(';'),
+        }, [
+            element('h2', { text: 'Revisions', style: 'margin: 0 0 8px; font-size: 15px' }),
+            element('p', { 'data-revision-status': '', style: 'margin: 0 0 8px; color: #666' }),
+            element('ol', { 'data-revision-list': '', style: 'margin: 0 0 8px; padding-left: 18px' }),
+            element('div', { 'data-revision-output': '' }),
+        ]);
+
+        document.body.appendChild(panel);
+        loadRevisions(blueprint, panel);
+    }
+
+    var mounted = null;
+
+    // The CP navigates client-side, so re-check the URL on a timer and
+    // mount or remove the panel as the editor moves between pages.
+    function sync() {
+        var blueprint = currentBlueprint();
+        var key = blueprint ? blueprint.namespace + '/' + blueprint.handle : null;
+
+        if (key === mounted) {
+            return;
+        }
+
+        var existing = document.getElementById(PANEL_ID);
+
+        if (existing) {
+            existing.remove();
+        }
+
+        mounted = key;
+
+        if (blueprint) {
+            mount(blueprint);
+        }
+    }
+
+    sync();
+    setInterval(sync, 500);
+})();
