new file mode 100644
index 0000000..c15d73a
--- /dev/null
+++ b/app/Http/Controllers/BlueprintRevisionController.php
@@ -0,0 +1,75 @@
+<?php
+
+namespace App\Http\Controllers;
+
+use App\Models\BlueprintRevision;
+use App\Support\BlueprintDiff;
+use Illuminate\Database\Eloquent\ModelNotFoundException;
+use Illuminate\Http\JsonResponse;
+use Statamic\Eloquent\Fields\BlueprintModel;
+use Statamic\Facades\Blink;
+
+class BlueprintRevisionController extends Controller
+{
+    public function index(string $namespace, string $handle): JsonResponse
+    {
+        $revisions = BlueprintRevision::query()
+            ->forBlueprint($namespace, $handle)
+            ->orderByDesc('id')
+            ->get()
+            ->map(fn (BlueprintRevision $revision) => [
+                'id' => $revision->id,
+                'created_at' => $revision->created_at->toIso8601String(),
+            ])
+            ->values();
+
+        return response()->json(['revisions' => $revisions]);
+    }
+
+    public function diff(string $namespace, string $handle, string $id): JsonResponse
+    {
+        $revision = $this->revision($namespace, $handle, $id);
+
+        $current = BlueprintModel::query()
+            ->where('namespace', $namespace)
+            ->where('handle', $handle)
+            ->first();
+
+        return response()->json([
+            'changes' => BlueprintDiff::between($current?->data ?? [], $revision->data),
+        ]);
+    }
+
+    public function restore(string $namespace, string $handle, string $id): JsonResponse
+    {
+        $revision = $this->revision($namespace, $handle, $id);
+
+        $blueprint = BlueprintModel::firstOrNew(['namespace' => $namespace, 'handle' => $handle]);
+        $blueprint->data = $revision->data;
+
+        // Saving through the blueprint model fires the revision observer, so the
+        // restore is recorded as its own revision and can be undone the same way.
+        $blueprint->save();
+
+        // Statamic caches blueprints per request in Blink. The repository clears
+        // these on its own saves, but this write bypasses it, so clear them here.
+        foreach (['blueprints.found', 'blueprints.from-file', 'blueprints.paths-in-namespace'] as $store) {
+            Blink::store($store)->flush();
+        }
+
+        return response()->json(['restored' => true]);
+    }
+
+    private function revision(string $namespace, string $handle, string $id): BlueprintRevision
+    {
+        $revision = BlueprintRevision::query()
+            ->forBlueprint($namespace, $handle)
+            ->find($id);
+
+        if (! $revision) {
+            throw new ModelNotFoundException;
+        }
+
+        return $revision;
+    }
+}
diff --git a/app/Models/BlueprintRevision.php b/app/Models/BlueprintRevision.php
new file mode 100644
index 0000000..f274ddc
--- /dev/null
+++ b/app/Models/BlueprintRevision.php
@@ -0,0 +1,37 @@
+<?php
+
+namespace App\Models;
+
+use Illuminate\Database\Eloquent\Attributes\Fillable;
+use Illuminate\Database\Eloquent\Builder;
+use Illuminate\Database\Eloquent\Model;
+
+#[Fillable(['namespace', 'handle', 'data'])]
+class BlueprintRevision extends Model
+{
+    /**
+     * Get the attributes that should be cast.
+     *
+     * @return array<string, string>
+     */
+    protected function casts(): array
+    {
+        return [
+            'data' => 'array',
+        ];
+    }
+
+    /**
+     * Scope revisions to a single blueprint.
+     */
+    public function scopeForBlueprint(Builder $query, ?string $namespace, string $handle): Builder
+    {
+        return $query
+            ->when(
+                $namespace === null,
+                fn (Builder $query) => $query->whereNull('namespace'),
+                fn (Builder $query) => $query->where('namespace', $namespace),
+            )
+            ->where('handle', $handle);
+    }
+}
