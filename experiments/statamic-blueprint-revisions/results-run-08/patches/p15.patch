@@ -0,0 +1,22 @@
+<?php
+
+namespace App\Observers;
+
+use App\Models\BlueprintRevision;
+use Statamic\Eloquent\Fields\BlueprintModel;
+
+class BlueprintRevisionObserver
+{
+    /**
+     * Snapshot the blueprint's stored contents after every save, including
+     * saves made by restoring an earlier revision.
+     */
+    public function saved(BlueprintModel $blueprint): void
+    {
+        BlueprintRevision::create([
+            'namespace' => $blueprint->namespace,
+            'handle' => $blueprint->handle,
+            'data' => $blueprint->data,
+        ]);
+    }
+}
