diff --git a/tests/Feature/BlueprintRevisionsTest.php b/tests/Feature/BlueprintRevisionsTest.php
new file mode 100644
index 0000000..b55e2c8
--- /dev/null
+++ b/tests/Feature/BlueprintRevisionsTest.php
@@ -0,0 +1,146 @@
+<?php
+
+namespace Tests\Feature;
+
+use App\Models\BlueprintRevision;
+use Statamic\Facades\Blueprint;
+use Statamic\Facades\User;
+use Statamic\Fields\Blueprint as BlueprintInstance;
+use Tests\TestCase;
+
+class BlueprintRevisionsTest extends TestCase
+{
+    private const BASE = '/cp/blueprint-revisions/collections.pages/page';
+
+    private function page(string $title, string $label = 'Title'): BlueprintInstance
+    {
+        return Blueprint::make()
+            ->setHandle('page')
+            ->setNamespace('collections.pages')
+            ->setContents([
+                'title' => $title,
+                'tabs' => [
+                    'main' => [
+                        'display' => 'Main',
+                        'sections' => [[
+                            'display' => 'Main',
+                            'fields' => [
+                                ['handle' => 'title', 'field' => ['type' => 'text', 'display' => $label]],
+                            ],
+                        ]],
+                    ],
+                ],
+            ]);
+    }
+
+    private function editor(): \Statamic\Contracts\Auth\User
+    {
+        $user = User::make()->email('editor@example.com')->set('name', 'Editor')->makeSuper();
+        $user->save();
+
+        return $user;
+    }
+
+    public function test_every_save_records_a_revision_newest_first(): void
+    {
+        $this->page('First')->save();
+        $this->page('Second')->save();
+
+        $revisions = $this->actingAs($this->editor(), 'web')
+            ->getJson(self::BASE)
+            ->assertOk()
+            ->json('revisions');
+
+        $this->assertCount(2, $revisions);
+        $this->assertGreaterThan($revisions[1]['id'], $revisions[0]['id']);
+        $this->assertSame(BlueprintRevision::query()->max('id'), $revisions[0]['id']);
+        $this->assertNotEmpty($revisions[0]['created_at']);
+    }
+
+    public function test_listing_is_empty_without_history(): void
+    {
+        $this->actingAs($this->editor(), 'web')
+            ->getJson(self::BASE)
+            ->assertOk()
+            ->assertExactJson(['revisions' => []]);
+    }
+
+    public function test_diff_lists_only_changed_paths(): void
+    {
+        $this->page('First', 'Title')->save();
+        $this->page('Second', 'Heading')->save();
+
+        $oldest = BlueprintRevision::query()->min('id');
+
+        $changes = $this->actingAs($this->editor(), 'web')
+            ->getJson(self::BASE.'/'.$oldest.'/diff')
+            ->assertOk()
+            ->json('changes');
+
+        $this->assertSame(
+            [
+                ['path' => 'title', 'from' => 'Second', 'to' => 'First'],
+                ['path' => 'tabs.main.sections.0.fields.0.field.display', 'from' => 'Heading', 'to' => 'Title'],
+            ],
+            $changes,
+        );
+    }
+
+    public function test_diff_of_identical_revision_is_empty(): void
+    {
+        $this->page('Same')->save();
+        $this->page('Same')->save();
+
+        $oldest = BlueprintRevision::query()->min('id');
+
+        $this->actingAs($this->editor(), 'web')
+            ->getJson(self::BASE.'/'.$oldest.'/diff')
+            ->assertOk()
+            ->assertExactJson(['changes' => []]);
+    }
+
+    public function test_restore_changes_contents_and_is_itself_revertible(): void
+    {
+        $this->page('First')->save();
+        $this->page('Second')->save();
+
+        $oldest = BlueprintRevision::query()->min('id');
+        $newest = BlueprintRevision::query()->max('id');
+        $user = $this->editor();
+
+        $this->actingAs($user, 'web')
+            ->postJson(self::BASE.'/'.$oldest.'/restore')
+            ->assertOk()
+            ->assertExactJson(['restored' => true]);
+
+        $this->assertSame('First', Blueprint::find('collections.pages.page')->contents()['title']);
+        $this->assertSame(3, BlueprintRevision::query()->count());
+
+        $this->actingAs($user, 'web')
+            ->postJson(self::BASE.'/'.$newest.'/restore')
+            ->assertOk();
+
+        $this->assertSame('Second', Blueprint::find('collections.pages.page')->contents()['title']);
+        $this->assertSame(4, BlueprintRevision::query()->count());
+    }
+
+    public function test_control_panel_loads_the_revisions_script(): void
+    {
+        $this->actingAs($this->editor(), 'web')
+            ->get('/cp/dashboard')
+            ->assertOk()
+            ->assertSee('js/blueprint-revisions.js', false);
+    }
+
+    public function test_unauthenticated_requests_are_rejected(): void
+    {
+        $this->page('First')->save();
+        $revision = BlueprintRevision::query()->min('id');
+
+        $this->getJson(self::BASE)->assertUnauthorized();
+        $this->getJson(self::BASE.'/'.$revision.'/diff')->assertUnauthorized();
+        $this->postJson(self::BASE.'/'.$revision.'/restore')->assertUnauthorized();
+
+        $this->assertSame(1, BlueprintRevision::query()->count());
+    }
+}
