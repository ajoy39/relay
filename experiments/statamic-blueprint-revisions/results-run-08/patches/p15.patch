index 0000000..40dea1f
--- /dev/null
+++ b/app/Support/BlueprintDiff.php
@@ -0,0 +1,46 @@
+<?php
+
+namespace App\Support;
+
+class BlueprintDiff
+{
+    /**
+     * List the leaf-level changes needed to turn $from into $to.
+     *
+     * Each change is ['path' => 'dot.path', 'from' => ..., 'to' => ...]. A key
+     * present on only one side is reported with null for the missing side.
+     * Unchanged values are omitted.
+     *
+     * @return array<int, array{path: string, from: mixed, to: mixed}>
+     */
+    public static function between(array $from, array $to, string $prefix = ''): array
+    {
+        $changes = [];
+
+        $keys = array_values(array_unique([...array_keys($from), ...array_keys($to)]));
+
+        foreach ($keys as $key) {
+            $path = $prefix === '' ? (string) $key : $prefix.'.'.$key;
+
+            $inFrom = array_key_exists($key, $from);
+            $inTo = array_key_exists($key, $to);
+
+            $fromValue = $inFrom ? $from[$key] : null;
+            $toValue = $inTo ? $to[$key] : null;
+
+            if ($inFrom && $inTo && is_array($fromValue) && is_array($toValue)) {
+                $changes = [...$changes, ...self::between($fromValue, $toValue, $path)];
+
+                continue;
+            }
+
+            if ($inFrom && $inTo && $fromValue === $toValue) {
+                continue;
+            }
+
+            $changes[] = ['path' => $path, 'from' => $fromValue, 'to' => $toValue];
+        }
+
+        return $changes;
+    }
+}
