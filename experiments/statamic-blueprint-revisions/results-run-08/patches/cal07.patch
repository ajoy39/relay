+<?php
+
+namespace App\Http\Controllers;
+
+use App\Models\BlueprintRevision;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+
+class BlueprintRevisionsController extends Controller
+{
+    public function index($namespace, $handle): JsonResponse
+    {
+        $revisions = BlueprintRevision::where('namespace', $namespace)
+            ->where('handle', $handle)
+            ->orderBy('created_at', 'desc')
+            ->get(['id', 'created_at'])
+            ->map(fn ($r) => [
+                'id' => (string) $r->id,
+                'created_at' => $r->created_at->toIso8601String(),
+            ]);
+
+        return response()->json(['revisions' => $revisions]);
+    }
+
+    public function diff($namespace, $handle, $id): JsonResponse
+    {
+        $revision = BlueprintRevision::find($id);
+
+        if (!$revision || $revision->namespace !== $namespace || $revision->handle !== $handle) {
+            return response()->json(['changes' => []], 404);
+        }
+
+        $blueprintModel = app('statamic.eloquent.blueprints.model')::where('namespace', $namespace)
+            ->where('handle', $handle)
+            ->first();
+
+        if (!$blueprintModel) {
+            return response()->json(['changes' => []]);
+        }
+
+        $changes = $this->calculateDiff($blueprintModel->data, $revision->data);
+
+        return response()->json(['changes' => $changes]);
+    }
+
+    public function restore($namespace, $handle, $id): JsonResponse
+    {
+        $revision = BlueprintRevision::find($id);
+
+        if (!$revision || $revision->namespace !== $namespace || $revision->handle !== $handle) {
+            return response()->json(['restored' => false], 404);
+        }
+
+        $blueprintModel = app('statamic.eloquent.blueprints.model')::where('namespace', $namespace)
+            ->where('handle', $handle)
+            ->first();
+
+        if (!$blueprintModel) {
+            return response()->json(['restored' => false], 404);
+        }
+
+        $blueprintModel->data = $revision->data;
+        $blueprintModel->save();
+
+        return response()->json(['restored' => true]);
+    }
+
+    private function calculateDiff(array $from, array $to): array
+    {
+        $changes = [];
+        $this->diffArray($from, $to, '', $changes);
+        return $changes;
+    }
+
+    private function diffArray(array $from, array $to, string $path, array &$changes): void
+    {
+        $allKeys = array_unique(array_merge(array_keys($from), array_keys($to)));
+
+        foreach ($allKeys as $key) {
+            $newPath = $path ? "{$path}.{$key}" : $key;
+            $fromValue = $from[$key] ?? null;
+            $toValue = $to[$key] ?? null;
+
+            if (is_array($fromValue) && is_array($toValue)) {
+                $this->diffArray($fromValue, $toValue, $newPath, $changes);
+            } elseif ($fromValue !== $toValue) {
+                $changes[] = [
+                    'path' => $newPath,
+                    'from' => $fromValue,
+                    'to' => $toValue,
+                ];
+            }
+        }
+    }
+}
