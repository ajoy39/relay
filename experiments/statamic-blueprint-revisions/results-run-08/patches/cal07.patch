+<?php
+
+namespace App\Http\Middleware;
+
+use App\Models\BlueprintRevision;
+use Closure;
+use Illuminate\Http\Request;
+
+class AddBlueprintRevisionUI
+{
+    public function handle(Request $request, Closure $next)
+    {
+        $response = $next($request);
+
+        if (! $this->shouldInjectRevisions($request)) {
+            return $response;
+        }
+
+        $matches = [];
+        if (preg_match('#/cp/fields/blueprints/collections/([^/]+)/([^/]+)/edit#', $request->path(), $matches)) {
+            $namespace = 'collections.' . $matches[1];
+            $handle = $matches[2];
+
+            $revisions = BlueprintRevision::where('namespace', $namespace)
+                ->where('handle', $handle)
+                ->orderBy('created_at', 'desc')
+                ->get(['id', 'created_at']);
+
+            if ($response->headers->get('content-type') && str_contains($response->headers->get('content-type'), 'text/html')) {
+                $html = $response->getContent();
+                $revisionHtml = $this->generateRevisionHTML($namespace, $handle, $revisions);
+                $html = str_replace('</body>', $revisionHtml . '</body>', $html);
+                $response->setContent($html);
+            }
+        }
+
+        return $response;
+    }
+
+    private function shouldInjectRevisions(Request $request): bool
+    {
+        return str_contains($request->path(), '/cp/fields/blueprints/collections/') &&
+               str_contains($request->path(), '/edit');
+    }
+
+    private function generateRevisionHTML(string $namespace, string $handle, $revisions): string
+    {
+        $revisionsJson = json_encode($revisions->map(fn ($r) => [
+            'id' => (string) $r->id,
+            'created_at' => $r->created_at->toIso8601String(),
+        ])->values());
+
+        return <<<SCRIPT
+<script>
+window.BLUEPRINT_REVISIONS_DATA = {
+    namespace: "$namespace",
+    handle: "$handle",
+    revisions: $revisionsJson
+};
+
+(function() {
+    function initRevisions() {
+        const data = window.BLUEPRINT_REVISIONS_DATA;
+        if (!data.namespace || !data.revisions.length) return;
+
+        let container = document.querySelector('[data-blueprint-revisions-section]');
+        if (!container) {
+            container = document.createElement('div');
+            container.setAttribute('data-blueprint-revisions-section', 'true');
+            container.style.cssText = 'margin-top: 2rem; padding: 1.5rem; background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 0.5rem;';
+            document.body.appendChild(container);
+        }
+
+        container.innerHTML = '';
+
+        const title = document.createElement('h3');
+        title.textContent = 'Revisions';
+        title.style.cssText = 'margin: 0 0 1rem 0; font-size: 1.125rem; font-weight: 600;';
+        container.appendChild(title);
+
+        const list = document.createElement('div');
+        list.style.cssText = 'max-height: 400px; overflow-y: auto;';
+
+        data.revisions.forEach((revision) => {
+            const row = document.createElement('div');
+            row.setAttribute('data-revision-id', revision.id);
+            row.style.cssText = 'padding: 0.75rem; border-bottom: 1px solid #e5e7eb; display: flex; justify-content: space-between; align-items: center;';
+
+            const timeEl = document.createElement('span');
+            const date = new Date(revision.created_at);
+            timeEl.textContent = date.toLocaleString();
+            timeEl.style.cssText = 'flex: 1;';
+
+            const buttonsDiv = document.createElement('div');
+            buttonsDiv.style.cssText = 'display: flex; gap: 0.5rem;';
+
+            const previewBtn = document.createElement('button');
+            previewBtn.setAttribute('data-revision-preview', revision.id);
+            previewBtn.textContent = 'Preview';
+            previewBtn.style.cssText = 'padding: 0.25rem 0.75rem; font-size: 0.875rem; background: #3b82f6; color: white; border: none; border-radius: 0.25rem; cursor: pointer;';
+            previewBtn.addEventListener('click', () => showPreview(revision.id, data.namespace, data.handle));
+
+            const restoreBtn = document.createElement('button');
+            restoreBtn.setAttribute('data-revision-restore', revision.id);
+            restoreBtn.textContent = 'Restore';
+            restoreBtn.style.cssText = 'padding: 0.25rem 0.75rem; font-size: 0.875rem; background: #10b981; color: white; border: none; border-radius: 0.25rem; cursor: pointer;';
+            restoreBtn.addEventListener('click', () => restoreRevision(revision.id, data.namespace, data.handle));
+
+            buttonsDiv.appendChild(previewBtn);
+            buttonsDiv.appendChild(restoreBtn);
+
+            row.appendChild(timeEl);
+            row.appendChild(buttonsDiv);
+            list.appendChild(row);
+        });
+
+        container.appendChild(list);
+    }
+
+    window.showRevisionPreview = function(revisionId, namespace, handle) {
+        fetch('/cp/blueprint-revisions/' + namespace + '/' + handle + '/' + revisionId + '/diff')
+            .then(r => r.json())
+            .then(data => {
+                let msg = 'Changes that would be applied:\n\n';
+                if (data.changes && data.changes.length === 0) {
+                    msg += 'No changes';
+                } else if (data.changes) {
+                    data.changes.forEach(change => {
+                        msg += change.path + '\n';
+                    });
+                }
+                alert(msg);
+            })
+            .catch(err => alert('Error: ' + err.message));
+    };
+
+    window.restoreRevisionVersion = function(revisionId, namespace, handle) {
+        if (!confirm('Restore this revision?')) return;
+
+        const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
+        fetch('/cp/blueprint-revisions/' + namespace + '/' + handle + '/' + revisionId + '/restore', {
+            method: 'POST',
+            headers: {
+                'Content-Type': 'application/json',
+                'X-CSRF-TOKEN': csrfToken || '',
+                'Accept': 'application/json',
+                'X-Requested-With': 'XMLHttpRequest'
+            }
+        })
+        .then(r => r.json())
+        .then(data => {
+            if (data.restored) {
+                window.location.reload();
+            } else {
+                alert('Failed to restore revision');
+            }
+        })
+        .catch(err => alert('Error: ' + err.message));
+    };
+
+    function showPreview(revisionId, namespace, handle) {
+        window.showRevisionPreview(revisionId, namespace, handle);
+    }
+
+    function restoreRevision(revisionId, namespace, handle) {
+        window.restoreRevisionVersion(revisionId, namespace, handle);
+    }
+
+    // Wait for page load
+    if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', initRevisions);
+    } else {
+        setTimeout(initRevisions, 100);
+    }
+})();
+</script>
+SCRIPT;
+    }
+}
