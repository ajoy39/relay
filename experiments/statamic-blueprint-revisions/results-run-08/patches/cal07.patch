+<?php
+
+namespace App\Http\Middleware;
+
+use Closure;
+use Illuminate\Http\Request;
+use Inertia\Inertia;
+
+class InjectBlueprintRevisions
+{
+    public function handle(Request $request, Closure $next)
+    {
+        Inertia::share('blueprintRevisions', function () use ($request) {
+            if (preg_match('#/cp/fields/blueprints/collections/([^/]+)/([^/]+)/edit#', $request->path(), $matches)) {
+                return [
+                    'namespace' => 'collections.' . $matches[1],
+                    'handle' => $matches[2],
+                ];
+            }
+            return null;
+        });
+
+        return $next($request);
+    }
+}
