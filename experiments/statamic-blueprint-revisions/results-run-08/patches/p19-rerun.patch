+<?php
+
+namespace Tests\Unit;
+
+use App\Support\BlueprintDiff;
+use PHPUnit\Framework\TestCase;
+
+class BlueprintDiffTest extends TestCase
+{
+    public function test_identical_data_has_no_changes(): void
+    {
+        $data = ['tabs' => ['main' => ['sections' => [['fields' => [['handle' => 'a']]]]]]];
+
+        $this->assertSame([], BlueprintDiff::between($data, $data));
+    }
+
+    public function test_ordering_keys_are_not_reported(): void
+    {
+        $from = ['tabs' => ['main' => ['__count' => 0, 'sections' => [['__count' => 0]]]]];
+        $to = ['tabs' => ['main' => ['__count' => 3, 'sections' => [['__count' => 7]]]]];
+
+        $this->assertSame([], BlueprintDiff::between($from, $to));
+    }
+
+    public function test_reports_changed_added_and_removed_values_with_dot_paths(): void
+    {
+        $from = ['hide' => true, 'tabs' => ['main' => ['display' => 'Old', 'sections' => [['fields' => []]]]]];
+        $to = ['tabs' => ['main' => ['display' => 'New', 'sections' => [['fields' => []]]]], 'order' => 2];
+
+        $this->assertSame([
+            ['path' => 'hide', 'from' => true, 'to' => null],
