+<?php
+
+namespace App\Models;
+
+use Illuminate\Database\Eloquent\Builder;
+use Statamic\Eloquent\Database\BaseModel;
+
+class BlueprintRevision extends BaseModel
+{
+    protected $guarded = [];
+
+    protected $table = 'blueprint_revisions';
+
+    protected function casts(): array
+    {
+        return [
+            'data' => 'json',
+        ];
+    }
+
+    /**
+     * Snapshot the stored contents of a blueprint row after it was saved.
+     */
+    public static function record($blueprint): void
+    {
+        static::create([
+            'namespace' => $blueprint->getAttributeValue('namespace'),
+            'handle' => $blueprint->getAttributeValue('handle'),
+            'data' => $blueprint->getAttributeValue('data'),
+        ]);
+    }
+
+    public function scopeForBlueprint(Builder $query, string $namespace, string $handle): Builder
+    {
+        return $query->where('namespace', $namespace)->where('handle', $handle);
+    }
+}
