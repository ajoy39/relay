diff --git a/public/vendor/blueprint-revisions/js/revisions.js b/public/vendor/blueprint-revisions/js/revisions.js
new file mode 100644
index 0000000..5162d47
--- /dev/null
+++ b/public/vendor/blueprint-revisions/js/revisions.js
@@ -0,0 +1,185 @@
+// Adds a revision history panel to the CP blueprint edit page.
+// Plain JS so it needs no build step; the CP is Vue, so the panel is
+// re-attached whenever the edit page is rendered.
+(function () {
+    const SECTION_ID = 'blueprint-revisions';
+    const EDIT_PATH = /^(.*)\/fields\/blueprints\/(.+)\/edit\/?$/;
+    let renderedKey = null;
+
+    function editPageInfo() {
+        const match = window.location.pathname.match(EDIT_PATH);
+
+        if (! match) {
+            return null;
+        }
+
+        const segments = match[2].split('/').filter(Boolean);
+        const handle = segments.pop();
+
+        return { base: match[1], namespace: segments.join('.'), handle };
+    }
+
+    function sync() {
+        const info = editPageInfo();
+        const host = document.getElementById('main-content');
+        const existing = document.getElementById(SECTION_ID);
+
+        if (! info || ! host) {
+            if (existing) {
+                existing.remove();
+            }
+
+            renderedKey = null;
+
+            return;
+        }
+
+        const key = [info.base, info.namespace, info.handle].join('|');
+
+        if (existing && renderedKey === key && host.contains(existing)) {
+            return;
+        }
+
+        if (existing) {
+            existing.remove();
+        }
+
+        renderedKey = key;
+        render(host, info);
+    }
+
+    function render(host, info) {
+        const section = el('section', { id: SECTION_ID, class: 'card p-4 mt-4' }, [
+            el('h2', { class: 'mb-2' }, ['Revisions']),
+            el('p', { 'data-revision-status': '', class: 'text-sm mb-2' }, ['Loading revisions…']),
+            el('ul', { 'data-revision-list': '', class: 'mb-4' }),
+            el('div', { 'data-revision-changes': '' }),
+        ]);
+
+        section.addEventListener('click', (event) => {
+            const button = event.target.closest('[data-revision-preview], [data-revision-restore]');
+
+            if (! button || ! section.contains(button)) {
+                return;
+            }
+
+            if (button.hasAttribute('data-revision-preview')) {
+                previewRevision(info, section, button.getAttribute('data-revision-preview'));
+            } else {
+                restoreRevision(info, section, button.getAttribute('data-revision-restore'));
+            }
+        });
+
+        host.appendChild(section);
+        loadRevisions(info, section);
+    }
+
+    async function loadRevisions(info, section) {
+        const status = section.querySelector('[data-revision-status]');
+        const list = section.querySelector('[data-revision-list]');
+
+        try {
+            const { revisions } = await request(info, '');
+
+            list.replaceChildren();
+            status.textContent = revisions.length ? '' : 'No revisions yet.';
+
+            revisions.forEach((revision) => list.append(revisionRow(revision)));
+        } catch (error) {
+            status.textContent = `Could not load revisions (${error.message}).`;
+        }
+    }
+
+    function revisionRow(revision) {
+        const id = String(revision.id);
+        const date = new Date(revision.created_at);
+
+        return el('li', { 'data-revision-id': id, class: 'flex items-center gap-2 py-1' }, [
+            el('time', { datetime: revision.created_at, class: 'flex-1' }, [date.toLocaleString()]),
+            el('button', { type: 'button', class: 'btn', 'data-revision-preview': id }, ['Preview']),
+            el('button', { type: 'button', class: 'btn', 'data-revision-restore': id }, ['Restore']),
+        ]);
+    }
+
+    async function previewRevision(info, section, id) {
+        const output = section.querySelector('[data-revision-changes]');
+
+        output.replaceChildren(el('p', { class: 'text-sm' }, ['Loading changes…']));
+
+        try {
+            const { changes } = await request(info, `/${id}/diff`);
+
+            output.replaceChildren(changes.length ? changesTable(id, changes) : el('p', { class: 'text-sm' }, [
+                `Restoring revision ${id} would not change anything.`,
+            ]));
+        } catch (error) {
+            output.replaceChildren(el('p', { class: 'text-sm' }, [`Could not load changes (${error.message}).`]));
+        }
+    }
+
+    function changesTable(id, changes) {
+        const rows = changes.map((change) => el('tr', {}, [
+            el('td', {}, [el('code', {}, [change.path])]),
+            el('td', {}, [el('code', {}, [JSON.stringify(change.from)])]),
+            el('td', {}, [el('code', {}, [JSON.stringify(change.to)])]),
+        ]));
+
+        return el('div', {}, [
+            el('p', { class: 'text-sm mb-2' }, [`Restoring revision ${id} would change ${changes.length} ${changes.length === 1 ? 'value' : 'values'}:`]),
+            el('table', { class: 'w-full text-sm' }, [
+                el('thead', {}, [el('tr', {}, [el('th', {}, ['Path']), el('th', {}, ['Current']), el('th', {}, ['Revision'])])]),
+                el('tbody', {}, rows),
+            ]),
+        ]);
+    }
+
+    async function restoreRevision(info, section, id) {
+        const status = section.querySelector('[data-revision-status]');
+
+        status.textContent = `Restoring revision ${id}…`;
+
+        try {
+            await request(info, `/${id}/restore`, {
+                method: 'POST',
+                headers: { 'X-XSRF-TOKEN': xsrfToken() },
+            });
+
+            window.location.reload();
+        } catch (error) {
+            status.textContent = `Could not restore revision ${id} (${error.message}).`;
+        }
+    }
+
+    async function request(info, path, options = {}) {
+        const url = `${info.base}/blueprint-revisions/${encodeURIComponent(info.namespace)}/${encodeURIComponent(info.handle)}${path}`;
+        const response = await fetch(url, {
+            ...options,
+            credentials: 'same-origin',
+            headers: { Accept: 'application/json', ...(options.headers || {}) },
+        });
+
+        if (! response.ok) {
+            throw new Error(`HTTP ${response.status}`);
+        }
+
+        return response.json();
+    }
+
+    function xsrfToken() {
+        const match = document.cookie.match(/(?:^|; )XSRF-TOKEN=([^;]*)/);
+
+        return match ? decodeURIComponent(match[1]) : '';
+    }
+
+    function el(tag, attributes = {}, children = []) {
+        const node = document.createElement(tag);
+
+        Object.entries(attributes).forEach(([name, value]) => node.setAttribute(name, value));
+        node.append(...children);
+
+        return node;
+    }
+
+    new MutationObserver(sync).observe(document.body, { childList: true, subtree: true });
+    sync();
+})();
