+<?php
+
+namespace App\Http\Controllers\CP;
+
+use App\Http\Controllers\Controller;
+use App\Models\BlueprintRevision;
+use App\Support\BlueprintDiff;
+use Illuminate\Http\JsonResponse;
+use Statamic\Facades\Blink;
+
+class BlueprintRevisionController extends Controller
+{
+    public function index(string $namespace, string $handle): JsonResponse
+    {
+        $revisions = BlueprintRevision::forBlueprint($namespace, $handle)
+            ->orderByDesc('id')
+            ->get()
+            ->map(fn (BlueprintRevision $revision) => [
+                'id' => $revision->id,
+                'created_at' => $revision->created_at->toIso8601String(),
+            ])
+            ->values();
+
+        return response()->json(['revisions' => $revisions]);
+    }
+
+    public function diff(string $namespace, string $handle, int $id): JsonResponse
+    {
+        $revision = BlueprintRevision::forBlueprint($namespace, $handle)->findOrFail($id);
+
+        $changes = BlueprintDiff::between($this->currentData($namespace, $handle), $revision->data);
+
+        return response()->json(['changes' => $changes]);
+    }
+
+    public function restore(string $namespace, string $handle, int $id): JsonResponse
+    {
+        $revision = BlueprintRevision::forBlueprint($namespace, $handle)->findOrFail($id);
+
+        $blueprint = $this->blueprintModel($namespace, $handle);
+        $blueprint->data = $revision->data;
+        // Saving through the model fires the same `saved` listener as a CP edit,
+        // so the restore is recorded as a revision and can itself be undone.
+        $blueprint->save();
+
+        $this->forgetBlueprintCaches();
+
+        return response()->json(['restored' => true]);
+    }
+
+    protected function currentData(string $namespace, string $handle): array
+    {
+        return $this->blueprintModel($namespace, $handle)->getAttributeValue('data') ?? [];
+    }
+
+    protected function blueprintModel(string $namespace, string $handle)
+    {
+        return app('statamic.eloquent.blueprints.model')::firstOrNew([
+            'namespace' => $namespace,
+            'handle' => $handle,
+        ]);
+    }
+
+    /**
+     * Mirrors the Blink stores the eloquent blueprint repository reads from,
+     * so a restored blueprint is seen immediately within the same request.
+     */
+    protected function forgetBlueprintCaches(): void
+    {
+        foreach (['blueprints.found', 'blueprints.from-file', 'blueprints.paths-in-namespace'] as $store) {
+            Blink::store($store)->flush();
+        }
+    }
+}
