+<?php
+
+namespace App\Support;
+
+class BlueprintDiff
+{
+    /**
+     * Leaf-level changes needed to turn the `$from` blueprint data into `$to`.
+     *
+     * The eloquent driver adds `__count` keys to tabs, sections and fields to
+     * preserve their order. Those are bookkeeping, not editor-visible values,
+     * so they are ignored.
+     *
+     * @return array<int, array{path: string, from: mixed, to: mixed}>
+     */
+    public static function between(array $from, array $to): array
+    {
+        return static::compare(static::normalize($from), static::normalize($to));
+    }
+
+    protected static function normalize(array $data): array
+    {
+        $normalized = [];
+
+        foreach ($data as $key => $value) {
+            if ($key === '__count') {
+                continue;
+            }
+
+            $normalized[$key] = is_array($value) ? static::normalize($value) : $value;
+        }
+
+        return $normalized;
+    }
+
+    protected static function compare(array $from, array $to, string $prefix = ''): array
+    {
+        $changes = [];
+
+        foreach (array_unique([...array_keys($from), ...array_keys($to)]) as $key) {
+            $path = $prefix === '' ? (string) $key : "{$prefix}.{$key}";
+            $before = $from[$key] ?? null;
+            $after = $to[$key] ?? null;
+
+            if (is_array($before) && is_array($after)) {
+                $changes = [...$changes, ...static::compare($before, $after, $path)];
+
+                continue;
+            }
+
+            if ($before !== $after) {
+                $changes[] = ['path' => $path, 'from' => $before, 'to' => $after];
+            }
+        }
+
+        return $changes;
+    }
+}
