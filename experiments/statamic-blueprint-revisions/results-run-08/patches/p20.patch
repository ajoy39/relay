@@ -0,0 +1,67 @@
+<?php
+
+namespace App\Blueprints;
+
+use App\Models\BlueprintRevision;
+use Statamic\Eloquent\Fields\BlueprintModel;
+use Statamic\Facades\Blink;
+
+class RevisionTracker
+{
+    /**
+     * Record the blueprint's stored contents as a revision. Called after every save.
+     */
+    public static function record(BlueprintModel $blueprint): void
+    {
+        BlueprintRevision::create([
+            'namespace' => $blueprint->getAttributeValue('namespace'),
+            'handle' => $blueprint->getAttributeValue('handle'),
+            'data' => $blueprint->getAttributeValue('data'),
+        ]);
+    }
+
+    public static function history(string $namespace, string $handle)
+    {
+        return BlueprintRevision::where('namespace', $namespace)
+            ->where('handle', $handle)
+            ->orderByDesc('id')
+            ->get();
+    }
+
+    public static function find(string $namespace, string $handle, int $id): ?BlueprintRevision
+    {
+        return BlueprintRevision::where('namespace', $namespace)
+            ->where('handle', $handle)
+            ->whereKey($id)
+            ->first();
+    }
+
+    /**
+     * The blueprint's currently stored contents, or an empty array if it has been deleted.
+     */
+    public static function current(string $namespace, string $handle): array
+    {
+        $blueprint = BlueprintModel::where('namespace', $namespace)
+            ->where('handle', $handle)
+            ->first();
+
+        return $blueprint?->getAttributeValue('data') ?? [];
+    }
+
+    /**
+     * Write the revision's contents back as the blueprint's stored contents. The save
+     * goes through Eloquent, so it records a new revision and the restore can be undone.
+     */
+    public static function restore(string $namespace, string $handle, BlueprintRevision $revision): void
+    {
+        $blueprint = BlueprintModel::firstOrNew([
+            'namespace' => $namespace,
+            'handle' => $handle,
+        ]);
+
+        $blueprint->data = $revision->data;
+        $blueprint->save();
+
+        Blink::flush();
+    }
+}
