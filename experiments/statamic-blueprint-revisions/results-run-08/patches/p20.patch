+<?php
+
+namespace App\Http\Controllers\CP;
+
+use App\Blueprints\ContentDiff;
+use App\Blueprints\RevisionTracker;
+use App\Http\Controllers\Controller;
+use Illuminate\Http\JsonResponse;
+
+class BlueprintRevisionController extends Controller
+{
+    public function index(string $namespace, string $handle): JsonResponse
+    {
+        $revisions = RevisionTracker::history($namespace, $handle)->map(fn ($revision) => [
+            'id' => $revision->id,
+            'created_at' => $revision->created_at->toIso8601String(),
+        ])->values();
+
+        return response()->json(['revisions' => $revisions]);
+    }
+
+    public function diff(string $namespace, string $handle, int $id): JsonResponse
+    {
+        $revision = RevisionTracker::find($namespace, $handle, $id) ?? abort(404);
+
+        $changes = ContentDiff::between(
+            RevisionTracker::current($namespace, $handle),
+            $revision->data,
+        );
+
+        return response()->json(['changes' => $changes]);
+    }
+
+    public function restore(string $namespace, string $handle, int $id): JsonResponse
+    {
+        $revision = RevisionTracker::find($namespace, $handle, $id) ?? abort(404);
+
+        RevisionTracker::restore($namespace, $handle, $revision);
+
+        return response()->json(['restored' => true]);
+    }
+}
