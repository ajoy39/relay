@@ -0,0 +1,67 @@
+<?php
+
+namespace App\Blueprints;
+
+class ContentDiff
+{
+    /**
+     * Changes needed to turn $from into $to, as dot-path leaves. Unchanged values are omitted.
+     * A path missing on one side is reported as null on that side.
+     *
+     * @return array<int, array{path: string, from: mixed, to: mixed}>
+     */
+    public static function between(array $from, array $to): array
+    {
+        $before = self::leaves(self::normalize($from));
+        $after = self::leaves(self::normalize($to));
+
+        $changes = [];
+
+        foreach (array_keys($before + $after) as $path) {
+            $path = (string) $path;
+            $hasBefore = array_key_exists($path, $before);
+            $hasAfter = array_key_exists($path, $after);
+
+            $fromValue = $before[$path] ?? null;
+            $toValue = $after[$path] ?? null;
+
+            if ($hasBefore && $hasAfter && $fromValue === $toValue) {
+                continue;
+            }
+
+            $changes[] = ['path' => $path, 'from' => $fromValue, 'to' => $toValue];
+        }
+
+        return $changes;
+    }
+
+    /**
+     * Drop the `__count` ordering keys Statamic's eloquent driver adds to stored sections and
+     * fields. They're bookkeeping, not content; list position still shows up through the paths.
+     */
+    private static function normalize(mixed $value): mixed
+    {
+        if (! is_array($value)) {
+            return $value;
+        }
+
+        unset($value['__count']);
+
+        return array_map([self::class, 'normalize'], $value);
+    }
+
+    private static function leaves(mixed $value, string $prefix = '', array &$out = []): array
+    {
+        if (is_array($value) && $value !== []) {
+            foreach ($value as $key => $child) {
+                self::leaves($child, $prefix === '' ? (string) $key : $prefix.'.'.$key, $out);
+            }
+
+            return $out;
+        }
+
+        $out[$prefix] = $value;
+
+        return $out;
+    }
+}
