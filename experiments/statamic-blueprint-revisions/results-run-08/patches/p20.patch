diff --git a/resources/js/blueprint-revisions.js b/resources/js/blueprint-revisions.js
new file mode 100644
index 0000000..75a742e
--- /dev/null
+++ b/resources/js/blueprint-revisions.js
@@ -0,0 +1,207 @@
+// Blueprint revision history on the CP blueprint edit page.
+// Inlined into every CP page by AppServiceProvider; it only mounts on collection and taxonomy blueprint edit pages.
+(function () {
+    var PANEL_ID = 'blueprint-revisions';
+    var EDIT_PATH = /^\/cp\/fields\/blueprints\/(collections|taxonomies)\/([^/]+)\/([^/]+)\/edit\/?$/;
+
+    var current = null; // "namespace/handle" of the blueprint the panel is showing
+
+    function blueprintFromLocation() {
+        var match = EDIT_PATH.exec(window.location.pathname);
+
+        return match ? { namespace: match[1] + '.' + match[2], handle: match[3] } : null;
+    }
+
+    function endpoint(blueprint, suffix) {
+        return '/cp/blueprint-revisions/'
+            + encodeURIComponent(blueprint.namespace) + '/'
+            + encodeURIComponent(blueprint.handle)
+            + suffix;
+    }
+
+    function xsrfToken() {
+        var cookie = document.cookie.split('; ').find(function (c) {
+            return c.indexOf('XSRF-TOKEN=') === 0;
+        });
+
+        return cookie ? decodeURIComponent(cookie.substring('XSRF-TOKEN='.length)) : '';
+    }
+
+    function request(url, method) {
+        return fetch(url, {
+            method: method || 'GET',
+            credentials: 'same-origin',
+            headers: {
+                'Accept': 'application/json',
+                'X-Requested-With': 'XMLHttpRequest',
+                'X-XSRF-TOKEN': xsrfToken(),
+            },
+        }).then(function (response) {
+            if (! response.ok) {
+                throw new Error('request failed with status ' + response.status);
+            }
+
+            return response.json();
+        });
+    }
+
+    function el(tag, attributes, text) {
+        var node = document.createElement(tag);
+
+        Object.keys(attributes || {}).forEach(function (name) {
+            node.setAttribute(name, attributes[name]);
+        });
+
+        if (text !== undefined) {
+            node.textContent = text;
+        }
+
+        return node;
+    }
+
+    function setStatus(ctx, message) {
+        ctx.status.textContent = message;
+    }
+
+    function load(ctx) {
+        request(endpoint(ctx.blueprint, '')).then(function (body) {
+            ctx.list.textContent = '';
+
+            if (body.revisions.length === 0) {
+                ctx.list.appendChild(el('li', {}, 'No revisions yet.'));
+
+                return;
+            }
+
+            body.revisions.forEach(function (revision) {
+                ctx.list.appendChild(row(ctx, revision));
+            });
+        }).catch(function (error) {
+            setStatus(ctx, 'Could not load revisions: ' + error.message);
+        });
+    }
+
+    function row(ctx, revision) {
+        var item = el('li', { 'data-revision-id': String(revision.id) });
+        var details = el('div', { 'data-revision-details': String(revision.id) });
+        var preview = el('button', { type: 'button', 'data-revision-preview': String(revision.id) }, 'Preview');
+        var restore = el('button', { type: 'button', 'data-revision-restore': String(revision.id) }, 'Restore');
+
+        preview.addEventListener('click', function () {
+            showPreview(ctx, revision.id, details);
+        });
+
+        restore.addEventListener('click', function () {
+            restoreRevision(ctx, revision.id);
+        });
+
+        item.appendChild(el('time', { datetime: revision.created_at }, new Date(revision.created_at).toLocaleString()));
+        item.appendChild(document.createTextNode(' '));
+        item.appendChild(preview);
+        item.appendChild(document.createTextNode(' '));
+        item.appendChild(restore);
+        item.appendChild(details);
+
+        return item;
+    }
+
+    function showPreview(ctx, id, details) {
+        details.textContent = 'Loading...';
+
+        request(endpoint(ctx.blueprint, '/' + id + '/diff')).then(function (body) {
+            details.textContent = '';
+
+            if (body.changes.length === 0) {
+                details.appendChild(el('p', {}, 'Restoring this revision would change nothing.'));
+
+                return;
+            }
+
+            var list = el('ul');
+
+            body.changes.forEach(function (change) {
+                var item = el('li', { 'data-revision-change': change.path });
+
+                item.appendChild(el('code', {}, change.path));
+                item.appendChild(document.createTextNode(': '));
+                item.appendChild(el('code', {}, JSON.stringify(change.from)));
+                item.appendChild(document.createTextNode(' → '));
+                item.appendChild(el('code', {}, JSON.stringify(change.to)));
+                list.appendChild(item);
+            });
+
+            details.appendChild(el('p', {}, body.changes.length + ' field path(s) would change:'));
+            details.appendChild(list);
+        }).catch(function (error) {
+            details.textContent = 'Could not load preview: ' + error.message;
+        });
+    }
+
+    function restoreRevision(ctx, id) {
+        setStatus(ctx, 'Restoring revision ' + id + '...');
+
+        request(endpoint(ctx.blueprint, '/' + id + '/restore'), 'POST').then(function () {
+            setStatus(ctx, 'Restored revision ' + id + '. Reload the page before editing the blueprint again, so the builder shows the restored fields.');
+            load(ctx);
+        }).catch(function (error) {
+            setStatus(ctx, 'Could not restore revision ' + id + ': ' + error.message);
+        });
+    }
+
+    function unmount() {
+        var existing = document.getElementById(PANEL_ID);
+
+        if (existing) {
+            existing.remove();
+        }
+
+        current = null;
+    }
+
+    function mount(blueprint) {
+        unmount();
+
+        var ctx = {
+            blueprint: blueprint,
+            status: el('p', { 'data-revision-status': '', role: 'status' }),
+            list: el('ul', { 'data-revision-list': '' }),
+        };
+
+        var panel = el('section', {
+            id: PANEL_ID,
+            style: 'margin: 2rem 0; padding: 1.5rem; border: 1px solid rgba(128, 128, 128, 0.3); border-radius: 0.5rem;',
+        });
+
+        panel.appendChild(el('h2', {}, 'Revisions'));
+        panel.appendChild(ctx.status);
+        panel.appendChild(ctx.list);
+
+        (document.querySelector('main') || document.body).appendChild(panel);
+
+        current = blueprint.namespace + '/' + blueprint.handle;
+        load(ctx);
+    }
+
+    function sync() {
+        var blueprint = blueprintFromLocation();
+
+        if (! blueprint) {
+            unmount();
+
+            return;
+        }
+
+        var key = blueprint.namespace + '/' + blueprint.handle;
+
+        if (key === current && document.getElementById(PANEL_ID)) {
+            return;
+        }
+
+        mount(blueprint);
+    }
+
+    // The CP is an SPA: navigation swaps the DOM without a page load, so watch for changes.
+    new MutationObserver(sync).observe(document.body, { childList: true, subtree: true });
+    window.addEventListener('popstate', sync);
+    sync();
+})();
