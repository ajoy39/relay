@@ -0,0 +1,60 @@
+<?php
+
+namespace App\Support;
+
+class ContentDiff
+{
+    /**
+     * Describe what changes when $from becomes $to, as dot-path changes.
+     *
+     * Unchanged values are omitted. A key missing on one side is compared as null.
+     * Statamic's internal `__count` ordering keys are ignored.
+     *
+     * @return array<int, array{path: string, from: mixed, to: mixed}>
+     */
+    public static function changes(array $from, array $to): array
+    {
+        return static::walk(static::withoutOrderKeys($from), static::withoutOrderKeys($to));
+    }
+
+    private static function walk(array $from, array $to, string $prefix = ''): array
+    {
+        $changes = [];
+
+        foreach (array_unique([...array_keys($from), ...array_keys($to)]) as $key) {
+            $path = $prefix === '' ? (string) $key : $prefix.'.'.$key;
+            $before = $from[$key] ?? null;
+            $after = $to[$key] ?? null;
+
+            $bothContainers = (is_array($before) || $before === null) && (is_array($after) || $after === null);
+
+            if ($bothContainers && (is_array($before) || is_array($after))) {
+                $changes = [
+                    ...$changes,
+                    ...static::walk(is_array($before) ? $before : [], is_array($after) ? $after : [], $path),
+                ];
+
+                continue;
+            }
+
+            if ($before !== $after) {
+                $changes[] = ['path' => $path, 'from' => $before, 'to' => $after];
+            }
+        }
+
+        return $changes;
+    }
+
+    private static function withoutOrderKeys(array $contents): array
+    {
+        unset($contents['__count']);
+
+        foreach ($contents as $key => $value) {
+            if (is_array($value)) {
+                $contents[$key] = static::withoutOrderKeys($value);
+            }
+        }
+
+        return $contents;
+    }
+}
