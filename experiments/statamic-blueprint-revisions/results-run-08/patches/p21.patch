+<?php
+
+namespace App\Http\Controllers;
+
+use App\Models\BlueprintRevision;
+use App\Support\ContentDiff;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Routing\Controller;
+
+class BlueprintRevisionController extends Controller
+{
+    public function index(string $namespace, string $handle): JsonResponse
+    {
+        $revisions = BlueprintRevision::forBlueprint($namespace, $handle)
+            ->latest('id')
+            ->get()
+            ->map(fn (BlueprintRevision $revision) => [
+                'id' => $revision->id,
+                'created_at' => $revision->created_at->toIso8601String(),
+            ])
+            ->values();
+
+        return response()->json(['revisions' => $revisions]);
+    }
+
+    public function diff(string $namespace, string $handle, int $id): JsonResponse
+    {
+        $revision = $this->revision($namespace, $handle, $id);
+
+        return response()->json([
+            'changes' => ContentDiff::changes($this->currentContents($namespace, $handle), $revision->data),
+        ]);
+    }
+
+    public function restore(string $namespace, string $handle, int $id): JsonResponse
+    {
+        $revision = $this->revision($namespace, $handle, $id);
+
+        $blueprint = app('statamic.eloquent.blueprints.model')::firstOrNew([
+            'namespace' => $namespace,
+            'handle' => $handle,
+        ]);
+
+        // Saving fires BlueprintObserver, which records the restored contents as a new revision.
+        $blueprint->data = $revision->data;
+        $blueprint->save();
+
+        return response()->json(['restored' => true]);
+    }
+
+    private function revision(string $namespace, string $handle, int $id): BlueprintRevision
+    {
+        return BlueprintRevision::forBlueprint($namespace, $handle)->findOrFail($id);
+    }
+
+    private function currentContents(string $namespace, string $handle): array
+    {
+        $blueprint = app('statamic.eloquent.blueprints.model')::where('namespace', $namespace)
+            ->where('handle', $handle)
+            ->first();
+
+        return $blueprint?->getAttributeValue('data') ?? [];
+    }
+}
