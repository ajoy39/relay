diff --git a/resources/js/blueprint-revisions.js b/resources/js/blueprint-revisions.js
new file mode 100644
index 0000000..5e53959
--- /dev/null
+++ b/resources/js/blueprint-revisions.js
@@ -0,0 +1,160 @@
+(function () {
+    const PAGE = /^\/cp\/fields\/blueprints\/(collections|taxonomies)\/([^/]+)\/([^/]+)\/edit\/?$/;
+    const API = '/cp/blueprint-revisions/';
+
+    let panel = null;
+
+    const style = document.createElement('style');
+    style.textContent = `
+        #blueprint-revisions { position: fixed; right: 1rem; bottom: 1rem; width: 380px; max-height: 70vh; overflow: auto; z-index: 1000;
+            background: #fff; color: #111; border: 1px solid #ccd; border-radius: 6px; box-shadow: 0 6px 24px rgba(0,0,0,.2);
+            padding: 12px 14px; font: 13px/1.4 system-ui, sans-serif; }
+        #blueprint-revisions h2 { margin: 0 0 8px; font-size: 15px; font-weight: 600; }
+        #blueprint-revisions ol { list-style: none; margin: 0; padding: 0; }
+        #blueprint-revisions li { border-top: 1px solid #eee; padding: 8px 0; }
+        #blueprint-revisions button { margin-right: 6px; padding: 2px 8px; border: 1px solid #aab; border-radius: 4px; background: #f5f5fa; cursor: pointer; }
+        #blueprint-revisions table { width: 100%; border-collapse: collapse; margin-top: 6px; font-size: 12px; }
+        #blueprint-revisions td { border-top: 1px solid #eee; padding: 3px 4px; vertical-align: top; word-break: break-all; }
+        #blueprint-revisions .muted { color: #667; }
+    `;
+    document.head.appendChild(style);
+
+    function el(tag, attrs = {}, children = []) {
+        const node = document.createElement(tag);
+        Object.entries(attrs).forEach(([key, value]) => {
+            if (key === 'text') node.textContent = value;
+            else node.setAttribute(key, value);
+        });
+        children.forEach((child) => node.appendChild(child));
+        return node;
+    }
+
+    function xsrfToken() {
+        const match = document.cookie.match(/(?:^|; )XSRF-TOKEN=([^;]*)/);
+
+        return match ? decodeURIComponent(match[1]) : '';
+    }
+
+    function request(url, method = 'GET') {
+        return fetch(url, {
+            method,
+            credentials: 'same-origin',
+            headers: { Accept: 'application/json', 'X-XSRF-TOKEN': xsrfToken() },
+        }).then((response) => {
+            if (!response.ok) throw new Error(`Request failed (${response.status})`);
+
+            return response.json();
+        });
+    }
+
+    function renderDiff(container, changes) {
+        container.replaceChildren();
+
+        if (changes.length === 0) {
+            container.appendChild(el('p', { class: 'muted', text: 'No changes. This revision matches the current blueprint.' }));
+
+            return;
+        }
+
+        const rows = changes.map((change) => el('tr', {}, [
+            el('td', { text: change.path }),
+            el('td', { text: JSON.stringify(change.from) }),
+            el('td', { text: JSON.stringify(change.to) }),
+        ]));
+
+        container.appendChild(el('table', {}, [
+            el('tr', {}, [el('td', { text: 'Path' }), el('td', { text: 'Current' }), el('td', { text: 'Restored' })]),
+            ...rows,
+        ]));
+    }
+
+    function renderRevisions(base, revisions) {
+        const list = panel.querySelector('ol');
+        list.replaceChildren();
+
+        if (revisions.length === 0) {
+            panel.querySelector('.empty').hidden = false;
+
+            return;
+        }
+
+        panel.querySelector('.empty').hidden = true;
+
+        revisions.forEach((revision) => {
+            const id = String(revision.id);
+            const time = new Date(revision.created_at);
+
+            const preview = el('button', { type: 'button', 'data-revision-preview': id, text: 'Preview' });
+            const restore = el('button', { type: 'button', 'data-revision-restore': id, text: 'Restore' });
+            const diff = el('div', { class: 'diff', 'data-revision-diff': id, hidden: '' });
+
+            preview.addEventListener('click', () => {
+                diff.hidden = false;
+                diff.replaceChildren(el('p', { class: 'muted', text: 'Loading…' }));
+                request(`${base}/${id}/diff`)
+                    .then((data) => renderDiff(diff, data.changes))
+                    .catch((error) => diff.replaceChildren(el('p', { text: error.message })));
+            });
+
+            restore.addEventListener('click', () => {
+                if (!window.confirm('Restore this revision? The current blueprint is saved as a new revision first, so this can be undone.')) return;
+
+                request(`${base}/${id}/restore`, 'POST')
+                    .then(() => window.location.reload())
+                    .catch((error) => window.alert(error.message));
+            });
+
+            list.appendChild(el('li', { 'data-revision-id': id }, [
+                el('time', { datetime: revision.created_at, text: time.toLocaleString() }),
+                el('div', {}, [preview, restore]),
+                diff,
+            ]));
+        });
+    }
+
+    function refresh() {
+        const match = window.location.pathname.match(PAGE);
+
+        if (!match) {
+            panel?.remove();
+            panel = null;
+
+            return;
+        }
+
+        const namespace = `${match[1]}.${match[2]}`;
+        const base = `${API}${namespace}/${match[3]}`;
+
+        if (!panel) {
+            panel = el('section', { id: 'blueprint-revisions' }, [
+                el('h2', { text: 'Revisions' }),
+                el('p', { class: 'empty muted', text: 'No revisions yet.', hidden: '' }),
+                el('ol'),
+            ]);
+            document.body.appendChild(panel);
+        }
+
+        request(base)
+            .then((data) => renderRevisions(base, data.revisions))
+            .catch((error) => {
+                panel.querySelector('ol').replaceChildren();
+                panel.querySelector('.empty').hidden = false;
+                panel.querySelector('.empty').textContent = error.message;
+            });
+    }
+
+    // Blueprint saves are sent with axios PATCH. Refresh once they finish so the new revision shows up.
+    const open = XMLHttpRequest.prototype.open;
+    XMLHttpRequest.prototype.open = function (method, url, ...rest) {
+        if (String(method).toUpperCase() === 'PATCH' && String(url).includes('/fields/blueprints/')) {
+            this.addEventListener('loadend', () => refresh());
+        }
+
+        return open.call(this, method, url, ...rest);
+    };
+
+    // Inertia navigations do not reload this script, so re-check the page after each one.
+    document.addEventListener('inertia:success', refresh);
+
+    refresh();
+})();
