+<?php
+
+namespace App\Observers;
+
+use App\Models\BlueprintRevision;
+use Illuminate\Database\Eloquent\Model;
+
+class BlueprintObserver
+{
+    /**
+     * Every stored blueprint save is recorded, including restores, so a restore can itself be undone.
+     */
+    public function saved(Model $blueprint): void
+    {
+        BlueprintRevision::create([
+            'namespace' => $blueprint->getAttributeValue('namespace'),
+            'handle' => $blueprint->getAttributeValue('handle'),
+            'data' => $blueprint->getAttributeValue('data'),
+        ]);
+    }
+}
