new file mode 100644
index 0000000..f45eaf2
--- /dev/null
+++ b/resources/js/blueprint-revisions.js
@@ -0,0 +1,126 @@
+// Revision history panel for the blueprint edit page. Injected into every CP page
+// by AppServiceProvider; it does nothing anywhere else.
+(function () {
+    var match = window.location.pathname.match(/^\/cp\/fields\/blueprints\/([^\/]+)\/(.+)\/edit\/?$/);
+    if (!match) return;
+
+    var segments = match[2].split('/');
+    var handle = segments.pop();
+    var namespace = [match[1]].concat(segments).join('.');
+    var base = '/cp/blueprint-revisions/' + encodeURIComponent(namespace) + '/' + encodeURIComponent(handle);
+
+    function el(tag, attrs, text) {
+        var node = document.createElement(tag);
+        Object.keys(attrs || {}).forEach(function (name) {
+            node.setAttribute(name, attrs[name]);
+        });
+        if (text !== undefined) node.textContent = text;
+        return node;
+    }
+
+    function request(url, method) {
+        var headers = { Accept: 'application/json', 'X-Requested-With': 'XMLHttpRequest' };
+        var meta = document.querySelector('meta[name="csrf-token"]');
+        if (meta) headers['X-CSRF-TOKEN'] = meta.getAttribute('content');
+
+        return fetch(url, { method: method || 'GET', headers: headers, credentials: 'same-origin' })
+            .then(function (res) {
+                return res.json().catch(function () { return {}; }).then(function (body) {
+                    if (!res.ok) throw new Error(body.message || 'HTTP ' + res.status);
+                    return body;
+                });
+            });
+    }
+
+    function init() {
+        var panel = el('section', {
+            id: 'blueprint-revisions',
+            style: 'position:fixed;bottom:0;right:0;width:440px;max-height:60vh;overflow:auto;background:#fff;color:#111;border:1px solid #ccc;border-radius:8px 8px 0 0;padding:16px;z-index:1000;font:13px/1.4 system-ui,sans-serif;box-shadow:0 0 12px rgba(0,0,0,.15)'
+        });
+        panel.appendChild(el('h2', { style: 'font-size:16px;margin:0 0 8px' }, 'Revisions'));
+
+        var list = el('ul', { style: 'list-style:none;padding:0;margin:0 0 12px' });
+        var output = el('div');
+        panel.appendChild(list);
+        panel.appendChild(output);
+        document.body.appendChild(panel);
+
+        function showError(err) {
+            output.textContent = '';
+            output.appendChild(el('p', { style: 'color:#b00020' }, 'Error: ' + err.message));
+        }
+
+        function button(label, attr, id, onClick) {
+            var btn = el('button', { type: 'button', style: 'margin-left:8px' });
+            btn.setAttribute(attr, String(id));
+            btn.textContent = label;
+            btn.addEventListener('click', function () { onClick(id); });
+            return btn;
+        }
+
+        function preview(id) {
+            output.textContent = 'Loading…';
+            return request(base + '/' + encodeURIComponent(id) + '/diff').then(function (body) {
+                output.textContent = '';
+                if (!body.changes.length) {
+                    output.appendChild(el('p', {}, 'Restoring revision ' + id + ' would change nothing.'));
+                    return;
+                }
+
+                output.appendChild(el('p', {}, 'Restoring this revision would change ' + body.changes.length + ' value(s):'));
+                var table = el('table', { style: 'width:100%;border-collapse:collapse' });
+                var head = el('tr');
+                ['Path', 'Current', 'Revision'].forEach(function (title) {
+                    head.appendChild(el('th', { style: 'text-align:left;border-bottom:1px solid #ddd' }, title));
+                });
+                table.appendChild(head);
+                body.changes.forEach(function (change) {
+                    var row = el('tr');
+                    row.appendChild(el('td', { style: 'vertical-align:top;font-family:monospace' }, change.path));
+                    row.appendChild(el('td', { style: 'vertical-align:top;font-family:monospace' }, JSON.stringify(change.from)));
+                    row.appendChild(el('td', { style: 'vertical-align:top;font-family:monospace' }, JSON.stringify(change.to)));
+                    table.appendChild(row);
+                });
+                output.appendChild(table);
+            }).catch(showError);
+        }
+
+        function restore(id) {
+            output.textContent = 'Restoring…';
+            return request(base + '/' + encodeURIComponent(id) + '/restore', 'POST').then(function () {
+                // Reload so the editor shows the restored contents instead of its stale form state.
+                window.location.reload();
+            }).catch(showError);
+        }
+
+        function loadRevisions() {
+            return request(base).then(function (body) {
+                list.textContent = '';
+                if (!body.revisions.length) {
+                    list.appendChild(el('li', {}, 'No revisions yet.'));
+                    return;
+                }
+
+                body.revisions.forEach(function (revision) {
+                    var row = el('li', { style: 'padding:4px 0;border-bottom:1px solid #eee' });
+                    row.setAttribute('data-revision-id', String(revision.id));
+                    row.appendChild(el('span', {}, new Date(revision.created_at).toLocaleString()));
+
+                    var previewBtn = button('Preview', 'data-revision-preview', revision.id, preview);
+                    var restoreBtn = button('Restore', 'data-revision-restore', revision.id, restore);
+                    row.appendChild(previewBtn);
+                    row.appendChild(restoreBtn);
+                    list.appendChild(row);
+                });
+            }).catch(showError);
+        }
+
+        loadRevisions();
+    }
+
+    if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', init);
+    } else {
+        init();
+    }
+})();
