+<?php
+
+namespace App\Http\Controllers;
+
+use App\Blueprints\RevisionDiff;
+use App\Models\BlueprintRevision;
+use Illuminate\Http\JsonResponse;
+use Statamic\Eloquent\Fields\BlueprintModel;
+use Statamic\Facades\Blink;
+
+class BlueprintRevisionController extends Controller
+{
+    public function index(string $namespace, string $handle): JsonResponse
+    {
+        $revisions = $this->revisionsFor($namespace, $handle)
+            ->get()
+            ->map(fn (BlueprintRevision $revision) => [
+                'id' => $revision->id,
+                'created_at' => $revision->created_at->toIso8601String(),
+            ])
+            ->values();
+
+        return response()->json(['revisions' => $revisions]);
+    }
+
+    public function diff(string $namespace, string $handle, int $id): JsonResponse
+    {
+        $revision = $this->findRevision($namespace, $handle, $id);
+        $current = $this->currentData($namespace, $handle);
+
+        return response()->json([
+            'changes' => RevisionDiff::between($current, $revision->data),
+        ]);
+    }
+
+    public function restore(string $namespace, string $handle, int $id): JsonResponse
+    {
+        $revision = $this->findRevision($namespace, $handle, $id);
+
+        $blueprint = BlueprintModel::firstOrNew([
+            'namespace' => $namespace,
+            'handle' => $handle,
+        ]);
+
+        // Saving goes through the model's saved event, which records the restore itself as a revision.
+        $blueprint->data = $revision->data;
+        $blueprint->save();
+
+        // The repository caches blueprints per request. Clear them so nothing reads the pre-restore contents.
+        foreach (['blueprints.found', 'blueprints.from-file', 'blueprints.paths-in-namespace'] as $store) {
+            Blink::store($store)->flush();
+        }
+
+        return response()->json(['restored' => true]);
+    }
+
+    private function revisionsFor(string $namespace, string $handle)
+    {
+        return BlueprintRevision::query()
+            ->where('namespace', $namespace)
+            ->where('handle', $handle)
+            ->orderByDesc('id');
+    }
+
+    private function findRevision(string $namespace, string $handle, int $id): BlueprintRevision
+    {
+        return $this->revisionsFor($namespace, $handle)
+            ->whereKey($id)
+            ->firstOrFail();
+    }
+
+    private function currentData(string $namespace, string $handle): array
+    {
+        $blueprint = BlueprintModel::query()
+            ->where('namespace', $namespace)
+            ->where('handle', $handle)
+            ->first();
+
+        return $blueprint?->getAttributeValue('data') ?? [];
+    }
+}
