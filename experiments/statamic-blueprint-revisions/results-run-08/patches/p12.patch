+<?php
+
+namespace App\Blueprints;
+
+/**
+ * Flat list of value changes between two blueprint data arrays.
+ *
+ * `__count` is Statamic's sort-order bookkeeping, not content, so it is
+ * stripped before comparing. Otherwise inserting a field would show up as a
+ * change to every field after it.
+ */
+class RevisionDiff
+{
+    /**
+     * @return list<array{path: string, from: mixed, to: mixed}>
+     */
+    public static function between(array $current, array $revision): array
+    {
+        $changes = [];
+
+        self::walk(self::normalize($current), self::normalize($revision), [], $changes);
+
+        return $changes;
+    }
+
+    private static function walk(mixed $from, mixed $to, array $path, array &$changes): void
+    {
+        if (is_array($from) && is_array($to)) {
+            foreach (array_unique([...array_keys($from), ...array_keys($to)]) as $key) {
+                $childPath = [...$path, $key];
+
+                if (! array_key_exists($key, $from) || ! array_key_exists($key, $to)) {
+                    $changes[] = [
+                        'path' => implode('.', $childPath),
+                        'from' => $from[$key] ?? null,
+                        'to' => $to[$key] ?? null,
+                    ];
+
+                    continue;
+                }
+
+                self::walk($from[$key], $to[$key], $childPath, $changes);
+            }
+
+            return;
+        }
+
+        if ($from !== $to) {
+            $changes[] = [
+                'path' => implode('.', $path),
+                'from' => $from,
+                'to' => $to,
+            ];
+        }
+    }
+
+    private static function normalize(array $data): array
+    {
+        unset($data['__count']);
+
+        foreach ($data as $key => $value) {
+            if (is_array($value)) {
+                $data[$key] = self::normalize($value);
+            }
+        }
+
+        return $data;
+    }
+}
