@@ -0,0 +1,174 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use App\Models\BlueprintRevision;
+use Closure;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+
+class InjectBlueprintRevisionsUI
+{
+    public function handle(Request $request, Closure $next): Response
+    {
+        $response = $next($request);
+
+        // Only inject for CP pages
+        if (!str_starts_with($request->path(), 'cp/')) {
+            return $response;
+        }
+
+        if (!$response->headers->has('Content-Type') || stripos($response->headers->get('Content-Type'), 'text/html') === false) {
+            return $response;
+        }
+
+        // Only inject for successful responses
+        if ($response->getStatusCode() < 200 || $response->getStatusCode() >= 300) {
+            return $response;
+        }
+
+        $content = $response->getContent();
+        if (empty($content)) {
+            return $response;
+        }
+
+        // Read and inline the blueprint revisions script
+        $scriptFile = public_path('js/blueprint-revisions.js');
+        if (file_exists($scriptFile)) {
+            $scriptCode = file_get_contents($scriptFile);
+            $scriptTag = '<script>' . $scriptCode . '</script>';
+
+            // Try to inject before closing body, head, or at the end
+            if (stripos($content, '</body>') !== false) {
+                $content = str_replace('</body>', $scriptTag . '</body>', $content);
+            } elseif (stripos($content, '</head>') !== false) {
+                $content = str_replace('</head>', $scriptTag . '</head>', $content);
+            } else {
+                $content .= $scriptTag;
+            }
+
+            $response->setContent($content);
+        }
+
+        return $response;
+    }
+
+    private function isBlueprintEditPage(Request $request): bool
+    {
+        return preg_match('#/cp/fields/blueprints/[^/]+/[^/]+/[^/]+/edit$#', $request->path()) === 1;
+    }
+
+    private function extractBlueprintInfo(Request $request): array
+    {
+        // URL format: /cp/fields/blueprints/{type}/{name}/{handle}/edit
+        // Example: /cp/fields/blueprints/collections/pages/page/edit
+        // Namespace = type.name (e.g., collections.pages)
+        if (preg_match('#/cp/fields/blueprints/([^/]+)/([^/]+)/([^/]+)/edit$#', $request->path(), $matches)) {
+            $type = $matches[1];
+            $name = $matches[2];
+            $handle = $matches[3];
+            $namespace = $type . '.' . $name;
+            return [$namespace, $handle];
+        }
+        return [null, null];
+    }
+
+    private function generateRevisionsHTML($revisions): string
+    {
+        if ($revisions->isEmpty()) {
+            return '<div style="padding: 20px;">
+                <h3>Revisions</h3>
+                <p>No revision history available.</p>
+            </div>';
+        }
+
+        $rows = '';
+        foreach ($revisions as $revision) {
+            $rows .= sprintf(
+                '<tr data-revision-id="%s">
+                    <td>%s</td>
+                    <td>
+                        <button data-revision-preview="%s" type="button">Preview</button>
+                        <button data-revision-restore="%s" type="button">Restore</button>
+                    </td>
+                </tr>',
+                htmlspecialchars($revision->id),
+                htmlspecialchars($revision->created_at->toIso8601String()),
+                htmlspecialchars($revision->id),
+                htmlspecialchars($revision->id)
+            );
+        }
+
+        return '<div style="padding: 20px; border-top: 1px solid #ddd; margin-top: 20px;">
+            <h3>Revisions</h3>
+            <table style="width: 100%; border-collapse: collapse;">
+                <thead>
+                    <tr>
+                        <th style="text-align: left; padding: 8px; border-bottom: 1px solid #ddd;">Created</th>
+                        <th style="text-align: left; padding: 8px; border-bottom: 1px solid #ddd;">Actions</th>
+                    </tr>
+                </thead>
+                <tbody>
+                    ' . $rows . '
+                </tbody>
+            </table>
+            <div id="revision-preview-modal" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 1000;">
+                <div style="background: white; margin: 50px auto; padding: 20px; max-width: 600px; border-radius: 4px;">
+                    <h4>Preview Changes</h4>
+                    <div id="preview-content"></div>
+                    <button onclick="document.getElementById(\'revision-preview-modal\').style.display=\'none\'" type="button">Close</button>
+                </div>
+            </div>
+            <script>
+                document.addEventListener("DOMContentLoaded", function() {
+                    const pathMatch = location.pathname.match(/\/cp\/fields\/blueprints\/(.+?)\/(.+?)\/edit$/);
+                    const collection = pathMatch ? pathMatch[1] : "";
+                    const handle = pathMatch ? pathMatch[2] : "";
+                    const namespace = "collections." + collection;
+                    const apiBase = "/cp/blueprint-revisions/" + encodeURIComponent(namespace) + "/" + encodeURIComponent(handle);
+
+                    Array.from(document.querySelectorAll("[data-revision-preview]")).forEach(btn => {
+                        btn.addEventListener("click", async function(e) {
+                            e.preventDefault();
+                            const id = this.getAttribute("data-revision-preview");
+                            const url = apiBase + "/" + encodeURIComponent(id) + "/diff";
+                            const res = await fetch(url);
+                            const data = await res.json();
+                            const content = document.getElementById("preview-content");
+                            if (data.changes && data.changes.length > 0) {
+                                content.innerHTML = "<ul>" + data.changes.map(c =>
+                                    "<li><strong>" + c.path + "</strong>: from " + JSON.stringify(c.from) + " to " + JSON.stringify(c.to) + "</li>"
+                                ).join("") + "</ul>";
+                            } else {
+                                content.innerHTML = "<p>No changes</p>";
+                            }
+                            document.getElementById("revision-preview-modal").style.display = "block";
+                        });
+                    });
+
+                    Array.from(document.querySelectorAll("[data-revision-restore]")).forEach(btn => {
+                        btn.addEventListener("click", async function(e) {
+                            e.preventDefault();
+                            if (!confirm("Restore this revision?")) return;
+                            const id = this.getAttribute("data-revision-restore");
+                            const url = apiBase + "/" + encodeURIComponent(id) + "/restore";
+                            const res = await fetch(url, { method: "POST", headers: { "X-CSRF-TOKEN": getCSRFToken() } });
+                            if (res.ok) {
+                                const data = await res.json();
+                                if (data.restored) {
+                                    alert("Revision restored successfully");
+                                    location.reload();
+                                }
+                            }
+                        });
+                    });
+                });
+
+                function getCSRFToken() {
+                    return document.querySelector("meta[name=csrf-token]")?.getAttribute("content") ||
+                           document.cookie.split("; ").find(row => row.startsWith("XSRF-TOKEN="))?.split("=")[1] || "";
+                }
+            </script>
+        </div>';
+    }
+}
