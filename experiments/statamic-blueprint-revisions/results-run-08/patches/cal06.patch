+<?php
+
+namespace App\Observers;
+
+use App\Models\BlueprintRevision;
+use Statamic\Eloquent\Fields\BlueprintModel;
+
+class BlueprintObserver
+{
+    private bool $skipRevision = false;
+
+    public function setSkipRevision(bool $skip): void
+    {
+        $this->skipRevision = $skip;
+    }
+
+    public function created(BlueprintModel $blueprint): void
+    {
+        $this->recordRevision($blueprint);
+    }
+
+    public function updated(BlueprintModel $blueprint): void
+    {
+        if (!$this->skipRevision) {
+            $this->recordRevision($blueprint);
+        }
+    }
+
+    public function deleted(BlueprintModel $blueprint): void
+    {
+        //
+    }
+
+    public function restored(BlueprintModel $blueprint): void
+    {
+        //
+    }
+
+    public function forceDeleted(BlueprintModel $blueprint): void
+    {
+        //
+    }
+
+    private function recordRevision(BlueprintModel $blueprint): void
+    {
+        BlueprintRevision::create([
+            'namespace' => $blueprint->namespace,
+            'handle' => $blueprint->handle,
+            'data' => $blueprint->data,
+        ]);
+    }
+}
