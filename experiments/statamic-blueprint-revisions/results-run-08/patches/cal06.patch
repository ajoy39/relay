+<?php
+
+namespace App\Http\Controllers;
+
+use App\Models\BlueprintRevision;
+use Illuminate\Http\JsonResponse;
+use Statamic\Eloquent\Fields\BlueprintModel;
+
+class BlueprintRevisionController extends Controller
+{
+    public function index(string $namespace, string $handle): JsonResponse
+    {
+        $revisions = BlueprintRevision::where('namespace', $namespace === 'null' ? null : $namespace)
+            ->where('handle', $handle)
+            ->orderByDesc('created_at')
+            ->select('id', 'created_at')
+            ->get();
+
+        return response()->json(['revisions' => $revisions]);
+    }
+
+    public function diff(string $namespace, string $handle, string $id): JsonResponse
+    {
+        $revision = BlueprintRevision::find($id);
+
+        if (!$revision || $revision->namespace !== ($namespace === 'null' ? null : $namespace) || $revision->handle !== $handle) {
+            return response()->json(['error' => 'Revision not found'], 404);
+        }
+
+        $blueprint = BlueprintModel::where('namespace', $revision->namespace)
+            ->where('handle', $revision->handle)
+            ->first();
+
+        if (!$blueprint) {
+            return response()->json(['error' => 'Blueprint not found'], 404);
+        }
+
+        $currentData = $blueprint->data ?? [];
+        $revisionData = $revision->data ?? [];
+
+        $changes = $this->calculateDiff($currentData, $revisionData);
+
+        return response()->json(['changes' => $changes]);
+    }
+
+    public function restore(string $namespace, string $handle, string $id): JsonResponse
+    {
+        $revision = BlueprintRevision::find($id);
+
+        if (!$revision || $revision->namespace !== ($namespace === 'null' ? null : $namespace) || $revision->handle !== $handle) {
+            return response()->json(['error' => 'Revision not found'], 404);
+        }
+
+        $blueprint = BlueprintModel::where('namespace', $revision->namespace)
+            ->where('handle', $revision->handle)
+            ->first();
+
+        if (!$blueprint) {
+            return response()->json(['error' => 'Blueprint not found'], 404);
+        }
+
+        $oldData = $blueprint->data;
+        $blueprint->data = $revision->data;
+        $blueprint->save();
+
+        // Record the restore as a new revision
+        BlueprintRevision::create([
+            'namespace' => $revision->namespace,
+            'handle' => $revision->handle,
+            'data' => $oldData,
+        ]);
+
+        return response()->json(['restored' => true]);
+    }
+
+    private function calculateDiff(array $current, array $revision): array
+    {
+        $changes = [];
+
+        $this->diffArray($current, $revision, '', $changes);
+
+        return $changes;
+    }
+
+    private function diffArray(array $current, array $revision, string $path, array &$changes): void
+    {
+        $allKeys = array_unique(array_merge(array_keys($current), array_keys($revision)));
+
+        foreach ($allKeys as $key) {
+            $currentValue = $current[$key] ?? null;
+            $revisionValue = $revision[$key] ?? null;
+
+            $newPath = $path ? "{$path}.{$key}" : $key;
+
+            if (is_array($currentValue) && is_array($revisionValue)) {
+                $this->diffArray($currentValue, $revisionValue, $newPath, $changes);
+            } elseif ($currentValue !== $revisionValue) {
+                $changes[] = [
+                    'path' => $newPath,
+                    'from' => $revisionValue,
+                    'to' => $currentValue,
+                ];
+            }
+        }
+    }
+}
