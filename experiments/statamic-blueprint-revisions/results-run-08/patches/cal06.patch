+// Inject blueprint revision history UI into the edit page
+(function() {
+    const pathMatch = window.location.pathname.match(/\/cp\/fields\/blueprints\/([^/]+)\/([^/]+)\/([^/]+)\/edit$/);
+    if (!pathMatch) return;
+
+    const type = pathMatch[1];
+    const name = pathMatch[2];
+    const handle = pathMatch[3];
+    const namespace = type + '.' + name;
+    const apiBase = '/cp/blueprint-revisions/' + encodeURIComponent(namespace) + '/' + encodeURIComponent(handle);
+
+    // Wait for the page to be ready
+    function injectRevisionUI() {
+        // Fetch revisions
+        fetch(apiBase)
+            .then(res => res.json())
+            .catch(err => {
+                console.error('Failed to fetch revisions:', err);
+                return { revisions: [] };
+            })
+            .then(data => {
+                const revisions = data.revisions || [];
+                if (revisions.length === 0) return;
+
+                // Create revision section HTML
+                let html = '<div style="padding: 20px; border-top: 1px solid #ddd; margin-top: 20px;">';
+                html += '<h3>Revisions</h3>';
+                html += '<table style="width: 100%; border-collapse: collapse;">';
+                html += '<thead><tr><th style="text-align: left; padding: 8px; border-bottom: 1px solid #ddd;">Created</th>';
+                html += '<th style="text-align: left; padding: 8px; border-bottom: 1px solid #ddd;">Actions</th></tr></thead>';
+                html += '<tbody>';
+
+                for (const rev of revisions) {
+                    html += '<tr data-revision-id="' + rev.id + '">';
+                    html += '<td style="padding: 8px;">' + new Date(rev.created_at).toISOString() + '</td>';
+                    html += '<td style="padding: 8px;"><button data-revision-preview="' + rev.id + '" type="button" style="margin-right: 8px;">Preview</button>';
+                    html += '<button data-revision-restore="' + rev.id + '" type="button">Restore</button></td>';
+                    html += '</tr>';
+                }
+
+                html += '</tbody></table>';
+                html += '<div id="revision-preview-modal" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 1000;">';
+                html += '<div style="background: white; margin: 50px auto; padding: 20px; max-width: 600px; border-radius: 4px;">';
+                html += '<h4>Preview Changes</h4><div id="preview-content"></div>';
+                html += '<button onclick="document.getElementById(\'revision-preview-modal\').style.display=\'none\'" type="button">Close</button>';
+                html += '</div></div></div>';
+
+                // Find where to inject (look for common CP sections)
+                const targets = [
+                    document.querySelector('main'),
+                    document.querySelector('[role="main"]'),
+                    document.querySelector('.content-pane'),
+                    document.body
+                ];
+
+                let injected = false;
+                for (const target of targets) {
+                    if (target) {
+                        target.insertAdjacentHTML('beforeend', html);
+                        injected = true;
+                        break;
+                    }
+                }
+
+                if (!injected) {
+                    document.body.insertAdjacentHTML('beforeend', html);
+                }
+
+                // Attach event listeners
+                document.querySelectorAll('[data-revision-preview]').forEach(btn => {
+                    btn.addEventListener('click', async function(e) {
+                        e.preventDefault();
+                        const id = this.getAttribute('data-revision-preview');
+                        const url = apiBase + '/' + encodeURIComponent(id) + '/diff';
+                        try {
+                            const res = await fetch(url);
+                            const data = await res.json();
+                            const content = document.getElementById('preview-content');
+                            if (data.changes && data.changes.length > 0) {
+                                content.innerHTML = '<ul>' + data.changes.map(c =>
+                                    '<li><strong>' + c.path + '</strong>: from ' + JSON.stringify(c.from) + ' to ' + JSON.stringify(c.to) + '</li>'
+                                ).join('') + '</ul>';
+                            } else {
+                                content.innerHTML = '<p>No changes</p>';
+                            }
+                            document.getElementById('revision-preview-modal').style.display = 'block';
+                        } catch (err) {
+                            console.error('Preview failed:', err);
+                        }
+                    });
+                });
+
+                document.querySelectorAll('[data-revision-restore]').forEach(btn => {
+                    btn.addEventListener('click', async function(e) {
+                        e.preventDefault();
+                        if (!confirm('Restore this revision?')) return;
+                        const id = this.getAttribute('data-revision-restore');
+                        const url = apiBase + '/' + encodeURIComponent(id) + '/restore';
+                        try {
+                            const res = await fetch(url, {
+                                method: 'POST',
+                                headers: {
+                                    'X-CSRF-TOKEN': getCSRFToken(),
+                                    'X-Requested-With': 'XMLHttpRequest'
+                                }
+                            });
+                            if (res.ok) {
+                                const data = await res.json();
+                                if (data.restored) {
+                                    alert('Revision restored successfully');
+                                    window.location.reload();
+                                }
+                            }
+                        } catch (err) {
+                            console.error('Restore failed:', err);
+                        }
+                    });
+                });
+            });
+    }
+
+    function getCSRFToken() {
+        return document.querySelector('meta[name=csrf-token]')?.getAttribute('content') ||
+               document.querySelector('meta[name=csrf_token]')?.getAttribute('content') ||
+               Array.from(document.querySelectorAll('input[name=_token]')).pop()?.value ||
+               '';
+    }
+
+    // Wait for the page to render
+    if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', injectRevisionUI);
+    } else {
+        // Use a small delay to ensure the page is fully rendered
+        setTimeout(injectRevisionUI, 500);
+    }
+})();
