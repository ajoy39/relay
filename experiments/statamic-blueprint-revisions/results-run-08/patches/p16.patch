+<?php
+
+namespace App\Blueprints;
+
+use App\Models\BlueprintRevision;
+use Illuminate\Support\Arr;
+
+class BlueprintRevisions
+{
+    /**
+     * Snapshot a blueprint's stored contents after it has been saved.
+     */
+    public function record($blueprint): void
+    {
+        BlueprintRevision::create([
+            'namespace' => $blueprint->getAttributeValue('namespace'),
+            'handle' => $blueprint->getAttributeValue('handle'),
+            'data' => $blueprint->getAttributeValue('data'),
+        ]);
+    }
+
+    /**
+     * @return array<int, array{id: int, created_at: string}>
+     */
+    public function history(string $namespace, string $handle): array
+    {
+        return $this->revisionsFor($namespace, $handle)
+            ->get()
+            ->map(fn (BlueprintRevision $revision) => [
+                'id' => $revision->id,
+                'created_at' => $revision->created_at->toIso8601String(),
+            ])
+            ->all();
+    }
+
+    /**
+     * Changes that restoring the revision would make, from the current
+     * blueprint contents to the revision's contents.
+     *
+     * @return array<int, array{path: string, from: mixed, to: mixed}>
+     */
+    public function diff(string $namespace, string $handle, BlueprintRevision $revision): array
+    {
+        $current = $this->flatten($this->currentData($namespace, $handle));
+        $target = $this->flatten($revision->data);
+
+        $changes = [];
+
+        foreach (array_unique([...array_keys($current), ...array_keys($target)]) as $path) {
+            $from = $current[$path] ?? null;
+            $to = $target[$path] ?? null;
+
+            if ($from !== $to) {
+                $changes[] = ['path' => (string) $path, 'from' => $from, 'to' => $to];
+            }
+        }
+
+        return $changes;
+    }
+
+    /**
+     * Write the revision's contents back over the stored blueprint. The save
+     * goes through the model, so the saved listener records this restore as
+     * a revision of its own.
+     */
+    public function restore(string $namespace, string $handle, BlueprintRevision $revision): void
+    {
+        $model = app('statamic.eloquent.blueprints.model')::firstOrNew([
+            'namespace' => $namespace,
+            'handle' => $handle,
+        ]);
+
+        $model->data = $revision->data;
+        $model->save();
+    }
+
+    /**
+     * Look a revision up only within its own blueprint, so an id from one
+     * blueprint cannot be restored or diffed under another.
+     */
+    public function findFor(string $namespace, string $handle, int $id): BlueprintRevision
+    {
+        return $this->revisionsFor($namespace, $handle)->findOrFail($id);
+    }
+
+    private function revisionsFor(string $namespace, string $handle)
+    {
+        return BlueprintRevision::query()
+            ->where('namespace', $namespace)
+            ->where('handle', $handle)
+            ->orderByDesc('id');
+    }
+
+    private function currentData(string $namespace, string $handle): array
+    {
+        $blueprint = app('statamic.eloquent.blueprints.model')::query()
+            ->where('namespace', $namespace)
+            ->where('handle', $handle)
+            ->first();
+
+        return $blueprint?->getAttributeValue('data') ?? [];
+    }
+
+    /**
+     * Flatten blueprint contents to dot paths. The `__count` keys are
+     * Statamic's ordering bookkeeping, not editor-visible content, so they
+     * are left out of the comparison.
+     */
+    private function flatten(array $data): array
+    {
+        return Arr::dot($this->withoutOrdering($data));
+    }
+
+    private function withoutOrdering(array $data): array
+    {
+        unset($data['__count']);
+
+        foreach ($data as $key => $value) {
+            if (is_array($value)) {
+                $data[$key] = $this->withoutOrdering($value);
+            }
+        }
+
+        return $data;
+    }
+}
