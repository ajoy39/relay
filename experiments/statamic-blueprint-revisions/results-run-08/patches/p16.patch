+
+// Same middleware as Statamic's own CP routes: the authenticated group needs the
+// Inertia shared props that the base `statamic.cp` group sets up.
+Route::middleware(['statamic.cp', 'statamic.cp.authenticated'])
+    ->prefix('cp/blueprint-revisions/{namespace}/{handle}')
+    ->where(['namespace' => '[A-Za-z0-9_.\-]+', 'handle' => '[A-Za-z0-9_\-]+'])
+    ->group(function () {
+        Route::get('/', [BlueprintRevisionController::class, 'index'])->name('blueprint-revisions.index');
+        Route::get('{id}/diff', [BlueprintRevisionController::class, 'diff'])->whereNumber('id')->name('blueprint-revisions.diff');
+        Route::post('{id}/restore', [BlueprintRevisionController::class, 'restore'])->whereNumber('id')->name('blueprint-revisions.restore');
+    });
