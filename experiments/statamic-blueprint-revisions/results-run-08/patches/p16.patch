diff --git a/resources/js/blueprint-revisions.js b/resources/js/blueprint-revisions.js
new file mode 100644
index 0000000..b2920f0
--- /dev/null
+++ b/resources/js/blueprint-revisions.js
@@ -0,0 +1,179 @@
+// Revisions panel for the blueprint edit page. Injected inline by AppServiceProvider
+// and driven by the /cp/blueprint-revisions endpoints in routes/web.php.
+(function () {
+    var EDIT_PATH = /\/fields\/blueprints\/([^/]+)\/([^/]+)\/([^/]+)\/edit\/?$/;
+    var API = '/cp/blueprint-revisions/';
+
+    var panel = null;
+    var current = null;
+
+    function target() {
+        var match = location.pathname.match(EDIT_PATH);
+
+        return match ? { namespace: match[1] + '.' + match[2], handle: match[3] } : null;
+    }
+
+    function endpoint(t) {
+        return API + t.namespace + '/' + t.handle + '/';
+    }
+
+    function el(tag, attrs, text) {
+        var node = document.createElement(tag);
+
+        Object.keys(attrs || {}).forEach(function (name) {
+            node.setAttribute(name, attrs[name]);
+        });
+
+        if (text !== undefined) {
+            node.textContent = text;
+        }
+
+        return node;
+    }
+
+    function request(url, method) {
+        var headers = { Accept: 'application/json', 'X-Requested-With': 'XMLHttpRequest' };
+        var meta = document.querySelector('meta[name="csrf-token"]');
+        var xsrf = document.cookie.split('; ').find(function (c) { return c.indexOf('XSRF-TOKEN=') === 0; });
+
+        if (meta) headers['X-CSRF-TOKEN'] = meta.getAttribute('content');
+        if (xsrf) headers['X-XSRF-TOKEN'] = decodeURIComponent(xsrf.slice('XSRF-TOKEN='.length));
+
+        return fetch(url, { method: method || 'GET', credentials: 'same-origin', headers: headers }).then(function (res) {
+            if (!res.ok) throw new Error('HTTP ' + res.status);
+
+            return res.json();
+        });
+    }
+
+    function button(label, attr, id, onClick) {
+        var node = el('button', { type: 'button' }, label);
+
+        node.setAttribute(attr, String(id));
+        node.addEventListener('click', onClick);
+
+        return node;
+    }
+
+    function row(t, revision) {
+        var item = el('li', { 'data-revision-id': String(revision.id) });
+
+        item.appendChild(el('time', { datetime: revision.created_at }, new Date(revision.created_at).toLocaleString()));
+        item.appendChild(button('Preview', 'data-revision-preview', revision.id, function () { preview(t, revision.id); }));
+        item.appendChild(button('Restore', 'data-revision-restore', revision.id, function () { restore(t, revision.id); }));
+
+        return item;
+    }
+
+    function showError(output, message) {
+        output.replaceChildren(el('p', {}, message));
+    }
+
+    function load(t) {
+        var list = panel.querySelector('[data-revision-list]');
+
+        request(endpoint(t)).then(function (body) {
+            list.replaceChildren();
+
+            if (body.revisions.length === 0) {
+                list.appendChild(el('li', {}, 'No revisions yet.'));
+            }
+
+            body.revisions.forEach(function (revision) {
+                list.appendChild(row(t, revision));
+            });
+        }).catch(function () {
+            list.replaceChildren(el('li', {}, 'Could not load revisions.'));
+        });
+    }
+
+    function preview(t, id) {
+        var output = panel.querySelector('[data-revision-output]');
+
+        output.replaceChildren(el('p', {}, 'Loading preview…'));
+
+        request(endpoint(t) + id + '/diff').then(function (body) {
+            if (body.changes.length === 0) {
+                output.replaceChildren(el('p', {}, 'Restoring revision ' + id + ' would change nothing.'));
+
+                return;
+            }
+
+            var list = el('ul', { 'data-revision-changes': String(id) });
+
+            body.changes.forEach(function (change) {
+                var item = el('li');
+
+                item.appendChild(el('code', {}, change.path));
+                item.appendChild(el('div', {}, 'from ' + JSON.stringify(change.from)));
+                item.appendChild(el('div', {}, 'to ' + JSON.stringify(change.to)));
+                list.appendChild(item);
+            });
+
+            output.replaceChildren(
+                el('p', {}, 'Restoring revision ' + id + ' would change ' + body.changes.length + ' value(s). Nothing has been applied.'),
+                list
+            );
+        }).catch(function () {
+            showError(output, 'Could not load the preview.');
+        });
+    }
+
+    function restore(t, id) {
+        var output = panel.querySelector('[data-revision-output]');
+
+        if (!window.confirm('Restore revision ' + id + '? The current blueprint is kept as a revision, so this can be undone.')) {
+            return;
+        }
+
+        request(endpoint(t) + id + '/restore', 'POST').then(function () {
+            window.location.reload();
+        }).catch(function () {
+            showError(output, 'Restore failed.');
+        });
+    }
+
+    function build(t) {
+        var root = el('section', { 'data-blueprint-revisions': t.namespace + '.' + t.handle });
+
+        root.style.cssText = 'position:fixed;right:16px;bottom:16px;width:360px;max-height:60vh;overflow:auto;'
+            + 'background:#fff;color:#111;border:1px solid #ccc;border-radius:6px;padding:12px;'
+            + 'font:13px/1.4 system-ui,sans-serif;box-shadow:0 4px 16px rgba(0,0,0,.15);z-index:1000;';
+
+        root.appendChild(el('h2', { style: 'font-size:15px;margin:0 0 8px;' }, 'Revisions'));
+        root.appendChild(el('ul', { 'data-revision-list': '', style: 'list-style:none;padding:0;margin:0;' }));
+        root.appendChild(el('div', { 'data-revision-output': '', style: 'margin-top:8px;' }));
+
+        return root;
+    }
+
+    function sync() {
+        var t = target();
+        var key = t ? t.namespace + '/' + t.handle : null;
+
+        if (key === current && (!panel || panel.isConnected)) return;
+
+        current = key;
+
+        if (panel) panel.remove();
+        panel = null;
+
+        if (!t) return;
+
+        panel = build(t);
+        document.body.appendChild(panel);
+        load(t);
+    }
+
+    function init() {
+        new MutationObserver(sync).observe(document.body, { childList: true, subtree: true });
+        window.addEventListener('popstate', sync);
+        sync();
+    }
+
+    if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', init);
+    } else {
+        init();
+    }
+})();
