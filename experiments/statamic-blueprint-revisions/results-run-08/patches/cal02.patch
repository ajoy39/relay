+<?php
+
+namespace App\Services;
+
+use App\Models\BlueprintRevision;
+use Statamic\Eloquent\Fields\BlueprintModel;
+
+class BlueprintRevisionService
+{
+    public static function recordRevision(BlueprintModel $blueprint)
+    {
+        // Only record a revision if this blueprint has been saved before
+        // (i.e., it has data)
+        if ($blueprint->exists) {
+            BlueprintRevision::create([
+                'blueprint_id' => $blueprint->id,
+                'data' => $blueprint->data,
+            ]);
+        }
+    }
+}
