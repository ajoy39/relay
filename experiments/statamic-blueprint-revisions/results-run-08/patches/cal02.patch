+<?php
+
+namespace App\Http\Controllers\CP;
+
+use App\Models\BlueprintRevision;
+use Illuminate\Support\Arr;
+use Statamic\Eloquent\Fields\BlueprintModel;
+use Statamic\Http\Controllers\CP\CpController;
+
+class BlueprintRevisionController extends CpController
+{
+
+    public function index($namespace, $handle)
+    {
+        $blueprint = BlueprintModel::where('namespace', $namespace)
+            ->where('handle', $handle)
+            ->firstOrFail();
+
+        $revisions = BlueprintRevision::where('blueprint_id', $blueprint->id)
+            ->orderBy('created_at', 'desc')
+            ->get(['id', 'created_at'])
+            ->map(fn ($rev) => [
+                'id' => (string) $rev->id,
+                'created_at' => $rev->created_at->toIso8601String(),
+            ]);
+
+        return response()->json(['revisions' => $revisions]);
+    }
+
+    public function diff($namespace, $handle, $revisionId)
+    {
+        $blueprint = BlueprintModel::where('namespace', $namespace)
+            ->where('handle', $handle)
+            ->firstOrFail();
+
+        $revision = BlueprintRevision::where('blueprint_id', $blueprint->id)
+            ->where('id', $revisionId)
+            ->firstOrFail();
+
+        $current = $blueprint->data ?? [];
+        $revisionData = $revision->data ?? [];
+
+        // Show changes FROM current TO revision (what would change if we restore)
+        $changes = $this->computeDiff($current, $revisionData);
+
+        return response()->json(['changes' => $changes]);
+    }
+
+    public function restore($namespace, $handle, $revisionId)
+    {
+        $blueprint = BlueprintModel::where('namespace', $namespace)
+            ->where('handle', $handle)
+            ->firstOrFail();
+
+        $revision = BlueprintRevision::where('blueprint_id', $blueprint->id)
+            ->where('id', $revisionId)
+            ->firstOrFail();
+
+        // Update blueprint to revision data and save
+        // The observer will automatically record a revision after the save
+        $blueprint->data = $revision->data;
+        $blueprint->save();
+
+        return response()->json(['restored' => true]);
+    }
+
+    private function computeDiff($from, $to)
+    {
+        $changes = [];
+        $this->diffObject($from, $to, '', $changes);
+        return $changes;
+    }
+
+    private function diffObject($from, $to, $path, &$changes)
+    {
+        $allKeys = array_unique(array_merge(array_keys($from), array_keys($to)));
+
+        foreach ($allKeys as $key) {
+            $currentPath = $path ? "$path.$key" : $key;
+            $fromValue = $from[$key] ?? null;
+            $toValue = $to[$key] ?? null;
+
+            if (is_array($fromValue) && is_array($toValue)) {
+                $this->diffObject($fromValue, $toValue, $currentPath, $changes);
+            } elseif ($fromValue !== $toValue) {
+                $changes[] = [
+                    'path' => $currentPath,
+                    'from' => $fromValue,
+                    'to' => $toValue,
+                ];
+            }
+        }
+    }
+
+}
