diff --git a/resources/js/blueprint-revisions.js b/resources/js/blueprint-revisions.js
new file mode 100644
index 0000000..cc1def5
--- /dev/null
+++ b/resources/js/blueprint-revisions.js
@@ -0,0 +1,148 @@
+document.addEventListener('DOMContentLoaded', async function() {
+  // Only run on blueprint edit pages
+  if (!window.location.pathname.includes('/cp/fields/blueprints/')) {
+    return;
+  }
+
+  // Extract namespace and handle from URL
+  const pathParts = window.location.pathname.split('/');
+
+  let namespace = null;
+  let handle = null;
+
+  // Try to find the namespace and handle in the URL
+  const blueprintsIndex = pathParts.indexOf('blueprints');
+  if (blueprintsIndex !== -1) {
+    if (pathParts[blueprintsIndex + 1] === 'collections' && pathParts.length > blueprintsIndex + 3) {
+      // collections blueprint
+      namespace = 'collections.' + pathParts[blueprintsIndex + 2];
+      handle = pathParts[blueprintsIndex + 3];
+    } else if (pathParts.length > blueprintsIndex + 2) {
+      // generic blueprint
+      namespace = pathParts[blueprintsIndex + 1];
+      handle = pathParts[blueprintsIndex + 2];
+    }
+  }
+
+  if (!namespace || !handle) {
+    return;
+  }
+
+  // Fetch revisions from API
+  try {
+    const response = await fetch(`/cp/blueprint-revisions/${namespace}/${handle}`);
+    if (!response.ok) {
+      return;
+    }
+
+    const data = await response.json();
+    const revisions = data.revisions || [];
+
+    if (revisions.length === 0) {
+      return;
+    }
+
+    // Create revision history HTML
+    let html = '<div style="margin-top: 40px; border-top: 1px solid #e5e7eb; padding-top: 20px;">';
+    html += '<h3 style="margin: 0 0 20px 0; font-size: 1.125rem; font-weight: 600;">Revisions</h3>';
+    html += '<div style="overflow-x: auto;">';
+    html += '<table style="width: 100%; border-collapse: collapse;">';
+    html += '<thead><tr style="border-bottom: 1px solid #e5e7eb;">';
+    html += '<th style="text-align: left; padding: 8px; font-weight: 600;">Created</th>';
+    html += '<th style="text-align: left; padding: 8px; font-weight: 600;">Actions</th>';
+    html += '</tr></thead>';
+    html += '<tbody>';
+
+    revisions.forEach(rev => {
+      const date = new Date(rev.created_at).toLocaleString();
+      html += `<tr style="border-bottom: 1px solid #f3f4f6;" data-revision-id="${rev.id}">`;
+      html += `<td style="padding: 8px;">${date}</td>`;
+      html += '<td style="padding: 8px;">';
+      html += `<button data-revision-preview="${rev.id}" style="margin-right: 8px; padding: 4px 8px; background: #3b82f6; color: white; border: none; border-radius: 4px; cursor: pointer;">Preview</button>`;
+      html += `<button data-revision-restore="${rev.id}" style="padding: 4px 8px; background: #ef4444; color: white; border: none; border-radius: 4px; cursor: pointer;">Restore</button>`;
+      html += '</td>';
+      html += '</tr>';
+    });
+
+    html += '</tbody>';
+    html += '</table>';
+    html += '</div>';
+    html += '</div>';
+
+    // Find a good place to insert the revision history
+    const body = document.querySelector('body');
+    if (body) {
+      // Create a temporary container and append it
+      const container = document.createElement('div');
+      container.innerHTML = html;
+      body.appendChild(container);
+
+      // Add event listeners for preview buttons
+      document.querySelectorAll('[data-revision-preview]').forEach(btn => {
+        btn.addEventListener('click', async function() {
+          const revId = this.getAttribute('data-revision-preview');
+          const diffResponse = await fetch(`/cp/blueprint-revisions/${namespace}/${handle}/${revId}/diff`);
+          const diffData = await diffResponse.json();
+
+          // Display the diff in a readable format on the page
+          let diffHtml = '<div style="border: 1px solid #e5e7eb; padding: 16px; margin: 16px 0; background: #f9fafb; border-radius: 4px;">';
+          diffHtml += '<h4 style="margin: 0 0 12px 0;">Preview Changes</h4>';
+
+          if (diffData.changes && diffData.changes.length > 0) {
+            diffHtml += '<div><strong>Affected paths:</strong></div>';
+            diffHtml += '<ul style="margin: 8px 0; padding-left: 20px;">';
+            diffData.changes.forEach(change => {
+              diffHtml += `<li><code>${change.path}</code>: `;
+              diffHtml += `<span style="color: #dc2626;">from</span> ${JSON.stringify(change.from)} `;
+              diffHtml += `<span style="color: #16a34a;">to</span> ${JSON.stringify(change.to)}`;
+              diffHtml += `</li>`;
+            });
+            diffHtml += '</ul>';
+          } else {
+            diffHtml += '<p>No changes in this revision.</p>';
+          }
+
+          diffHtml += '</div>';
+
+          // Remove existing preview
+          const existingPreviews = document.querySelectorAll('div[style*="border: 1px solid #e5e7eb; padding: 16px; margin: 16px 0; background: #f9fafb;"]');
+          existingPreviews.forEach(preview => {
+            if (preview.querySelector('h4') && preview.querySelector('h4').textContent.includes('Preview')) {
+              preview.remove();
+            }
+          });
+
+          // Insert the new preview after the container
+          const container = btn.closest('div');
+          if (container) {
+            container.insertAdjacentHTML('afterend', diffHtml);
+          } else {
+            document.body.insertAdjacentHTML('beforeend', diffHtml);
+          }
+        });
+      });
+
+      // Add event listeners for restore buttons
+      document.querySelectorAll('[data-revision-restore]').forEach(btn => {
+        btn.addEventListener('click', async function() {
+          const revId = this.getAttribute('data-revision-restore');
+          if (confirm('Are you sure you want to restore this revision?')) {
+            const restoreResponse = await fetch(`/cp/blueprint-revisions/${namespace}/${handle}/${revId}/restore`, {
+              method: 'POST',
+              headers: {
+                'Content-Type': 'application/json',
+                'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]')?.content || '',
+              }
+            });
+            if (restoreResponse.ok) {
+              alert('Revision restored successfully!');
+              window.location.reload();
+            }
+          }
+        });
+      });
+    }
+  } catch (error) {
+    console.error('Error loading blueprint revisions:', error);
+  }
+});
