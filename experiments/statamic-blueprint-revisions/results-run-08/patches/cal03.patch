+<?php
+
+namespace App\Listeners;
+
+use App\Models\BlueprintRevision;
+use Statamic\Events\BlueprintSaved;
+
+class RecordBlueprintRevision
+{
+    public function handle(BlueprintSaved $event): void
+    {
+        try {
+            $blueprint = $event->blueprint;
+
+            $revision = BlueprintRevision::create([
+                'namespace' => $blueprint->namespace(),
+                'handle' => $blueprint->handle(),
+                'data' => $blueprint->contents(),
+            ]);
+
+            file_put_contents(
+                '/tmp/revisions-created.log',
+                date('Y-m-d H:i:s') . " - Created revision ID: {$revision->id}\n",
+                FILE_APPEND
+            );
+        } catch (\Exception $e) {
+            file_put_contents(
+                '/tmp/revisions-error.log',
+                date('Y-m-d H:i:s') . " - Error: {$e->getMessage()}\n",
+                FILE_APPEND
+            );
+        }
+    }
+}
