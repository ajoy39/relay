+<?php
+
+namespace App\Http\Controllers;
+
+use App\Models\BlueprintRevision;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Arr;
+
+class BlueprintRevisionsController extends Controller
+{
+    public function index($namespace, $handle)
+    {
+        file_put_contents('/tmp/api-called.log', date('Y-m-d H:i:s') . " - API called for {$namespace}/{$handle}\n", FILE_APPEND);
+
+        $revisions = BlueprintRevision::where('namespace', $namespace)
+            ->where('handle', $handle)
+            ->orderBy('created_at', 'desc')
+            ->get(['id', 'created_at']);
+
+        file_put_contents('/tmp/api-called.log', date('Y-m-d H:i:s') . " - Found " . count($revisions) . " revisions\n", FILE_APPEND);
+
+        return response()->json([
+            'revisions' => $revisions->map(fn ($r) => [
+                'id' => (string) $r->id,
+                'created_at' => $r->created_at->toIso8601String(),
+            ])->values(),
+        ]);
+    }
+
+    public function diff($namespace, $handle, $id)
+    {
+        $revision = BlueprintRevision::find($id);
+        if (!$revision) {
+            return response()->json(['changes' => []]);
+        }
+
+        $current = DB::table('blueprints')
+            ->where('namespace', $namespace)
+            ->where('handle', $handle)
+            ->first();
+
+        $currentData = $current ? json_decode($current->data, true) : [];
+        $revisionData = $revision->data ?? [];
+
+        $changes = $this->calculateChanges($revisionData, $currentData);
+
+        return response()->json(['changes' => $changes]);
+    }
+
+    public function restore($namespace, $handle, $id)
+    {
+        $revision = BlueprintRevision::find($id);
+        if (!$revision) {
+            return response()->json(['restored' => false], 404);
+        }
+
+        DB::table('blueprints')
+            ->where('namespace', $namespace)
+            ->where('handle', $handle)
+            ->update([
+                'data' => json_encode($revision->data),
+                'updated_at' => now(),
+            ]);
+
+        BlueprintRevision::create([
+            'namespace' => $namespace,
+            'handle' => $handle,
+            'data' => $revision->data,
+        ]);
+
+        return response()->json(['restored' => true]);
+    }
+
+    private function calculateChanges($from, $to)
+    {
+        $changes = [];
+        $allKeys = array_unique(array_merge($this->getAllKeys($from), $this->getAllKeys($to)));
+
+        foreach ($allKeys as $key) {
+            $fromValue = Arr::get($from, $key);
+            $toValue = Arr::get($to, $key);
+
+            if ($fromValue !== $toValue) {
+                $changes[] = [
+                    'path' => $key,
+                    'from' => $fromValue,
+                    'to' => $toValue,
+                ];
+            }
+        }
+
+        return $changes;
+    }
+
+    private function getAllKeys($array, $prefix = '')
+    {
+        $keys = [];
+        foreach ($array as $key => $value) {
+            $path = $prefix ? "$prefix.$key" : $key;
+            $keys[] = $path;
+            if (is_array($value)) {
+                $keys = array_merge($keys, $this->getAllKeys($value, $path));
+            }
+        }
+        return $keys;
+    }
+}
