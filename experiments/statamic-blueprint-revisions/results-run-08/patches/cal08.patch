@@ -0,0 +1,79 @@
+<div class="revisions-widget" style="margin: 2rem 0; padding: 1.5rem; background: #f5f5f5; border: 1px solid #ddd; border-radius: 8px;">
+    <h2 style="margin: 0 0 1rem 0; font-size: 1.25rem; font-weight: 600;">Revisions</h2>
+    <div id="revisions-list" style="min-height: 60px;">Loading revisions...</div>
+</div>
+
+<script>
+(function() {
+    // Get namespace and handle from the current URL
+    const match = window.location.pathname.match(/\/cp\/fields\/blueprints\/([^\/]+)\/([^\/]+)\/edit/);
+    if (!match) return;
+
+    const ns = 'collections.' + match[1];
+    const h = match[2];
+
+    fetch('/cp/blueprint-revisions/' + ns + '/' + h)
+        .then(r => r.json())
+        .then(data => {
+            const list = document.getElementById('revisions-list');
+            if (!list) return;
+
+            const revisions = data.revisions || [];
+            if (!revisions.length) {
+                list.innerHTML = '<p style="color: #999;">No revisions yet</p>';
+                return;
+            }
+
+            let html = '';
+            for (const rev of revisions) {
+                const date = new Date(rev.created_at).toLocaleString();
+                html += '<div data-revision-id="' + rev.id + '" style="padding: 12px; margin-bottom: 8px; background: white; border: 1px solid #ddd; border-radius: 4px; display: flex; gap: 10px; align-items: center;">';
+                html += '<span style="flex: 1; color: #666;">' + date + '</span>';
+                html += '<button data-revision-preview="' + rev.id + '" style="padding: 6px 12px; background: #3b82f6; color: white; border: none; border-radius: 3px; cursor: pointer;">Preview</button>';
+                html += '<button data-revision-restore="' + rev.id + '" style="padding: 6px 12px; background: #10b981; color: white; border: none; border-radius: 3px; cursor: pointer;">Restore</button>';
+                html += '</div>';
+            }
+
+            list.innerHTML = html;
+
+            // Attach event listeners
+            document.querySelectorAll('[data-revision-preview]').forEach(btn => {
+                btn.addEventListener('click', async () => {
+                    const id = btn.dataset.revisionPreview;
+                    const r = await fetch('/cp/blueprint-revisions/' + ns + '/' + h + '/' + id + '/diff');
+                    const d = await r.json();
+                    if (d.changes && d.changes.length) {
+                        const msg = d.changes.map(c => c.path + ': ' + JSON.stringify(c.from) + ' → ' + JSON.stringify(c.to)).join('\n');
+                        alert('Changes:\n' + msg);
+                    } else {
+                        alert('No changes');
+                    }
+                });
+            });
+
+            document.querySelectorAll('[data-revision-restore]').forEach(btn => {
+                btn.addEventListener('click', async () => {
+                    const id = btn.dataset.revisionRestore;
+                    if (!confirm('Restore this revision?')) return;
+
+                    const csrf = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';
+                    const r = await fetch('/cp/blueprint-revisions/' + ns + '/' + h + '/' + id + '/restore', {
+                        method: 'POST',
+                        headers: { 'X-CSRF-TOKEN': csrf }
+                    });
+
+                    if (r.ok) {
+                        alert('Restored!');
+                        location.reload();
+                    } else {
+                        alert('Failed to restore');
+                    }
+                });
+            });
+        })
+        .catch(() => {
+            const list = document.getElementById('revisions-list');
+            if (list) list.innerHTML = '<p style="color: red;">Error loading revisions</p>';
+        });
+})();
+</script>
