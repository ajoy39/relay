+<?php
+
+namespace App\Http\Controllers;
+
+use App\Models\BlueprintRevision;
+use Statamic\Facades\Blueprint;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\Auth;
+
+class BlueprintRevisionsController extends Controller
+{
+    public function index($namespace, $handle)
+    {
+        if (!Auth::check()) {
+            abort(401);
+        }
+
+        $revisions = BlueprintRevision::where('namespace', $namespace)
+            ->where('handle', $handle)
+            ->orderByDesc('created_at')
+            ->get(['id', 'created_at'])
+            ->map(fn($rev) => [
+                'id' => (string) $rev->id,
+                'created_at' => $rev->created_at->toIso8601String(),
+            ]);
+
+        return response()->json(['revisions' => $revisions]);
+    }
+
+    public function diff($namespace, $handle, $id)
+    {
+        if (!Auth::check()) {
+            abort(401);
+        }
+
+        $revision = BlueprintRevision::findOrFail($id);
+
+        if ($revision->namespace !== $namespace || $revision->handle !== $handle) {
+            return response()->json(['error' => 'Not found'], 404);
+        }
+
+        $blueprint = Blueprint::in($namespace)->get($handle);
+        if (!$blueprint) {
+            return response()->json(['changes' => []]);
+        }
+
+        $current = $blueprint->contents();
+        $old = $revision->data;
+
+        $changes = $this->calculateDiff($old, $current);
+
+        return response()->json(['changes' => $changes]);
+    }
+
+    public function restore(Request $request, $namespace, $handle, $id)
+    {
+        if (!Auth::check()) {
+            abort(401);
+        }
+
+        $revision = BlueprintRevision::findOrFail($id);
+
+        if ($revision->namespace !== $namespace || $revision->handle !== $handle) {
+            return response()->json(['error' => 'Not found'], 404);
+        }
+
+        $blueprint = Blueprint::in($namespace)->get($handle);
+        if (!$blueprint) {
+            return response()->json(['error' => 'Blueprint not found'], 404);
+        }
+
+        $blueprint->setContents($revision->data);
+        $blueprint->save();
+
+        return response()->json(['restored' => true]);
+    }
+
+    private function calculateDiff($old, $current, $path = '')
+    {
+        $changes = [];
+
+        $allKeys = array_unique(array_merge(array_keys($old ?? []), array_keys($current ?? [])));
+
+        foreach ($allKeys as $key) {
+            $oldValue = $old[$key] ?? null;
+            $currentValue = $current[$key] ?? null;
+            $newPath = $path ? "{$path}.{$key}" : $key;
+
+            if (is_array($oldValue) && is_array($currentValue)) {
+                $changes = array_merge($changes, $this->calculateDiff($oldValue, $currentValue, $newPath));
+            } elseif ($oldValue !== $currentValue) {
+                $changes[] = [
+                    'path' => $newPath,
+                    'from' => $oldValue,
+                    'to' => $currentValue,
+                ];
+            }
+        }
+
+        return $changes;
+    }
+}
