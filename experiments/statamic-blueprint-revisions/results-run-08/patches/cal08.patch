+<?php
+
+namespace App\Http\Middleware;
+
+use Closure;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+
+class InjectBlueprintRevisions
+{
+    public function handle(Request $request, Closure $next): Response
+    {
+        $response = $next($request);
+
+        // Match blueprint edit pages
+        if (preg_match('#/cp/fields/blueprints/([^/]+)/([^/]+)/edit#', $request->getPathInfo(), $m)) {
+            $ns = "collections." . $m[1];
+            $h = $m[2];
+
+            $content = (string) $response->getContent();
+
+            $widget = <<<WIDGET
+<!-- Starting revisions widget injection -->
+<div class="revisions-section">
+<h2>Revisions</h2>
+<div id="revisions-list"></div>
+</div>
+<script type="application/javascript">
+window.addEventListener('load', function() {
+  const ns = '$ns';
+  const h = '$h';
+
+  fetch('/cp/blueprint-revisions/' + ns + '/' + h)
+    .then(res => res.json())
+    .then(data => {
+      const list = document.getElementById('revisions-list');
+      if (!list) return;
+
+      const revisions = data.revisions || [];
+      if (!revisions.length) {
+        list.innerHTML = '<p>No revisions</p>';
+        return;
+      }
+
+      const html = revisions.map(rev => {
+        return '<div data-revision-id="' + rev.id + '" style="border: 1px solid #ccc; padding: 10px; margin: 10px 0;">' +
+          '<p>' + new Date(rev.created_at).toLocaleString() + '</p>' +
+          '<button data-revision-preview="' + rev.id + '" onclick="previewRevision(\'' + rev.id + '\', \'' + ns + '\', \'' + h + '\')">Preview</button> ' +
+          '<button data-revision-restore="' + rev.id + '" onclick="restoreRevision(\'' + rev.id + '\', \'' + ns + '\', \'' + h + '\')">Restore</button>' +
+          '</div>';
+      }).join('');
+
+      list.innerHTML = html;
+    });
+});
+
+function previewRevision(id, ns, h) {
+  fetch('/cp/blueprint-revisions/' + ns + '/' + h + '/' + id + '/diff')
+    .then(res => res.json())
+    .then(data => {
+      if (data.changes && data.changes.length) {
+        const msg = data.changes.map(c => c.path + ': ' + JSON.stringify(c.from) + ' → ' + JSON.stringify(c.to)).join('\n');
+        alert('Changes:\n' + msg);
+      } else {
+        alert('No changes');
+      }
+    });
+}
+
+function restoreRevision(id, ns, h) {
+  if (!confirm('Restore this revision?')) return;
+
+  const csrf = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';
+  fetch('/cp/blueprint-revisions/' + ns + '/' + h + '/' + id + '/restore', {
+    method: 'POST',
+    headers: { 'X-CSRF-TOKEN': csrf }
+  }).then(res => res.json()).then(data => {
+    if (data.restored) {
+      alert('Restored!');
+      location.reload();
+    } else {
+      alert('Failed');
+    }
+  });
+}
+</script>
+WIDGET;
+
+            // Inject before body closing tag
+            if (strpos($content, '</body>') !== false) {
+                $content = str_replace('</body>', $widget . '</body>', $content);
+            } else {
+                $content .= $widget;
+            }
+
+            $response->setContent($content);
+        }
+
+        return $response;
+    }
+}
