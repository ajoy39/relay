+++ b/tests/Feature/BlueprintRevisionsTest.php
@@ -0,0 +1,158 @@
+<?php
+
+namespace Tests\Feature;
+
+use App\Models\BlueprintRevision;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Statamic\Eloquent\Fields\BlueprintModel;
+use Statamic\Facades\User;
+use Statamic\Fields\Blueprint;
+use Tests\TestCase;
+
+class BlueprintRevisionsTest extends TestCase
+{
+    use RefreshDatabase;
+
+    private const BASE = '/cp/blueprint-revisions/collections.pages/page';
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+
+        $user = User::make()->email('editor@example.com')->makeSuper()->set('name', 'Editor');
+        $user->save();
+
+        $this->actingAs($user);
+    }
+
+    private function saveBlueprint(string $displayTitle): void
+    {
+        Blueprint::make()
+            ->setHandle('page')
+            ->setNamespace('collections.pages')
+            ->setContents([
+                'title' => 'Page',
+                'tabs' => [
+                    'main' => [
+                        'display' => 'Main',
+                        'sections' => [
+                            [
+                                'fields' => [
+                                    ['handle' => 'title', 'field' => ['type' => 'text', 'display' => $displayTitle]],
+                                ],
+                            ],
+                        ],
+                    ],
+                ],
+            ])
+            ->save();
+    }
+
+    private function storedDisplay(): string
+    {
+        $data = BlueprintModel::query()
+            ->where('namespace', 'collections.pages')
+            ->where('handle', 'page')
+            ->first()
+            ->getAttributeValue('data');
+
+        return $data['tabs']['main']['sections'][0]['fields'][0]['field']['display'];
+    }
+
+    private function revisionIds(): array
+    {
+        return $this->getJson(self::BASE)->assertOk()->json('revisions.*.id');
+    }
+
+    public function test_unauthenticated_requests_are_rejected(): void
+    {
+        auth()->logout();
+
+        $this->getJson(self::BASE)->assertStatus(401);
+        $this->getJson(self::BASE.'/1/diff')->assertStatus(401);
+        $this->postJson(self::BASE.'/1/restore')->assertStatus(401);
+    }
+
+    public function test_each_save_records_a_revision_newest_first(): void
+    {
+        $this->assertSame([], $this->revisionIds());
+
+        $this->saveBlueprint('One');
+        $this->saveBlueprint('Two');
+
+        $response = $this->getJson(self::BASE)->assertOk();
+        $ids = $response->json('revisions.*.id');
+
+        $this->assertCount(2, $ids);
+        $this->assertGreaterThan($ids[1], $ids[0]);
+        $this->assertNotEmpty($response->json('revisions.0.created_at'));
+    }
+
+    public function test_diff_lists_only_the_paths_that_restoring_would_change(): void
+    {
+        $this->saveBlueprint('One');
+        $this->saveBlueprint('Two');
+
+        [$newestId, $oldestId] = $this->revisionIds();
+
+        $this->getJson(self::BASE.'/'.$oldestId.'/diff')
+            ->assertOk()
+            ->assertExactJson(['changes' => [[
+                'path' => 'tabs.main.sections.0.fields.0.field.display',
+                'from' => 'Two',
+                'to' => 'One',
+            ]]]);
+
+        $this->assertSame('Two', $this->storedDisplay());
+    }
+
+    public function test_identical_revision_yields_no_changes(): void
+    {
+        $this->saveBlueprint('One');
+
+        [$id] = $this->revisionIds();
+
+        $this->getJson(self::BASE.'/'.$id.'/diff')
+            ->assertOk()
+            ->assertExactJson(['changes' => []]);
+    }
+
+    public function test_restore_applies_the_revision_and_can_be_undone(): void
+    {
+        $this->saveBlueprint('One');
+        $this->saveBlueprint('Two');
+
+        [$newestId, $oldestId] = $this->revisionIds();
+
+        $this->postJson(self::BASE.'/'.$oldestId.'/restore')
+            ->assertOk()
+            ->assertExactJson(['restored' => true]);
+
+        $this->assertSame('One', $this->storedDisplay());
+
+        $ids = $this->revisionIds();
+        $this->assertCount(3, $ids, 'Restoring should record a revision of its own.');
+
+        $this->postJson(self::BASE.'/'.$newestId.'/restore')->assertOk();
+
+        $this->assertSame('Two', $this->storedDisplay());
+    }
+
+    public function test_unknown_revision_is_not_found(): void
+    {
+        $this->saveBlueprint('One');
+
+        $this->getJson(self::BASE.'/999999/diff')->assertNotFound();
+        $this->postJson(self::BASE.'/999999/restore')->assertNotFound();
+    }
+
+    public function test_revisions_are_scoped_to_their_blueprint(): void
+    {
+        $this->saveBlueprint('One');
+
+        $this->assertSame(1, BlueprintRevision::count());
+        $this->getJson('/cp/blueprint-revisions/collections.other/page')
+            ->assertOk()
+            ->assertExactJson(['revisions' => []]);
+    }
+}
