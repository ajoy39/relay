diff --git a/public/vendor/app/js/blueprint-revisions.js b/public/vendor/app/js/blueprint-revisions.js
new file mode 100644
index 0000000..3567bc9
--- /dev/null
+++ b/public/vendor/app/js/blueprint-revisions.js
@@ -0,0 +1,180 @@
+(function () {
+    const PANEL_ID = 'blueprint-revisions';
+    const EDIT_PATH = /\/fields\/blueprints\/(.+)\/edit\/?$/;
+
+    // Works out which blueprint the current CP page is editing, e.g.
+    // /cp/fields/blueprints/collections/pages/page/edit -> collections.pages / page
+    function currentBlueprint() {
+        const match = location.pathname.match(EDIT_PATH);
+
+        if (!match) {
+            return null;
+        }
+
+        const segments = match[1].split('/').filter(Boolean);
+        const handle = segments.pop();
+
+        return {
+            base: location.pathname.slice(0, location.pathname.indexOf('/fields/blueprints/')) + '/blueprint-revisions',
+            namespace: segments.join('.'),
+            handle,
+        };
+    }
+
+    function xsrfToken() {
+        const match = document.cookie.match(/(?:^|; )XSRF-TOKEN=([^;]+)/);
+
+        return match ? decodeURIComponent(match[1]) : '';
+    }
+
+    function request(url, options = {}) {
+        return fetch(url, {
+            ...options,
+            headers: {
+                Accept: 'application/json',
+                'X-Requested-With': 'XMLHttpRequest',
+                'X-XSRF-TOKEN': xsrfToken(),
+                ...(options.headers || {}),
+            },
+            credentials: 'same-origin',
+        }).then(async (response) => {
+            if (!response.ok) {
+                throw new Error(`Request failed with status ${response.status}`);
+            }
+
+            return response.json();
+        });
+    }
+
+    function element(tag, text, attributes = {}) {
+        const el = document.createElement(tag);
+
+        if (text !== undefined) {
+            el.textContent = text;
+        }
+
+        Object.entries(attributes).forEach(([name, value]) => el.setAttribute(name, value));
+
+        return el;
+    }
+
+    function button(label, attributes, onClick) {
+        const el = element('button', label, { type: 'button', ...attributes });
+        el.addEventListener('click', onClick);
+
+        return el;
+    }
+
+    function renderDiff(container, changes) {
+        container.replaceChildren();
+
+        if (changes.length === 0) {
+            container.append(element('p', 'This revision matches the current blueprint. Restoring it would change nothing.'));
+
+            return;
+        }
+
+        const list = element('ul');
+
+        changes.forEach((change) => {
+            const item = element('li');
+            item.append(element('code', change.path));
+            item.append(element('pre', `- ${JSON.stringify(change.from)}\n+ ${JSON.stringify(change.to)}`));
+            list.append(item);
+        });
+
+        container.append(element('p', `${changes.length} field path(s) would change. Nothing has been applied.`), list);
+    }
+
+    function renderRevision(panel, target, revision) {
+        const row = element('li', undefined, { 'data-revision-id': String(revision.id) });
+        const when = element('time', new Date(revision.created_at).toLocaleString(), { datetime: revision.created_at });
+        const diff = element('div', undefined, { 'data-revision-diff': String(revision.id) });
+        diff.hidden = true;
+
+        row.append(
+            when,
+            ' ',
+            button('Preview', { 'data-revision-preview': String(revision.id) }, () => {
+                diff.hidden = false;
+                diff.textContent = 'Loading…';
+
+                request(`${target.url}/${revision.id}/diff`)
+                    .then((data) => renderDiff(diff, data.changes))
+                    .catch(() => diff.textContent = 'Could not load the preview.');
+            }),
+            ' ',
+            button('Restore', { 'data-revision-restore': String(revision.id) }, () => {
+                const confirmed = window.confirm(
+                    `Restore the revision from ${when.textContent}? The current blueprint will be replaced. You can undo this by restoring the previous revision.`
+                );
+
+                if (!confirmed) {
+                    return;
+                }
+
+                request(`${target.url}/${revision.id}/restore`, { method: 'POST' })
+                    .then(() => window.location.reload())
+                    .catch(() => window.alert('The revision could not be restored.'));
+            }),
+            diff
+        );
+
+        panel.querySelector('[data-revisions-list]').append(row);
+    }
+
+    function loadRevisions(panel, target) {
+        const list = panel.querySelector('[data-revisions-list]');
+        const status = panel.querySelector('[data-revisions-status]');
+
+        list.replaceChildren();
+        status.textContent = 'Loading revisions…';
+
+        request(target.url)
+            .then(({ revisions }) => {
+                status.textContent = revisions.length === 0 ? 'No revisions yet. Saving this blueprint will record one.' : '';
+                revisions.forEach((revision) => renderRevision(panel, target, revision));
+            })
+            .catch(() => {
+                status.textContent = 'Could not load revisions.';
+            });
+    }
+
+    function buildPanel(target) {
+        const panel = element('section', undefined, { id: PANEL_ID, 'data-blueprint': `${target.namespace}.${target.handle}` });
+        const heading = element('h2', 'Revisions');
+        const status = element('p', undefined, { 'data-revisions-status': '' });
+
+        panel.append(heading, status, element('ol', undefined, { 'data-revisions-list': '' }));
+
+        return panel;
+    }
+
+    function sync(force = false) {
+        const target = currentBlueprint();
+        const existing = document.getElementById(PANEL_ID);
+
+        if (!target) {
+            existing?.remove();
+
+            return;
+        }
+
+        const key = `${target.namespace}.${target.handle}`;
+
+        if (existing && existing.dataset.blueprint === key && !force) {
+            return;
+        }
+
+        existing?.remove();
+
+        const panel = buildPanel(target);
+        (document.querySelector('main') || document.body).append(panel);
+        loadRevisions(panel, { ...target, url: `${target.base}/${target.namespace}/${target.handle}` });
+    }
+
+    new MutationObserver(() => sync()).observe(document.body, { childList: true, subtree: true });
+    document.addEventListener('inertia:finish', () => sync(true));
+    document.addEventListener('DOMContentLoaded', () => sync());
+    sync();
+})();
