+<?php
+
+namespace App\Http\Controllers;
+
+use App\Blueprints\RevisionTracker;
+use Illuminate\Http\JsonResponse;
+
+class BlueprintRevisionController extends Controller
+{
+    public function __construct(private RevisionTracker $revisions) {}
+
+    public function index(string $namespace, string $handle): JsonResponse
+    {
+        $revisions = $this->revisions->history($namespace, $handle)->map(fn ($revision) => [
+            'id' => $revision->id,
+            'created_at' => $revision->created_at->toIso8601String(),
+        ]);
+
+        return response()->json(['revisions' => $revisions->values()]);
+    }
+
+    public function diff(string $namespace, string $handle, string $id): JsonResponse
+    {
+        $revision = $this->revisions->find($namespace, $handle, $id);
+
+        return response()->json([
+            'changes' => $this->revisions->diff($namespace, $handle, $revision),
+        ]);
+    }
+
+    public function restore(string $namespace, string $handle, string $id): JsonResponse
+    {
+        $revision = $this->revisions->find($namespace, $handle, $id);
+
+        abort_unless($this->revisions->restore($namespace, $handle, $revision), 422, 'The blueprint could not be saved.');
+
+        return response()->json(['restored' => true]);
+    }
+}
