+<?php
+
+namespace App\Blueprints;
+
+use App\Models\BlueprintRevision;
+use Illuminate\Database\Eloquent\Collection;
+use Illuminate\Support\Arr;
+use Statamic\Fields\Blueprint;
+
+class RevisionTracker
+{
+    /**
+     * Statamic stores an ordering counter on every tab, section and field so
+     * the CP keeps field order. It is bookkeeping, not an editor-visible change.
+     */
+    private const ORDER_KEY = '__count';
+
+    public function record(string $namespace, string $handle, array $data): BlueprintRevision
+    {
+        return BlueprintRevision::create([
+            'namespace' => $namespace,
+            'handle' => $handle,
+            'data' => $data,
+        ]);
+    }
+
+    public function history(string $namespace, string $handle): Collection
+    {
+        return $this->revisionsFor($namespace, $handle)->orderByDesc('id')->get();
+    }
+
+    public function find(string $namespace, string $handle, string $id): BlueprintRevision
+    {
+        return $this->revisionsFor($namespace, $handle)->findOrFail($id);
+    }
+
+    /**
+     * Changes that restoring the revision would make, from the current blueprint
+     * to the revision's contents. Unchanged paths are left out.
+     */
+    public function diff(string $namespace, string $handle, BlueprintRevision $revision): array
+    {
+        $current = $this->flatten($this->currentData($namespace, $handle));
+        $target = $this->flatten($revision->data);
+
+        $changes = [];
+
+        foreach (array_unique([...array_keys($current), ...array_keys($target)]) as $path) {
+            $inCurrent = array_key_exists($path, $current);
+            $inTarget = array_key_exists($path, $target);
+
+            if ($inCurrent && $inTarget && $current[$path] === $target[$path]) {
+                continue;
+            }
+
+            $changes[] = [
+                'path' => (string) $path,
+                'from' => $current[$path] ?? null,
+                'to' => $target[$path] ?? null,
+            ];
+        }
+
+        return $changes;
+    }
+
+    /**
+     * Writes the revision's contents back through Statamic's own save path, so
+     * blueprint caches are cleared and the save fires the usual events. The
+     * model's saved hook then records a new revision, which keeps restores undoable.
+     */
+    public function restore(string $namespace, string $handle, BlueprintRevision $revision): bool
+    {
+        $data = $revision->data;
+
+        $blueprint = Blueprint::make()
+            ->setHidden(Arr::get($data, 'hide'))
+            ->setOrder(Arr::get($data, 'order'))
+            ->setHandle($handle)
+            ->setNamespace($namespace)
+            ->setContents($data);
+
+        return $blueprint->save() !== false;
+    }
+
+    private function revisionsFor(string $namespace, string $handle)
+    {
+        return BlueprintRevision::query()
+            ->where('namespace', $namespace)
+            ->where('handle', $handle);
+    }
+
+    private function currentData(string $namespace, string $handle): array
+    {
+        $model = app('statamic.eloquent.blueprints.model')::query()
+            ->where('namespace', $namespace)
+            ->where('handle', $handle)
+            ->first();
+
+        return $model?->getAttributeValue('data') ?? [];
+    }
+
+    private function flatten(array $data, string $prefix = ''): array
+    {
+        $flat = [];
+
+        foreach ($data as $key => $value) {
+            if ($key === self::ORDER_KEY) {
+                continue;
+            }
+
+            $path = $prefix === '' ? (string) $key : $prefix.'.'.$key;
+
+            if (is_array($value) && $value !== []) {
+                $flat += $this->flatten($value, $path);
+            } else {
+                $flat[$path] = $value;
+            }
+        }
+
+        return $flat;
+    }
+}
