+<?php
+
+namespace App\Repositories;
+
+use App\Services\BlueprintRevisionService;
+use Statamic\Eloquent\Fields\BlueprintRepository as EloquentBlueprintRepository;
+use Statamic\Fields\Blueprint;
+
+class BlueprintRepository extends EloquentBlueprintRepository
+{
+    public function updateModel($blueprint)
+    {
+        parent::updateModel($blueprint);
+
+        // Record a revision after the model is saved
+        $model = $this->getModel($blueprint);
+        if ($model) {
+            $revisionService = app(BlueprintRevisionService::class);
+            $revisionService->recordRevision($model, $model->data);
+        }
+    }
+}
diff --git a/app/Services/BlueprintRevisionService.php b/app/Services/BlueprintRevisionService.php
new file mode 100644
index 0000000..449e080
--- /dev/null
+++ b/app/Services/BlueprintRevisionService.php
@@ -0,0 +1,111 @@
+<?php
+
+namespace App\Services;
+
+use App\Models\BlueprintRevision;
+use Statamic\Fields\Blueprint;
+use Statamic\Eloquent\Fields\BlueprintModel;
+
+class BlueprintRevisionService
+{
+    public function recordRevision(BlueprintModel $blueprintModel, array $data)
+    {
+        BlueprintRevision::create([
+            'blueprint_id' => $blueprintModel->id,
+            'namespace' => $blueprintModel->namespace,
+            'handle' => $blueprintModel->handle,
+            'data' => $data,
+        ]);
+    }
+
+    public function getRevisions($namespace, $handle)
+    {
+        return BlueprintRevision::where('namespace', $namespace)
+            ->where('handle', $handle)
+            ->orderByDesc('created_at')
+            ->orderByDesc('id')
+            ->get(['id', 'created_at'])
+            ->map(fn($revision) => [
+                'id' => (string) $revision->id,
+                'created_at' => $revision->created_at->toIso8601String(),
+            ]);
+    }
+
+    public function getRevision($id)
+    {
+        return BlueprintRevision::find($id);
+    }
+
+    public function getDiff($id, array $currentData)
+    {
+        $revision = $this->getRevision($id);
+        if (! $revision) {
+            return [];
+        }
+
+        return $this->computeDiff($revision->data, $currentData);
+    }
+
+    public function restore($id)
+    {
+        $revision = $this->getRevision($id);
+        if (! $revision) {
+            return false;
+        }
+
+        $blueprintModel = $revision->blueprint;
+        if (! $blueprintModel) {
+            return false;
+        }
+
+        // Restore the blueprint data by going through the repository
+        // This ensures the restore itself is recorded as a revision
+        $blueprint = \Statamic\Facades\Blueprint::find(
+            ($blueprintModel->namespace ? $blueprintModel->namespace . '.' : '') . $blueprintModel->handle
+        );
+
+        if (! $blueprint) {
+            return false;
+        }
+
+        // Set the contents to the revision's data
+        $blueprint->setContents($revision->data);
+
+        // Save through the facade, which will trigger our updated repository
+        // and record a new revision
+        \Statamic\Facades\Blueprint::save($blueprint);
+
+        return true;
+    }
+
+    private function computeDiff($from, $to)
+    {
+        $changes = [];
+        $this->diffArrays($from, $to, '', $changes);
+        return $changes;
+    }
+
+    private function diffArrays($from, $to, $path, &$changes)
+    {
+        $allKeys = array_unique(array_merge(
+            array_keys((array) $from),
+            array_keys((array) $to)
+        ));
+
+        foreach ($allKeys as $key) {
+            $newPath = $path ? "{$path}.{$key}" : $key;
+            $fromValue = is_array($from) ? ($from[$key] ?? null) : ($from->{$key} ?? null);
+            $toValue = is_array($to) ? ($to[$key] ?? null) : ($to->{$key} ?? null);
+
+            if (is_array($fromValue) && is_array($toValue)) {
+                $this->diffArrays($fromValue, $toValue, $newPath, $changes);
+            } elseif ($fromValue !== $toValue) {
+                $changes[] = [
+                    'path' => $newPath,
+                    'from' => $fromValue,
+                    'to' => $toValue,
+                ];
+            }
+        }
+    }
+}
