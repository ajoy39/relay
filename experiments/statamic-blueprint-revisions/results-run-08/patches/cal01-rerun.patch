+<?php
+
+namespace App\Console\Commands;
+
+use Illuminate\Console\Command;
+
+class FixtureSeedEdits extends Command
+{
+    protected $signature = 'fixture:seed-edits';
+    protected $description = 'Make two edits to the page blueprint';
+
+    public function handle(): int
+    {
+        $blueprint = \Statamic\Facades\Blueprint::find('collections.pages.page');
+
+        if (! $blueprint) {
+            echo "ERROR: Blueprint not found\n";
+            return 1;
+        }
+
+        // First edit: Change the title
+        $contents = $blueprint->contents();
+        $contents['title'] = 'Page v1';
+        $blueprint->setContents($contents);
+        $blueprint->save();
+
+        // Small delay to ensure different timestamps
+        sleep(1);
+
+        // Second edit: Add a field or change display
+        $blueprint = \Statamic\Facades\Blueprint::find('collections.pages.page');
+        $contents = $blueprint->contents();
+        $contents['title'] = 'Page v2';
+        // Modify the Body field display
+        $contents['tabs']['main']['sections'][0]['fields'][1]['field']['display'] = 'Body v3';
+        $blueprint->setContents($contents);
+        $blueprint->save();
+
+        echo "SEEDED: Two edits created\n";
+        return 0;
+    }
+}
