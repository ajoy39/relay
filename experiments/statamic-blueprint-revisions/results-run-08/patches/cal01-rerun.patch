+<?php
+
+namespace App\Http\Controllers;
+
+use App\Services\BlueprintRevisionService;
+use Illuminate\Http\JsonResponse;
+use Statamic\Eloquent\Fields\BlueprintModel;
+
+class BlueprintRevisionsController extends Controller
+{
+    public function __construct(
+        private BlueprintRevisionService $revisionService
+    ) {}
+
+    public function index($namespace, $handle): JsonResponse
+    {
+        $revisions = $this->revisionService->getRevisions($namespace, $handle);
+        return response()->json(['revisions' => $revisions]);
+    }
+
+    public function diff($namespace, $handle, $id): JsonResponse
+    {
+        $blueprintModel = BlueprintModel::where('namespace', $namespace)
+            ->where('handle', $handle)
+            ->first();
+
+        if (! $blueprintModel) {
+            return response()->json(['changes' => []]);
+        }
+
+        $changes = $this->revisionService->getDiff($id, $blueprintModel->data ?? []);
+        return response()->json(['changes' => $changes]);
+    }
+
+    public function restore($namespace, $handle, $id): JsonResponse
+    {
+        $blueprintModel = BlueprintModel::where('namespace', $namespace)
+            ->where('handle', $handle)
+            ->first();
+
+        if (! $blueprintModel) {
+            return response()->json(['restored' => false], 404);
+        }
+
+        $success = $this->revisionService->restore($id);
+        return response()->json(['restored' => $success], $success ? 200 : 404);
+    }
+}
