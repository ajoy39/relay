+<?php
+
+namespace App\Console\Commands;
+
+use Illuminate\Console\Command;
+
+class FixtureResetBlueprint extends Command
+{
+    protected $signature = 'fixture:reset-blueprint';
+    protected $description = 'Reset the page blueprint to initial state';
+
+    public function handle(): int
+    {
+        // Delete any existing revisions for the page blueprint
+        \DB::table('blueprint_revisions')
+            ->where('namespace', 'collections.pages')
+            ->where('handle', 'page')
+            ->delete();
+
+        // Delete the existing blueprint model
+        \DB::table('blueprints')
+            ->where('namespace', 'collections.pages')
+            ->where('handle', 'page')
+            ->delete();
+
+        // Create the initial blueprint
+        $blueprint = \Statamic\Facades\Blueprint::make('page')
+            ->setNamespace('collections.pages')
+            ->setContents([
+                'title' => 'Page',
+                'tabs' => [
+                    'main' => [
+                        'display' => 'Main',
+                        'sections' => [
+                            [
+                                'fields' => [
+                                    [
+                                        'handle' => 'title',
+                                        'field' => [
+                                            'type' => 'text',
+                                            'display' => 'Title',
+                                            'required' => true,
+                                        ],
+                                    ],
+                                    [
+                                        'handle' => 'content',
+                                        'field' => [
+                                            'type' => 'markdown',
+                                            'display' => 'Body',
+                                        ],
+                                    ],
+                                ],
+                            ],
+                        ],
+                    ],
+                ],
+            ]);
+
+        $blueprint->save();
+
+        echo "FIXTURE RESET: Blueprint initialized\n";
+        return 0;
+    }
+}
