+<?php
+
+namespace App\Console\Commands;
+
+use Illuminate\Console\Command;
+
+class FixtureCheckContents extends Command
+{
+    protected $signature = 'fixture:check-contents';
+    protected $description = 'Check the current state of the blueprint';
+
+    public function handle(): int
+    {
+        $blueprint = \Statamic\Facades\Blueprint::find('collections.pages.page');
+
+        if (! $blueprint) {
+            echo "NOT FOUND";
+            return 0;
+        }
+
+        $contents = $blueprint->contents();
+
+        // Extract the display value for the content/body field
+        if (isset($contents['tabs']['main']['sections'][0]['fields'][1]['field']['display'])) {
+            echo $contents['tabs']['main']['sections'][0]['fields'][1]['field']['display'];
+        } else {
+            echo "UNKNOWN";
+        }
+
+        return 0;
+    }
+}
