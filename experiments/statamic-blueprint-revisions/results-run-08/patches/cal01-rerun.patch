+<?php
+
+namespace App\Http\Middleware;
+
+use Closure;
+use Illuminate\Http\Request;
+use Inertia\Inertia;
+use Symfony\Component\HttpFoundation\Response;
+
+class InjectBlueprintRevisions
+{
+    public function handle(Request $request, Closure $next): Response
+    {
+        $response = $next($request);
+
+        // Check if this is a blueprint edit page response
+        if ($response instanceof \Inertia\Response) {
+            $props = $response->props();
+
+            // If this is a blueprint edit page, extract namespace and handle
+            if (isset($props['blueprint']) && is_array($props['blueprint'])) {
+                $blueprint = $props['blueprint'];
+                $namespace = $blueprint['namespace'] ?? null;
+                $handle = $blueprint['handle'] ?? null;
+
+                if ($namespace && $handle) {
+                    // Add revision-related props to the Inertia response
+                    $response->with([
+                        'blueprintNamespace' => $namespace,
+                        'blueprintHandle' => $handle,
+                    ]);
+                }
+            }
+        }
+
+        return $response;
+    }
+}
diff --git a/app/Http/Middleware/InjectBlueprintRevisionsHTML.php b/app/Http/Middleware/InjectBlueprintRevisionsHTML.php
new file mode 100644
index 0000000..f82649c
