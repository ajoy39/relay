+<?php
+
+namespace App\Http\Middleware;
+
+use Closure;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+
+class AddBlueprintRevisionsUI
+{
+    public function handle(Request $request, Closure $next): Response
+    {
+        $response = $next($request);
+
+        // Only modify blueprint edit pages
+        if (! $this->isBlueprintEditPage($request)) {
+            return $response;
+        }
+
+        // For Inertia responses, we need a different approach
+        if ($response instanceof \Inertia\Response) {
+            // Get the current props
+            $props = $response->props();
+
+            // Extract blueprint info from props
+            if (isset($props['blueprint'])) {
+                $blueprint = $props['blueprint'];
+                $namespace = $blueprint['namespace'] ?? null;
+                $handle = $blueprint['handle'] ?? null;
+
+                if ($namespace && $handle) {
+                    // Inject blueprint info into the response so our component can use it
+                    $response->with([
+                        'revisionEnabled' => true,
+                        'revisionNamespace' => $namespace,
+                        'revisionHandle' => $handle,
+                    ]);
+                }
+            }
+        }
+
+        return $response;
+    }
+
+    private function isBlueprintEditPage(Request $request): bool
+    {
+        return str_contains($request->path(), '/cp/fields/blueprints/') &&
+               str_ends_with($request->path(), '/edit');
+    }
+}
