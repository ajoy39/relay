+<?php
+
+namespace Database\Seeders;
+
+use Illuminate\Database\Seeder;
+
+class BlueprintRevisionsSeeder extends Seeder
+{
+    public function run(): void
+    {
+        // Initialize the page blueprint with revisions
+        $this->seedPageBlueprint();
+    }
+
+    private function seedPageBlueprint(): void
+    {
+        // Check if the blueprint already has revisions
+        $revisionCount = \DB::table('blueprint_revisions')
+            ->where('namespace', 'collections.pages')
+            ->where('handle', 'page')
+            ->count();
+
+        if ($revisionCount > 0) {
+            return; // Already seeded
+        }
+
+        // Create the initial blueprint
+        $blueprint = \Statamic\Facades\Blueprint::make('page')
+            ->setNamespace('collections.pages')
+            ->setContents([
+                'title' => 'Page',
+                'tabs' => [
+                    'main' => [
+                        'display' => 'Main',
+                        'sections' => [
+                            [
+                                'fields' => [
+                                    [
+                                        'handle' => 'title',
+                                        'field' => [
+                                            'type' => 'text',
+                                            'display' => 'Title',
+                                            'required' => true,
+                                        ],
+                                    ],
+                                    [
+                                        'handle' => 'content',
+                                        'field' => [
+                                            'type' => 'markdown',
+                                            'display' => 'Body',
+                                        ],
+                                    ],
+                                ],
+                            ],
+                        ],
+                    ],
+                ],
+            ]);
+
+        $blueprint->save();
+
+        // Sleep to ensure different timestamps
+        sleep(1);
+
+        // Make first edit
+        $blueprint = \Statamic\Facades\Blueprint::find('collections.pages.page');
+        $contents = $blueprint->contents();
+        $contents['title'] = 'Page v1';
+        $blueprint->setContents($contents);
+        $blueprint->save();
+
+        // Sleep to ensure different timestamps
+        sleep(1);
+
+        // Make second edit
+        $blueprint = \Statamic\Facades\Blueprint::find('collections.pages.page');
+        $contents = $blueprint->contents();
+        $contents['title'] = 'Page v2';
+        $contents['tabs']['main']['sections'][0]['fields'][1]['field']['display'] = 'Body v3';
+        $blueprint->setContents($contents);
+        $blueprint->save();
+    }
+}
