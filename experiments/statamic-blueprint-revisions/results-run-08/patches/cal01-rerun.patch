+++ b/app/Http/Middleware/InjectBlueprintRevisionsHTML.php
@@ -0,0 +1,134 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use Closure;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+use App\Services\BlueprintRevisionService;
+
+class InjectBlueprintRevisionsHTML
+{
+    public function handle(Request $request, Closure $next): Response
+    {
+        $response = $next($request);
+
+        if (!$this->isBlueprintEditPage($request) || !$this->isHtmlResponse($response)) {
+            return $response;
+        }
+
+        // Extract namespace and handle from the URL path
+        if (preg_match('#/cp/fields/blueprints/([^/]+)/([^/]+)/edit#', $request->path(), $matches)) {
+            $namespace = $matches[1];
+            $handle = $matches[2];
+
+            // Inject revision UI into the HTML
+            $html = $response->getContent();
+            $revisionService = app(BlueprintRevisionService::class);
+            $revisions = $revisionService->getRevisions($namespace, $handle);
+
+            // Create the revision history HTML
+            $revisionHtml = $this->generateRevisionHTML($revisions, $namespace, $handle);
+
+            // Inject before the closing body tag
+            $html = str_replace('</body>', $revisionHtml . '</body>', $html);
+
+            $response->setContent($html);
+        }
+
+        return $response;
+    }
+
+    private function isBlueprintEditPage(Request $request): bool
+    {
+        return str_contains($request->path(), '/cp/fields/blueprints/') &&
+               str_ends_with($request->path(), '/edit');
+    }
+
+    private function isHtmlResponse(Response $response): bool
+    {
+        $contentType = $response->headers->get('Content-Type', '');
+        return str_contains($contentType, 'text/html') || str_contains($contentType, 'application/json');
+    }
+
+    private function generateRevisionHTML($revisions, $namespace, $handle): string
+    {
+        if (empty($revisions)) {
+            return '<div style="display:none;" id="blueprint-revisions-container"></div>';
+        }
+
+        $html = '<div id="blueprint-revisions-container" style="margin-top: 2rem; padding: 1rem; border-top: 1px solid #e5e7eb;">';
+        $html .= '<h3 style="font-size: 1.25rem; font-weight: 600; margin-bottom: 1rem;">Revisions</h3>';
+        $html .= '<div style="overflow-x: auto;">';
+        $html .= '<table style="width: 100%; border-collapse: collapse;">';
+        $html .= '<thead><tr style="border-bottom: 2px solid #e5e7eb;"><th style="padding: 0.5rem; text-align: left;">Created</th><th style="padding: 0.5rem; text-align: right;">Actions</th></tr></thead>';
+        $html .= '<tbody>';
+
+        foreach ($revisions as $revision) {
+            $id = $revision['id'];
+            $createdAt = $revision['created_at'];
+            $html .= '<tr data-revision-id="' . htmlspecialchars($id) . '" style="border-bottom: 1px solid #e5e7eb;">';
+            $html .= '<td style="padding: 0.5rem;">' . htmlspecialchars($createdAt) . '</td>';
+            $html .= '<td style="padding: 0.5rem; text-align: right;">';
+            $html .= '<button data-revision-preview="' . htmlspecialchars($id) . '" style="margin-right: 0.5rem; padding: 0.25rem 0.75rem; background: #3b82f6; color: white; border: none; border-radius: 0.25rem; cursor: pointer;">Preview</button>';
+            $html .= '<button data-revision-restore="' . htmlspecialchars($id) . '" style="padding: 0.25rem 0.75rem; background: #10b981; color: white; border: none; border-radius: 0.25rem; cursor: pointer;">Restore</button>';
+            $html .= '</td>';
+            $html .= '</tr>';
+        }
+
+        $html .= '</tbody>';
+        $html .= '</table>';
+        $html .= '</div>';
+        $html .= '</div>';
+
+        // Add JavaScript for preview and restore functionality
+        $html .= '<script>';
+        $html .= 'document.addEventListener("DOMContentLoaded", function() {';
+        $html .= '  const apiBase = "/cp/blueprint-revisions/' . addslashes($namespace) . '/' . addslashes($handle) . '";';
+
+        // Preview handlers
+        $html .= '  document.querySelectorAll("[data-revision-preview]").forEach(btn => {';
+        $html .= '    btn.addEventListener("click", async function(e) {';
+        $html .= '      e.preventDefault();';
+        $html .= '      const id = this.dataset.revisionPreview;';
+        $html .= '      const res = await fetch(apiBase + "/" + id + "/diff");';
+        $html .= '      const data = await res.json();';
+        $html .= '      const changes = data.changes || [];';
+        $html .= '      let message = "No changes";';
+        $html .= '      if (changes.length > 0) {';
+        $html .= '        message = "Changes:\\n\\n" + changes.map(c => `${c.path}: ${JSON.stringify(c.from)} → ${JSON.stringify(c.to)}`).join("\\n");';
+        $html .= '      }';
+        $html .= '      alert(message);';
+        $html .= '    });';
+        $html .= '  });';
+
+        // Restore handlers
+        $html .= '  document.querySelectorAll("[data-revision-restore]").forEach(btn => {';
+        $html .= '    btn.addEventListener("click", async function(e) {';
+        $html .= '      e.preventDefault();';
+        $html .= '      const id = this.dataset.revisionRestore;';
+        $html .= '      const csrf = document.querySelector("meta[name=\'csrf-token\']")?.getAttribute("content") || "";';
+        $html .= '      const res = await fetch(apiBase + "/" + id + "/restore", {';
+        $html .= '        method: "POST",';
+        $html .= '        headers: {';
+        $html .= '          "X-CSRF-TOKEN": csrf,';
+        $html .= '          "X-Requested-With": "XMLHttpRequest",';
+        $html .= '          "Content-Type": "application/json",';
+        $html .= '        },';
+        $html .= '      });';
+        $html .= '      const data = await res.json();';
+        $html .= '      if (data.restored) {';
+        $html .= '        alert("Revision restored! Please refresh to see changes.");';
+        $html .= '        location.reload();';
+        $html .= '      } else {';
+        $html .= '        alert("Failed to restore revision");';
+        $html .= '      }';
+        $html .= '    });';
+        $html .= '  });';
+
+        $html .= '});';
+        $html .= '</script>';
+
+        return $html;
+    }
+}
