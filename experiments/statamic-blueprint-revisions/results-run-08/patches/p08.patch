 <?php
 
+use App\Http\Controllers\CP\BlueprintRevisionController;
+use Illuminate\Foundation\Inspiring;
+use Illuminate\Support\Facades\Artisan;
 use Illuminate\Support\Facades\Route;
 
+Artisan::command('inspire', function () {
+    $this->comment(Inspiring::quote());
+})->purpose('Display an inspiring quote');
+
 // Route::statamic('example', 'example-view', [
 //    'title' => 'Example'
 // ]);
+
+// Statamic's authenticated CP middleware expects the 'statamic.cp' group to run first.
+Route::middleware(['statamic.cp', 'statamic.cp.authenticated'])
+    ->prefix('cp/blueprint-revisions/{namespace}/{handle}')
+    ->name('cp.blueprint-revisions.')
+    ->group(function () {
+        Route::get('/', [BlueprintRevisionController::class, 'index'])->name('index');
+        // Not {revision}: Statamic binds that parameter name globally for entry revisions.
+        Route::get('{revisionId}/diff', [BlueprintRevisionController::class, 'diff'])
+            ->whereNumber('revisionId')
+            ->name('diff');
+        Route::post('{revisionId}/restore', [BlueprintRevisionController::class, 'restore'])
+            ->whereNumber('revisionId')
+            ->name('restore');
+    });
