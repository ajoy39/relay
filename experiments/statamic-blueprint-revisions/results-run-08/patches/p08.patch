+<?php
+
+namespace App\Models;
+
+use Illuminate\Database\Eloquent\Builder;
+use Illuminate\Database\Eloquent\Model;
+
+class BlueprintRevision extends Model
+{
+    protected $fillable = ['namespace', 'handle', 'data'];
+
+    /**
+     * Get the attributes that should be cast.
+     *
+     * @return array<string, string>
+     */
+    protected function casts(): array
+    {
+        return [
+            'data' => 'array',
+        ];
+    }
+
+    /**
+     * Scope revisions to a single blueprint.
+     */
+    public function scopeOfBlueprint(Builder $query, string $namespace, string $handle): Builder
+    {
+        return $query->where('namespace', $namespace)->where('handle', $handle);
+    }
+}
