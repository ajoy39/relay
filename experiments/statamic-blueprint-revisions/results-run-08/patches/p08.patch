diff --git a/resources/js/cp/blueprint-revisions.js b/resources/js/cp/blueprint-revisions.js
new file mode 100644
index 0000000..1302b00
--- /dev/null
+++ b/resources/js/cp/blueprint-revisions.js
@@ -0,0 +1,208 @@
+// Revision history panel for the blueprint edit page.
+//
+// The control panel is an Inertia app, so the page changes without a full
+// load. This script watches the DOM and mounts the panel whenever a blueprint
+// edit URL is showing, and removes it when the editor navigates away.
+(function () {
+    var API = '/cp/blueprint-revisions/';
+    var EDIT_PATH = /^\/cp\/fields\/blueprints\/(.+)\/([^\/]+)\/edit\/?$/;
+    var PANEL_ATTR = 'data-blueprint-revisions';
+
+    function request(url, method) {
+        var headers = { Accept: 'application/json', 'X-Requested-With': 'XMLHttpRequest' };
+
+        if (method === 'POST') {
+            var meta = document.querySelector('meta[name="csrf-token"]');
+            var xsrf = document.cookie.match(/(?:^|;\s*)XSRF-TOKEN=([^;]+)/);
+
+            if (meta) headers['X-CSRF-TOKEN'] = meta.getAttribute('content');
+            if (xsrf) headers['X-XSRF-TOKEN'] = decodeURIComponent(xsrf[1]);
+        }
+
+        return fetch(url, { method: method, headers: headers, credentials: 'same-origin' }).then(function (res) {
+            if (!res.ok) throw new Error('Request failed with status ' + res.status);
+
+            return res.json();
+        });
+    }
+
+    function element(tag, text) {
+        var node = document.createElement(tag);
+
+        if (text !== undefined) node.textContent = text;
+
+        return node;
+    }
+
+    function formatTime(iso) {
+        var date = new Date(iso);
+
+        return isNaN(date.getTime()) ? iso : date.toLocaleString();
+    }
+
+    function formatValue(value) {
+        return value === undefined ? 'undefined' : JSON.stringify(value);
+    }
+
+    function renderChanges(output, revisionId, changes) {
+        output.replaceChildren();
+
+        if (changes.length === 0) {
+            output.appendChild(element('p', 'Restoring revision ' + revisionId + ' would change nothing.'));
+
+            return;
+        }
+
+        output.appendChild(element('p', 'Restoring revision ' + revisionId + ' would change ' + changes.length + (changes.length === 1 ? ' value:' : ' values:')));
+
+        var list = element('ul');
+
+        changes.forEach(function (change) {
+            var item = element('li');
+
+            item.appendChild(element('code', change.path));
+            item.appendChild(document.createTextNode(': '));
+            item.appendChild(element('code', formatValue(change.from)));
+            item.appendChild(document.createTextNode(' → '));
+            item.appendChild(element('code', formatValue(change.to)));
+            list.appendChild(item);
+        });
+
+        output.appendChild(list);
+    }
+
+    function buildRow(base, revision, output) {
+        var row = element('li');
+        var preview = element('button', 'Preview');
+        var restore = element('button', 'Restore');
+
+        row.setAttribute('data-revision-id', revision.id);
+        preview.type = 'button';
+        preview.setAttribute('data-revision-preview', revision.id);
+        restore.type = 'button';
+        restore.setAttribute('data-revision-restore', revision.id);
+
+        row.appendChild(element('span', formatTime(revision.created_at)));
+        row.appendChild(document.createTextNode(' '));
+        row.appendChild(preview);
+        row.appendChild(document.createTextNode(' '));
+        row.appendChild(restore);
+
+        preview.addEventListener('click', function () {
+            output.textContent = 'Loading preview…';
+
+            request(base + '/' + revision.id + '/diff', 'GET')
+                .then(function (body) {
+                    renderChanges(output, revision.id, body.changes);
+                })
+                .catch(function (error) {
+                    output.textContent = 'Could not load the preview: ' + error.message;
+                });
+        });
+
+        restore.addEventListener('click', function () {
+            var message = 'Restore the blueprint to revision ' + revision.id + ' from ' + formatTime(revision.created_at) + '?\n\n'
+                + 'The current contents are kept as a new revision, so this can be undone.';
+
+            if (!window.confirm(message)) return;
+
+            output.textContent = 'Restoring…';
+
+            request(base + '/' + revision.id + '/restore', 'POST')
+                .then(function () {
+                    // The editor below still holds the old contents; reload so a save cannot overwrite the restore.
+                    window.location.reload();
+                })
+                .catch(function (error) {
+                    output.textContent = 'Could not restore: ' + error.message;
+                });
+        });
+
+        return row;
+    }
+
+    function load(panel, base) {
+        var list = panel.querySelector('[data-revision-list]');
+        var output = panel.querySelector('[data-revision-output]');
+        var status = panel.querySelector('[data-revision-status]');
+
+        request(base, 'GET')
+            .then(function (body) {
+                var revisions = body.revisions || [];
+
+                status.textContent = revisions.length === 0 ? 'No revisions yet. Each save records one.' : '';
+
+                revisions.forEach(function (revision) {
+                    list.appendChild(buildRow(base, revision, output));
+                });
+            })
+            .catch(function (error) {
+                status.textContent = 'Could not load revisions: ' + error.message;
+            });
+    }
+
+    function buildPanel(key, base) {
+        var panel = element('section');
+        var heading = element('h2', 'Revisions');
+        var status = element('p', 'Loading revisions…');
+        var list = element('ol');
+        var output = element('div');
+
+        panel.setAttribute(PANEL_ATTR, key);
+        panel.style.margin = '2rem';
+        status.setAttribute('data-revision-status', '');
+        list.setAttribute('data-revision-list', '');
+        output.setAttribute('data-revision-output', '');
+
+        panel.appendChild(heading);
+        panel.appendChild(status);
+        panel.appendChild(list);
+        panel.appendChild(output);
+
+        load(panel, base);
+
+        return panel;
+    }
+
+    function mount() {
+        var match = EDIT_PATH.exec(window.location.pathname);
+        var existing = document.querySelector('[' + PANEL_ATTR + ']');
+
+        if (!match) {
+            if (existing) existing.remove();
+
+            return;
+        }
+
+        var namespace = match[1].split('/').join('.');
+        var handle = match[2];
+        var key = namespace + '/' + handle;
+
+        if (existing && existing.getAttribute(PANEL_ATTR) === key) return;
+
+        if (existing) existing.remove();
+
+        var host = document.querySelector('#statamic main') || document.querySelector('main') || document.getElementById('statamic');
+
+        if (!host) return;
+
+        host.appendChild(buildPanel(key, API + key));
+    }
+
+    var scheduled = false;
+
+    function schedule() {
+        if (scheduled) return;
+
+        scheduled = true;
+        setTimeout(function () {
+            scheduled = false;
+            mount();
+        }, 50);
+    }
+
+    document.addEventListener('DOMContentLoaded', function () {
+        new MutationObserver(schedule).observe(document.body, { childList: true, subtree: true });
+        mount();
+    });
+})();
