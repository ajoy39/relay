+<?php
+
+namespace App\Support;
+
+class BlueprintDiff
+{
+    /**
+     * Describe what changes when $current is replaced by $target.
+     *
+     * @return array<int, array{path: string, from: mixed, to: mixed}>
+     */
+    public static function between(array $current, array $target): array
+    {
+        $from = self::leaves($current);
+        $to = self::leaves($target);
+
+        $changes = [];
+
+        foreach (array_unique([...array_keys($from), ...array_keys($to)]) as $path) {
+            $inFrom = array_key_exists($path, $from);
+            $inTo = array_key_exists($path, $to);
+
+            if ($inFrom === $inTo && ($from[$path] ?? null) === ($to[$path] ?? null)) {
+                continue;
+            }
+
+            $changes[] = [
+                'path' => $path,
+                'from' => $from[$path] ?? null,
+                'to' => $to[$path] ?? null,
+            ];
+        }
+
+        return $changes;
+    }
+
+    /**
+     * Flatten a blueprint into dotted paths pointing at leaf values.
+     *
+     * Fields are keyed by their handle rather than their position, so inserting
+     * a field does not make every field after it look changed.
+     */
+    private static function leaves(array $value, string $prefix = ''): array
+    {
+        $leaves = [];
+
+        foreach ($value as $key => $child) {
+            // Statamic stores __count on tabs, sections and fields to keep their order.
+            if (is_string($key) && str_starts_with($key, '__')) {
+                continue;
+            }
+
+            $segment = is_array($child) && is_string($child['handle'] ?? null)
+                ? $child['handle']
+                : (string) $key;
+
+            $path = $prefix === '' ? $segment : $prefix.'.'.$segment;
+
+            if (is_array($child) && $child !== []) {
+                $leaves += self::leaves($child, $path);
+            } else {
+                $leaves[$path] = $child;
+            }
+        }
+
+        return $leaves;
+    }
+}
