+<?php
+
+namespace App\Http\Controllers\CP;
+
+use App\Http\Controllers\Controller;
+use App\Models\BlueprintRevision;
+use App\Support\BlueprintDiff;
+use Illuminate\Http\JsonResponse;
+use Statamic\Eloquent\Fields\BlueprintModel;
+
+class BlueprintRevisionController extends Controller
+{
+    public function index(string $namespace, string $handle): JsonResponse
+    {
+        $revisions = BlueprintRevision::ofBlueprint($namespace, $handle)
+            ->orderByDesc('id')
+            ->get()
+            ->map(fn (BlueprintRevision $revision) => [
+                'id' => $revision->id,
+                'created_at' => $revision->created_at->toIso8601String(),
+            ])
+            ->values();
+
+        return response()->json(['revisions' => $revisions]);
+    }
+
+    public function diff(string $namespace, string $handle, int $revisionId): JsonResponse
+    {
+        $revision = $this->findRevision($namespace, $handle, $revisionId);
+
+        return response()->json([
+            'changes' => BlueprintDiff::between($this->currentData($namespace, $handle), $revision->data),
+        ]);
+    }
+
+    public function restore(string $namespace, string $handle, int $revisionId): JsonResponse
+    {
+        $revision = $this->findRevision($namespace, $handle, $revisionId);
+
+        $blueprint = BlueprintModel::firstOrNew([
+            'namespace' => $namespace,
+            'handle' => $handle,
+        ]);
+
+        // Saving records a revision of the restored contents, so the restore can be undone.
+        $blueprint->data = $revision->data;
+        $blueprint->save();
+
+        return response()->json(['restored' => true]);
+    }
+
+    private function findRevision(string $namespace, string $handle, int $id): BlueprintRevision
+    {
+        return BlueprintRevision::ofBlueprint($namespace, $handle)->findOrFail($id);
+    }
+
+    private function currentData(string $namespace, string $handle): array
+    {
+        $blueprint = BlueprintModel::where('namespace', $namespace)
+            ->where('handle', $handle)
+            ->first();
+
+        return $blueprint ? $blueprint->getAttributeValue('data') : [];
+    }
+}
