+<?php
+
+namespace App\Http\Controllers\CP;
+
+use App\Blueprints\RevisionTracker;
+use App\Http\Controllers\Controller;
+
+class BlueprintRevisionController extends Controller
+{
+    public function __construct(private RevisionTracker $tracker)
+    {
+    }
+
+    public function index(string $namespace, string $handle)
+    {
+        $revisions = $this->tracker->revisions($namespace, $handle)
+            ->map(fn ($revision) => [
+                'id' => $revision->id,
+                'created_at' => $revision->created_at->toIso8601String(),
+            ])
+            ->values();
+
+        return response()->json(['revisions' => $revisions]);
+    }
+
+    public function diff(string $namespace, string $handle, int $id)
+    {
+        $revision = $this->tracker->find($namespace, $handle, $id);
+
+        return response()->json([
+            'changes' => $this->tracker->diff($namespace, $handle, $revision),
+        ]);
+    }
+
+    public function restore(string $namespace, string $handle, int $id)
+    {
+        $revision = $this->tracker->find($namespace, $handle, $id);
+
+        $this->tracker->restore($namespace, $handle, $revision);
+
+        return response()->json(['restored' => true]);
+    }
+}
