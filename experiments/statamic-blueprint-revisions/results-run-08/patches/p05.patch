+++ b/app/Blueprints/RevisionTracker.php
@@ -0,0 +1,140 @@
+<?php
+
+namespace App\Blueprints;
+
+use App\Models\BlueprintRevision;
+
+/**
+ * Records, diffs and restores revisions of eloquent-stored blueprints.
+ *
+ * A revision is a snapshot of the raw `blueprints.data` JSON. Order markers
+ * (`__count`) are kept in the snapshot so a restore is exact, but ignored when
+ * diffing so that only real content changes are reported.
+ */
+class RevisionTracker
+{
+    public function record(?string $namespace, string $handle): ?BlueprintRevision
+    {
+        $blueprint = $this->stored($namespace, $handle);
+
+        if (! $blueprint) {
+            return null;
+        }
+
+        return BlueprintRevision::create([
+            'namespace' => $namespace,
+            'handle' => $handle,
+            'data' => $blueprint->data ?? [],
+        ]);
+    }
+
+    /**
+     * Maps a blueprint edit page path, e.g. `cp/fields/blueprints/collections/pages/page/edit`,
+     * to the blueprint's namespace and handle, e.g. [`collections.pages`, `page`].
+     */
+    public function identifierFromEditPath(string $path): ?array
+    {
+        if (! preg_match('#(?:^|/)fields/blueprints/(.+)/edit$#', $path, $matches)) {
+            return null;
+        }
+
+        $segments = explode('/', $matches[1]);
+        $handle = array_pop($segments);
+
+        return [
+            'namespace' => $segments ? implode('.', $segments) : null,
+            'handle' => $handle,
+        ];
+    }
+
+    public function revisions(?string $namespace, string $handle)
+    {
+        return $this->query($namespace, $handle)->orderByDesc('id')->get();
+    }
+
+    public function find(?string $namespace, string $handle, int $id): BlueprintRevision
+    {
+        return $this->query($namespace, $handle)->findOrFail($id);
+    }
+
+    /**
+     * Changes that restoring the revision would make to the current blueprint.
+     */
+    public function diff(?string $namespace, string $handle, BlueprintRevision $revision): array
+    {
+        $current = $this->flatten($this->withoutOrder($this->stored($namespace, $handle)?->data ?? []));
+        $target = $this->flatten($this->withoutOrder($revision->data ?? []));
+
+        $changes = [];
+
+        foreach (array_unique([...array_keys($current), ...array_keys($target)]) as $path) {
+            $from = $current[$path] ?? null;
+            $to = $target[$path] ?? null;
+
+            if ($from !== $to) {
+                $changes[] = ['path' => (string) $path, 'from' => $from, 'to' => $to];
+            }
+        }
+
+        return $changes;
+    }
+
+    /**
+     * Writes the revision's contents back over the stored blueprint and records
+     * the result as a new revision, so the restore can itself be undone.
+     */
+    public function restore(?string $namespace, string $handle, BlueprintRevision $revision): void
+    {
+        $model = app('statamic.eloquent.blueprints.model')::firstOrNew([
+            'namespace' => $namespace,
+            'handle' => $handle,
+        ]);
+
+        $model->data = $revision->data;
+        $model->save();
+
+        $this->record($namespace, $handle);
+    }
+
+    private function query(?string $namespace, string $handle)
+    {
+        return BlueprintRevision::query()
+            ->where('namespace', $namespace)
+            ->where('handle', $handle);
+    }
+
+    private function stored(?string $namespace, string $handle)
+    {
+        return app('statamic.eloquent.blueprints.model')::query()
+            ->where('namespace', $namespace)
+            ->where('handle', $handle)
+            ->first();
+    }
+
+    private function withoutOrder(array $data): array
+    {
+        unset($data['__count']);
+
+        return array_map(
+            fn ($value) => is_array($value) ? $this->withoutOrder($value) : $value,
+            $data,
+        );
+    }
+
+    private function flatten(array $data, string $prefix = ''): array
+    {
+        $flat = [];
+
+        foreach ($data as $key => $value) {
+            $path = $prefix === '' ? (string) $key : $prefix.'.'.$key;
+
+            if (is_array($value) && $value !== []) {
+                $flat += $this->flatten($value, $path);
+            } else {
+                $flat[$path] = $value;
+            }
+        }
+
+        return $flat;
+    }
+}
