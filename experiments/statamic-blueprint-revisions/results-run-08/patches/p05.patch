+<?php
+
+namespace App\Listeners;
+
+use App\Blueprints\RevisionTracker;
+use Statamic\Events\BlueprintSaved;
+
+class RecordBlueprintRevision
+{
+    public function __construct(private RevisionTracker $tracker)
+    {
+    }
+
+    public function handle(BlueprintSaved $event): void
+    {
+        $this->tracker->record($event->blueprint->namespace(), $event->blueprint->handle());
+    }
+}
