diff --git a/resources/views/blueprint-revisions/panel.blade.php b/resources/views/blueprint-revisions/panel.blade.php
new file mode 100644
index 0000000..cce45d6
--- /dev/null
+++ b/resources/views/blueprint-revisions/panel.blade.php
@@ -0,0 +1,105 @@
+@php
+    $tracker = app(\App\Blueprints\RevisionTracker::class);
+    $target = $tracker->identifierFromEditPath(request()->path());
+@endphp
+
+@if ($target)
+    @php
+        $revisions = $tracker->revisions($target['namespace'], $target['handle']);
+    @endphp
+
+    <section
+        id="blueprint-revisions"
+        data-namespace="{{ $target['namespace'] }}"
+        data-handle="{{ $target['handle'] }}"
+        data-csrf="{{ csrf_token() }}"
+        style="position: fixed; right: 1rem; bottom: 1rem; width: 26rem; max-height: 70vh; overflow: auto; z-index: 1000; background: #fff; color: #111; border: 1px solid #cdd3da; border-radius: 6px; padding: 1rem; box-shadow: 0 4px 16px rgba(0,0,0,.15); font: 13px/1.4 system-ui, sans-serif;"
+    >
+        <h2 style="font-size: 15px; font-weight: 600; margin: 0 0 .5rem;">Revisions</h2>
+
+        @forelse ($revisions as $revision)
+            <div data-revision-id="{{ $revision->id }}" style="border-top: 1px solid #eee; padding: .5rem 0;">
+                <time datetime="{{ $revision->created_at->toIso8601String() }}">{{ $revision->created_at->format('Y-m-d H:i:s') }}</time>
+                <button type="button" data-revision-preview="{{ $revision->id }}">Preview</button>
+                <button type="button" data-revision-restore="{{ $revision->id }}">Restore</button>
+                <div data-revision-result="{{ $revision->id }}" style="margin-top: .25rem;"></div>
+            </div>
+        @empty
+            <p style="margin: 0;">No revisions yet. A revision is recorded each time this blueprint is saved.</p>
+        @endforelse
+
+        <p data-revision-status role="status" style="margin: .5rem 0 0; font-weight: 600;"></p>
+    </section>
+
+    <script>
+        (function () {
+            const panel = document.getElementById('blueprint-revisions');
+            const status = panel.querySelector('[data-revision-status]');
+            const base = '/cp/blueprint-revisions/'
+                + encodeURIComponent(panel.dataset.namespace) + '/'
+                + encodeURIComponent(panel.dataset.handle);
+
+            const request = async (url, method) => {
+                const response = await fetch(url, {
+                    method,
+                    credentials: 'same-origin',
+                    headers: { Accept: 'application/json', 'X-CSRF-TOKEN': panel.dataset.csrf },
+                });
+                const body = await response.json().catch(() => ({}));
+
+                if (! response.ok) {
+                    throw new Error(body.message || ('HTTP ' + response.status));
+                }
+
+                return body;
+            };
+
+            const renderChanges = (container, changes) => {
+                if (changes.length === 0) {
+                    container.textContent = 'No changes. Restoring this revision would not change the blueprint.';
+                    return;
+                }
+
+                const list = document.createElement('ul');
+                list.style.margin = '.25rem 0 0 1rem';
+
+                changes.forEach((change) => {
+                    const item = document.createElement('li');
+                    const path = document.createElement('code');
+                    path.textContent = change.path;
+                    item.append(path, ': ', JSON.stringify(change.from), ' → ', JSON.stringify(change.to));
+                    list.append(item);
+                });
+
+                container.replaceChildren(list);
+            };
+
+            panel.addEventListener('click', async (event) => {
+                const preview = event.target.closest('[data-revision-preview]');
+                const restore = event.target.closest('[data-revision-restore]');
+
+                try {
+                    if (preview) {
+                        const id = preview.dataset.revisionPreview;
+                        const container = panel.querySelector(`[data-revision-result="${id}"]`);
+
+                        container.textContent = 'Loading…';
+                        const { changes } = await request(`${base}/${id}/diff`, 'GET');
+                        renderChanges(container, changes);
+                    }
+
+                    if (restore) {
+                        const id = restore.dataset.revisionRestore;
+
+                        status.textContent = 'Restoring…';
+                        await request(`${base}/${id}/restore`, 'POST');
+                        status.textContent = `Revision ${id} restored. Reload this page before editing, `
+                            + 'otherwise the form will save over the restored blueprint.';
+                    }
+                } catch (error) {
+                    status.textContent = 'Failed: ' + error.message;
+                }
+            });
+        })();
+    </script>
+@endif
