+<?php
+
+namespace App\Http\Controllers;
+
+use App\Models\BlueprintRevision;
+use Illuminate\Http\Request;
+use Statamic\Facades\Blueprint;
+
+class BlueprintRevisionsController extends Controller
+{
+    public function index($namespace, $handle)
+    {
+        \Log::debug("BlueprintRevisionsController::index", ['namespace' => $namespace, 'handle' => $handle]);
+
+        $revisions = BlueprintRevision::forBlueprint($namespace, $handle)
+            ->orderBy('created_at', 'desc')
+            ->get(['id', 'created_at']);
+
+        \Log::debug("Found revisions", ['count' => $revisions->count()]);
+
+        return response()->json([
+            'revisions' => $revisions->map(fn($r) => [
+                'id' => $r->id,
+                'created_at' => $r->created_at->toIso8601String(),
+            ])->all(),
+        ]);
+    }
+
+    public function diff($namespace, $handle, $id)
+    {
+        $revision = BlueprintRevision::forBlueprint($namespace, $handle)->find($id);
+
+        if (!$revision) {
+            return response()->json(['changes' => []]);
+        }
+
+        $current = Blueprint::find("{$namespace}.{$handle}");
+        $currentData = $current ? $current->toArray() : [];
+
+        $changes = [];
+        $this->computeChanges($currentData, $revision->data, '', $changes);
+
+        return response()->json(['changes' => $changes]);
+    }
+
+    public function restore(Request $request, $namespace, $handle, $id)
+    {
+        $revision = BlueprintRevision::forBlueprint($namespace, $handle)->find($id);
+
+        if (!$revision) {
+            return response()->json(['restored' => false], 404);
+        }
+
+        $blueprint = Blueprint::find("{$namespace}.{$handle}");
+        if (!$blueprint) {
+            return response()->json(['restored' => false], 404);
+        }
+
+        // Record current state before restoring
+        BlueprintRevision::create([
+            'namespace' => $namespace,
+            'handle' => $handle,
+            'data' => $blueprint->toArray(),
+            'created_at' => now(),
+        ]);
+
+        // Restore the old data
+        $blueprint->setContents($revision->data)->save();
+
+        return response()->json(['restored' => true]);
+    }
+
+    private function computeChanges($from, $to, $prefix, &$changes)
+    {
+        $allKeys = array_unique(array_merge(array_keys((array)$from), array_keys((array)$to)));
+
+        foreach ($allKeys as $key) {
+            $path = $prefix ? "{$prefix}.{$key}" : $key;
+            $fromValue = $from[$key] ?? null;
+            $toValue = $to[$key] ?? null;
+
+            if (is_array($fromValue) && is_array($toValue)) {
+                $this->computeChanges($fromValue, $toValue, $path, $changes);
+            } elseif ($fromValue !== $toValue) {
+                $changes[] = [
+                    'path' => $path,
+                    'from' => $fromValue,
+                    'to' => $toValue,
+                ];
+            }
+        }
+    }
+}
