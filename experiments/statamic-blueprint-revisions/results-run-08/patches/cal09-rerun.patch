+<?php
+
+namespace App\Models;
+
+use Illuminate\Database\Eloquent\Model;
+
+class BlueprintRevision extends Model
+{
+    public $timestamps = false;
+
+    protected $fillable = ['namespace', 'handle', 'data', 'created_at'];
+
+    protected $casts = [
+        'data' => 'array',
+        'created_at' => 'datetime',
+    ];
+
+    public function scopeForBlueprint($query, $namespace, $handle)
+    {
+        return $query->where('namespace', $namespace)->where('handle', $handle);
+    }
+}
