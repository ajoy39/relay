+<?php
+
+namespace App\Http\Middleware;
+
+use Closure;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+
+class InjectBlueprintRevisionsUI
+{
+    /**
+     * Handle an incoming request.
+     *
+     * @param  Closure(Request): (Response)  $next
+     */
+    public function handle(Request $request, Closure $next): Response
+    {
+        $response = $next($request);
+
+        // Only inject into blueprint edit pages
+        if (!$this->isBlueprintEditPage($request)) {
+            return $response;
+        }
+
+        // Only inject into HTML responses
+        if (!str_contains($response->headers->get('Content-Type', ''), 'text/html')) {
+            return $response;
+        }
+
+        $content = $response->getContent();
+        $revisions_ui = $this->generateRevisionsUI($request);
+
+        // Inject before closing body tag
+        $content = str_replace('</body>', $revisions_ui . '</body>', $content);
+        $response->setContent($content);
+
+        return $response;
+    }
+
+    private function isBlueprintEditPage(Request $request): bool
+    {
+        return $request->is('cp/fields/blueprints/*/*/edit') ||
+               $request->is('cp/fields/blueprints/*/*/*/edit');
+    }
+
+    private function generateRevisionsUI(Request $request): string
+    {
+        $path = $request->path();
+
+        // Extract namespace and handle from the URL
+        // Format: cp/fields/blueprints/{namespace}/{handle}/edit or cp/fields/blueprints/{type}/{namespace}/{handle}/edit
+        $parts = explode('/', $path);
+
+        if (count($parts) < 5) {
+            return '';
+        }
+
+        // Handle different blueprint URL patterns
+        if ($parts[3] === 'collections' && count($parts) >= 6) {
+            // cp/fields/blueprints/collections/{collection}/{blueprint}/edit
+            $namespace = 'collections.' . $parts[4];
+            $handle = $parts[5];
+        } elseif ($parts[3] === 'taxonomies' && count($parts) >= 6) {
+            // cp/fields/blueprints/taxonomies/{taxonomy}/{blueprint}/edit
+            $namespace = 'taxonomies.' . $parts[4];
+            $handle = $parts[5];
+        } else {
+            // Generic pattern: cp/fields/blueprints/{namespace}/{handle}/edit
+            $namespace = $parts[3];
+            $handle = $parts[4];
+        }
+
+        return <<<HTML
+            <div id="blueprint-revisions-container">
+                <h3>Revisions</h3>
+                <div id="revisions-list" data-namespace="$namespace" data-handle="$handle"></div>
+            </div>
+            <script>
+                (function() {
+                    const namespace = '$namespace';
+                    const handle = '$handle';
+
+                    async function loadRevisions() {
+                        try {
+                            const response = await fetch(`/cp/blueprint-revisions/${namespace}/${handle}`);
+                            const data = await response.json();
+
+                            if (!data.revisions || data.revisions.length === 0) {
+                                return;
+                            }
+
+                            const container = document.getElementById('revisions-list');
+                            container.innerHTML = data.revisions.map(r => {
+                                const date = new Date(r.created_at).toLocaleString();
+                                return `
+                                    <div data-revision-id="\${r.id}" style="padding: 10px; border: 1px solid #ddd; margin-bottom: 10px;">
+                                        <div>\${date}</div>
+                                        <button data-revision-preview="\${r.id}" style="padding: 5px 10px; margin: 5px 5px 5px 0;">Preview</button>
+                                        <button data-revision-restore="\${r.id}" style="padding: 5px 10px; margin: 5px 5px 5px 0;">Restore</button>
+                                    </div>
+                                `;
+                            }).join('');
+
+                            // Attach event handlers
+                            document.querySelectorAll('[data-revision-preview]').forEach(el => {
+                                el.addEventListener('click', (e) => {
+                                    const id = el.getAttribute('data-revision-preview');
+                                    showPreview(id);
+                                });
+                            });
+
+                            document.querySelectorAll('[data-revision-restore]').forEach(el => {
+                                el.addEventListener('click', (e) => {
+                                    const id = el.getAttribute('data-revision-restore');
+                                    restoreRevision(id);
+                                });
+                            });
+                        } catch (e) {
+                            console.error('Failed to load revisions:', e);
+                        }
+                    }
+
+                    async function showPreview(revisionId) {
+                        try {
+                            const response = await fetch(`/cp/blueprint-revisions/${namespace}/${handle}/${revisionId}/diff`);
+                            const data = await response.json();
+                            alert('Changes:\\n' + JSON.stringify(data.changes, null, 2));
+                        } catch (e) {
+                            console.error('Failed to load preview:', e);
+                        }
+                    }
+
+                    async function restoreRevision(revisionId) {
+                        if (!confirm('Are you sure you want to restore this revision?')) {
+                            return;
+                        }
+
+                        try {
+                            const response = await fetch(`/cp/blueprint-revisions/${namespace}/${handle}/${revisionId}/restore`, {
+                                method: 'POST',
+                                headers: {
+                                    'X-Requested-With': 'XMLHttpRequest',
+                                    'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]')?.content || ''
+                                }
+                            });
+                            const data = await response.json();
+                            if (data.restored) {
+                                alert('Revision restored successfully');
+                                location.reload();
+                            } else {
+                                alert('Failed to restore revision');
+                            }
+                        } catch (e) {
+                            console.error('Failed to restore revision:', e);
+                        }
+                    }
+
+                    if (document.readyState === 'loading') {
+                        document.addEventListener('DOMContentLoaded', loadRevisions);
+                    } else {
+                        loadRevisions();
+                    }
+                })();
+            </script>
+            <style>
+                #blueprint-revisions-container {
+                    padding: 20px;
+                    border-top: 1px solid #ddd;
+                    margin-top: 20px;
+                }
+            </style>
+        HTML;
+    }
+}
