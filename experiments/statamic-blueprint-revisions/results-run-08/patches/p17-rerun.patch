+<?php
+
+namespace App\Http\Controllers;
+
+use App\Models\BlueprintRevision;
+use Illuminate\Http\JsonResponse;
+use Statamic\Eloquent\Fields\BlueprintModel;
+
+class BlueprintRevisionController extends Controller
+{
+    public function index(string $namespace, string $handle): JsonResponse
+    {
+        $revisions = BlueprintRevision::query()
+            ->where('namespace', $namespace)
+            ->where('handle', $handle)
+            ->orderByDesc('id')
+            ->get()
+            ->map(fn (BlueprintRevision $revision) => [
+                'id' => $revision->id,
+                'created_at' => $revision->created_at->toIso8601String(),
+            ]);
+
+        return response()->json(['revisions' => $revisions]);
+    }
+
+    public function diff(string $namespace, string $handle, string $id): JsonResponse
+    {
+        $revision = $this->findRevision($namespace, $handle, $id);
+
+        $current = $this->flatten($this->withoutOrder($this->currentData($namespace, $handle)));
+        $restored = $this->flatten($this->withoutOrder($revision->data));
+
+        $changes = [];
+
+        foreach (array_unique([...array_keys($current), ...array_keys($restored)]) as $path) {
+            $from = $current[$path] ?? null;
+            $to = $restored[$path] ?? null;
+
+            $presenceChanged = array_key_exists($path, $current) !== array_key_exists($path, $restored);
+
+            if ($presenceChanged || $from !== $to) {
+                $changes[] = [
+                    'path' => (string) $path,
+                    'from' => $from,
+                    'to' => $to,
+                ];
+            }
+        }
+
+        return response()->json(['changes' => $changes]);
+    }
+
+    public function restore(string $namespace, string $handle, string $id): JsonResponse
+    {
+        $revision = $this->findRevision($namespace, $handle, $id);
+
+        // Saving through the model fires the observer in AppServiceProvider,
+        // so the restore is recorded as a new revision and can be undone.
+        $blueprint = BlueprintModel::firstOrNew([
+            'namespace' => $namespace,
+            'handle' => $handle,
+        ]);
+
+        $blueprint->data = $revision->data;
+        $blueprint->save();
+
+        return response()->json(['restored' => true]);
+    }
+
+    private function findRevision(string $namespace, string $handle, string $id): BlueprintRevision
+    {
+        return BlueprintRevision::query()
+            ->where('namespace', $namespace)
+            ->where('handle', $handle)
+            ->findOrFail($id);
+    }
+
+    private function currentData(string $namespace, string $handle): array
+    {
+        $blueprint = BlueprintModel::query()
+            ->where('namespace', $namespace)
+            ->where('handle', $handle)
+            ->first();
+
+        return $blueprint?->getAttributeValue('data') ?? [];
+    }
+
+    /**
+     * Drop the sort counters Statamic adds to tabs/sections/fields on save,
+     * so two identical blueprints compare as equal.
+     */
+    private function withoutOrder(array $data): array
+    {
+        unset($data['__count']);
+
+        foreach ($data as $key => $value) {
+            if (is_array($value)) {
+                $data[$key] = $this->withoutOrder($value);
+            }
+        }
+
+        return $data;
+    }
+
+    /**
+     * Flatten nested data into dot paths, e.g. tabs.main.display => 'Body'.
+     * Empty arrays are kept as leaves so they still show up in the diff.
+     */
+    private function flatten(array $data, string $prefix = ''): array
+    {
+        $flat = [];
+
+        foreach ($data as $key => $value) {
+            $path = $prefix === '' ? (string) $key : $prefix.'.'.$key;
+
+            if (is_array($value) && $value !== []) {
+                $flat += $this->flatten($value, $path);
+            } else {
+                $flat[$path] = $value;
+            }
+        }
+
+        return $flat;
+    }
+}
