diff --git a/resources/js/cp/blueprint-revisions.js b/resources/js/cp/blueprint-revisions.js
new file mode 100644
index 0000000..a8519d7
--- /dev/null
+++ b/resources/js/cp/blueprint-revisions.js
@@ -0,0 +1,182 @@
+// Adds a Revisions card to the blueprint edit page: history, preview and restore.
+// Loaded inline on every CP page, so it only acts on the blueprint edit URL.
+(function () {
+    var match = /^\/cp\/fields\/blueprints\/([^/]+)\/([^/]+)\/([^/]+)\/edit\/?$/.exec(window.location.pathname);
+
+    if (!match) {
+        return;
+    }
+
+    var namespace = match[1] + '.' + match[2];
+    var api = '/cp/blueprint-revisions/' + namespace + '/' + match[3];
+    var PANEL_ID = 'blueprint-revisions';
+
+    function xsrfToken() {
+        var cookie = document.cookie.match(/(?:^|; )XSRF-TOKEN=([^;]*)/);
+
+        return cookie ? decodeURIComponent(cookie[1]) : '';
+    }
+
+    function request(method, url) {
+        return fetch(url, {
+            method: method,
+            credentials: 'same-origin',
+            headers: {
+                Accept: 'application/json',
+                'X-Requested-With': 'XMLHttpRequest',
+                'X-XSRF-TOKEN': xsrfToken(),
+            },
+        }).then(function (response) {
+            if (!response.ok) {
+                throw new Error('HTTP ' + response.status);
+            }
+
+            return response.json();
+        });
+    }
+
+    function element(tag, attributes, text) {
+        var node = document.createElement(tag);
+
+        Object.keys(attributes || {}).forEach(function (name) {
+            node.setAttribute(name, attributes[name]);
+        });
+
+        if (text !== undefined) {
+            node.textContent = text;
+        }
+
+        return node;
+    }
+
+    function button(label, attribute, id, onClick) {
+        var attributes = { type: 'button', class: 'btn' };
+        attributes[attribute] = String(id);
+
+        var node = element('button', attributes, label);
+        node.addEventListener('click', onClick);
+
+        return node;
+    }
+
+    function formatValue(value) {
+        return JSON.stringify(value);
+    }
+
+    function renderHistory(panel, revisions) {
+        var nodes = [
+            element('h2', { class: 'text-lg font-medium' }, 'Revisions'),
+            element('p', { class: 'text-sm' }, 'Every save records a revision. Restoring one is recorded too, so it can be undone.'),
+        ];
+
+        if (revisions.length === 0) {
+            nodes.push(element('p', {}, 'No revisions yet.'));
+        } else {
+            var list = element('ul', {});
+
+            revisions.forEach(function (revision) {
+                var row = element('li', { 'data-revision-id': String(revision.id) });
+                row.appendChild(element('span', {}, new Date(revision.created_at).toLocaleString()));
+                row.appendChild(button('Preview', 'data-revision-preview', revision.id, function () {
+                    preview(panel, revision.id);
+                }));
+                row.appendChild(button('Restore', 'data-revision-restore', revision.id, function () {
+                    restore(panel, revision.id);
+                }));
+                list.appendChild(row);
+            });
+
+            nodes.push(list);
+        }
+
+        nodes.push(element('div', { 'data-revision-result': '' }));
+        panel.replaceChildren(...nodes);
+    }
+
+    function renderDiff(result, changes) {
+        if (changes.length === 0) {
+            result.replaceChildren(element('p', {}, 'Restoring this revision would change nothing.'));
+
+            return;
+        }
+
+        var table = element('table', {});
+        var header = element('tr', {});
+        ['Field path', 'Current', 'Revision'].forEach(function (label) {
+            header.appendChild(element('th', {}, label));
+        });
+        table.appendChild(header);
+
+        changes.forEach(function (change) {
+            var row = element('tr', {});
+            row.appendChild(element('td', {}, change.path));
+            row.appendChild(element('td', {}, formatValue(change.from)));
+            row.appendChild(element('td', {}, formatValue(change.to)));
+            table.appendChild(row);
+        });
+
+        result.replaceChildren(
+            element('p', {}, 'Restoring this revision would change ' + changes.length + (changes.length === 1 ? ' field:' : ' fields:')),
+            table
+        );
+    }
+
+    function preview(panel, id) {
+        var result = panel.querySelector('[data-revision-result]');
+        result.textContent = 'Loading preview…';
+
+        request('GET', api + '/' + id + '/diff')
+            .then(function (body) {
+                renderDiff(result, body.changes || []);
+            })
+            .catch(function () {
+                result.textContent = 'Preview failed.';
+            });
+    }
+
+    function restore(panel, id) {
+        var result = panel.querySelector('[data-revision-result]');
+        result.textContent = 'Restoring…';
+
+        request('POST', api + '/' + id + '/restore')
+            .then(function () {
+                window.location.reload();
+            })
+            .catch(function () {
+                result.textContent = 'Restore failed.';
+            });
+    }
+
+    function load(panel) {
+        request('GET', api)
+            .then(function (body) {
+                renderHistory(panel, body.revisions || []);
+            })
+            .catch(function () {
+                panel.replaceChildren(
+                    element('h2', { class: 'text-lg font-medium' }, 'Revisions'),
+                    element('p', {}, 'Revision history could not be loaded.')
+                );
+            });
+    }
+
+    function mount() {
+        if (document.getElementById(PANEL_ID)) {
+            return;
+        }
+
+        var main = document.querySelector('main');
+
+        if (!main) {
+            return;
+        }
+
+        var panel = element('section', { id: PANEL_ID, class: 'card' });
+        main.appendChild(panel);
+        load(panel);
+    }
+
+    // The editor renders client-side, and it can replace <main> on re-render, so keep checking.
+    new MutationObserver(mount).observe(document.documentElement, { childList: true, subtree: true });
+    mount();
+})();
