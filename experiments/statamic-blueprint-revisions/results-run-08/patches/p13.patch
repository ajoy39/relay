+<?php
+
+namespace App\Http\Controllers;
+
+use App\Models\BlueprintRevision;
+use App\Revisions\BlueprintRevisionTracker;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Response;
+
+class BlueprintRevisionController extends Controller
+{
+    public function index(string $namespace, string $handle, BlueprintRevisionTracker $tracker): JsonResponse
+    {
+        $revisions = $tracker->history($namespace, $handle)
+            ->map(fn (BlueprintRevision $revision) => [
+                'id' => $revision->id,
+                'created_at' => $revision->created_at->toIso8601String(),
+            ])
+            ->values();
+
+        return response()->json(['revisions' => $revisions]);
+    }
+
+    public function panel(string $namespace, string $handle, BlueprintRevisionTracker $tracker): Response
+    {
+        return response()->view('blueprint-revisions.panel', [
+            'namespace' => $namespace,
+            'handle' => $handle,
+            'revisions' => $tracker->history($namespace, $handle),
+        ]);
+    }
+
+    public function diff(string $namespace, string $handle, string $id, BlueprintRevisionTracker $tracker): JsonResponse
+    {
+        $revision = BlueprintRevision::query()->forBlueprint($namespace, $handle)->findOrFail($id);
+
+        return response()->json(['changes' => $tracker->diff($namespace, $handle, $revision)]);
+    }
+
+    public function restore(string $namespace, string $handle, string $id, BlueprintRevisionTracker $tracker): JsonResponse
+    {
+        $revision = BlueprintRevision::query()->forBlueprint($namespace, $handle)->findOrFail($id);
+
+        $tracker->restore($namespace, $handle, $revision);
+
+        return response()->json(['restored' => true]);
+    }
+}
