+<?php
+
+namespace App\Http\Middleware;
+
+use Closure;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\Auth;
+
+// Statamic's own CP middleware group assumes an Inertia request, so it can't
+// guard plain JSON endpoints. This only requires a signed-in user.
+class RequireCpUser
+{
+    public function handle(Request $request, Closure $next)
+    {
+        if (! Auth::check()) {
+            return response()->json(['message' => 'Unauthenticated.'], 401);
+        }
+
+        return $next($request);
+    }
+}
