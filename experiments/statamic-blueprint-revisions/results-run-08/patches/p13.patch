diff --git a/resources/views/blueprint-revisions/script.blade.php b/resources/views/blueprint-revisions/script.blade.php
new file mode 100644
index 0000000..4ac24f8
--- /dev/null
+++ b/resources/views/blueprint-revisions/script.blade.php
@@ -0,0 +1,119 @@
+<script>
+(function () {
+    var cpRoot = (window.StatamicConfig && StatamicConfig.cpRoot) || '/cp';
+    var csrfToken = (window.StatamicConfig && StatamicConfig.csrfToken) || '';
+    var apiBase = cpRoot + '/blueprint-revisions/';
+    var pendingTarget = null;
+
+    // Mirrors BlueprintRevisionTracker::targetFor() for the browser location.
+    function targetFor(pathname) {
+        var segments = pathname.replace(/^\/+|\/+$/g, '').split('/');
+        var expected = cpRoot.replace(/^\/+|\/+$/g, '');
+
+        if (segments.length < 6 || segments[segments.length - 1] !== 'edit') return null;
+        if (segments[0] !== expected || segments[1] !== 'fields' || segments[2] !== 'blueprints') return null;
+
+        var parts = segments.slice(3, -1);
+        return { namespace: parts.slice(0, -1).join('.'), handle: parts[parts.length - 1] };
+    }
+
+    function sync() {
+        var target = targetFor(location.pathname);
+        var key = target ? target.namespace + '/' + target.handle : null;
+        var panel = document.getElementById('blueprint-revisions');
+
+        if (panel && panel.getAttribute('data-target') === key) return;
+        if (panel) panel.remove();
+        if (!key || pendingTarget === key) return;
+
+        pendingTarget = key;
+
+        fetch(apiBase + key + '/panel', { credentials: 'same-origin', headers: { Accept: 'text/html' } })
+            .then(function (response) { return response.ok ? response.text() : null; })
+            .then(function (html) {
+                pendingTarget = null;
+                var target = targetFor(location.pathname);
+                if (!html || !target || target.namespace + '/' + target.handle !== key) return;
+                if (document.getElementById('blueprint-revisions')) return;
+                document.body.insertAdjacentHTML('beforeend', html);
+            })
+            .catch(function () { pendingTarget = null; });
+    }
+
+    function panelUrl(panel, id, action) {
+        return apiBase + panel.getAttribute('data-target') + '/' + id + '/' + action;
+    }
+
+    function setStatus(panel, message) {
+        panel.querySelector('[data-revision-status]').textContent = message;
+    }
+
+    function showPreview(panel, id) {
+        var output = panel.querySelector('[data-revision-output]');
+        output.textContent = '';
+        setStatus(panel, 'Loading preview…');
+
+        fetch(panelUrl(panel, id, 'diff'), { credentials: 'same-origin', headers: { Accept: 'application/json' } })
+            .then(function (response) { if (!response.ok) throw new Error(response.status); return response.json(); })
+            .then(function (data) {
+                setStatus(panel, data.changes.length
+                    ? 'Restoring revision ' + id + ' would change ' + data.changes.length + ' value(s). Nothing has been applied.'
+                    : 'Restoring revision ' + id + ' would change nothing.');
+
+                if (!data.changes.length) return;
+
+                var table = document.createElement('table');
+                var head = table.createTHead().insertRow();
+                ['Path', 'Current', 'Revision'].forEach(function (label) {
+                    var th = document.createElement('th');
+                    th.textContent = label;
+                    head.appendChild(th);
+                });
+
+                var body = table.createTBody();
+                data.changes.forEach(function (change) {
+                    var row = body.insertRow();
+                    [change.path, change.from, change.to].forEach(function (value) {
+                        var cell = row.insertCell();
+                        var code = document.createElement('code');
+                        code.textContent = typeof value === 'string' ? value : JSON.stringify(value);
+                        cell.appendChild(code);
+                    });
+                });
+
+                output.appendChild(table);
+            })
+            .catch(function (error) { setStatus(panel, 'Preview failed: ' + error.message); });
+    }
+
+    function restoreRevision(panel, id) {
+        setStatus(panel, 'Restoring revision ' + id + '…');
+
+        fetch(panelUrl(panel, id, 'restore'), {
+            method: 'POST',
+            credentials: 'same-origin',
+            headers: { Accept: 'application/json', 'X-CSRF-TOKEN': csrfToken },
+        })
+            .then(function (response) { if (!response.ok) throw new Error(response.status); return response.json(); })
+            .then(function () { window.location.reload(); })
+            .catch(function (error) { setStatus(panel, 'Restore failed: ' + error.message); });
+    }
+
+    document.addEventListener('click', function (event) {
+        var control = event.target.closest && event.target.closest('[data-revision-preview], [data-revision-restore]');
+        var panel = document.getElementById('blueprint-revisions');
+        if (!control || !panel) return;
+
+        if (control.hasAttribute('data-revision-preview')) {
+            showPreview(panel, control.getAttribute('data-revision-preview'));
+        } else {
+            restoreRevision(panel, control.getAttribute('data-revision-restore'));
+        }
+    });
+
+    // Statamic's CP navigates with Inertia, so the page can change without a reload.
+    new MutationObserver(sync).observe(document.body, { childList: true, subtree: true });
+    window.addEventListener('popstate', sync);
+    sync();
+})();
+</script>
