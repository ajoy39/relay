diff --git a/app/Revisions/BlueprintRevisionTracker.php b/app/Revisions/BlueprintRevisionTracker.php
new file mode 100644
index 0000000..6845728
--- /dev/null
+++ b/app/Revisions/BlueprintRevisionTracker.php
@@ -0,0 +1,102 @@
+<?php
+
+namespace App\Revisions;
+
+use App\Models\BlueprintRevision;
+use Illuminate\Http\Request;
+use Illuminate\Support\Arr;
+use Illuminate\Support\Collection;
+
+class BlueprintRevisionTracker
+{
+    /**
+     * Record the stored contents of a blueprint as a new revision.
+     */
+    public function record(object $blueprint): BlueprintRevision
+    {
+        return BlueprintRevision::create([
+            'namespace' => $blueprint->getAttributeValue('namespace'),
+            'handle' => $blueprint->getAttributeValue('handle'),
+            'data' => $blueprint->getAttributeValue('data') ?? [],
+        ]);
+    }
+
+    /**
+     * Revisions for a blueprint, newest first.
+     */
+    public function history(string $namespace, string $handle): Collection
+    {
+        return BlueprintRevision::query()
+            ->forBlueprint($namespace, $handle)
+            ->orderByDesc('id')
+            ->get();
+    }
+
+    /**
+     * The changes restoring a revision would make, as leaf-level dot paths.
+     *
+     * @return array<int, array{path: string, from: mixed, to: mixed}>
+     */
+    public function diff(string $namespace, string $handle, BlueprintRevision $revision): array
+    {
+        $from = Arr::dot($this->currentData($namespace, $handle));
+        $to = Arr::dot($revision->data ?? []);
+
+        $changes = [];
+
+        foreach (array_keys($from + $to) as $path) {
+            $before = $from[$path] ?? null;
+            $after = $to[$path] ?? null;
+
+            if ($before !== $after) {
+                $changes[] = ['path' => (string) $path, 'from' => $before, 'to' => $after];
+            }
+        }
+
+        return $changes;
+    }
+
+    /**
+     * Make the revision's contents the blueprint's stored contents. Saving goes
+     * through the model, so the restore is recorded like any other save.
+     */
+    public function restore(string $namespace, string $handle, BlueprintRevision $revision): void
+    {
+        $blueprint = app('statamic.eloquent.blueprints.model')::firstOrNew([
+            'namespace' => $namespace,
+            'handle' => $handle,
+        ]);
+
+        $blueprint->data = $revision->data;
+        $blueprint->save();
+    }
+
+    /**
+     * The blueprint section the revisions panel belongs to, or null when the
+     * request is not a blueprint edit page. Matches
+     * /cp/fields/blueprints/{type}/{...}/{handle}/edit.
+     *
+     * @return array{namespace: string, handle: string}|null
+     */
+    public static function targetFor(Request $request): ?array
+    {
+        if (! preg_match('#^cp/fields/blueprints/((?:[^/]+/)+)([^/]+)/edit$#', trim($request->path(), '/'), $matches)) {
+            return null;
+        }
+
+        return [
+            'namespace' => str_replace('/', '.', rtrim($matches[1], '/')),
+            'handle' => $matches[2],
+        ];
+    }
+
+    private function currentData(string $namespace, string $handle): array
+    {
+        $blueprint = app('statamic.eloquent.blueprints.model')::query()
+            ->where('namespace', $namespace)
+            ->where('handle', $handle)
+            ->first();
+
+        return $blueprint?->getAttributeValue('data') ?? [];
+    }
+}
